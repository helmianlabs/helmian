# Copy to deploy/vps/.env (chmod 600). Never commit the real file.
HELMIAN_ADMIN_HOST=admin.helmian.cloud
POSTGRES_PASSWORD=change-me-long-random

HELMION_CLOUD_ENVIRONMENT=staging
HELMION_ADMIN_ORIGIN=https://admin.helmian.cloud
# OIDC sign-in for the admin (Clerk works: issuer = your Clerk Frontend API URL)
HELMION_ADMIN_ISSUER=https://your-clerk-frontend-api.example
HELMION_ADMIN_CLIENT_ID=
HELMION_ADMIN_REDIRECT_URI=https://admin.helmian.cloud/admin/auth/callback

# Cora CLM socket bearer token (openssl rand -hex 32)
HELMION_CORA_TOKEN=
HELMION_CORA_PROVIDER=claude
HELMION_CORA_TIER=standard
HELMION_CORA_PERMISSION=ask
ANTHROPIC_API_KEY=
