# Use a least-privilege role restricted to the `helmion` schema.
HELMION_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required by live CLI migration and Phase Two test commands. Copy only the
# non-secret ep-... endpoint ID from the selected Neon project's Connect modal.
HELMION_EXPECTED_ENDPOINT_ID=ep-example-a1b2c3d4

# Optional. Defaults to .helmion/autonomy_rules.json in the current workspace.
HELMION_RULES_PATH=

# The Codex MCP adapter is read-only unless this is explicitly changed.
HELMION_CODEX_MODE=read-only

# Required only for explicit read-write mode.
HELMION_CODEX_INSTANCE_ID=

# Helmian Cloud / Fly release contract. Keep real values in the Fly secret store.
HELMION_CLOUD_ENVIRONMENT=staging
HELMION_CORA_PROVIDER=claude
HELMION_CORA_TIER=standard
HELMION_CORA_PERMISSION=ask
HELMION_CORA_TOKEN=
