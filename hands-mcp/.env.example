# /opt/helmian-hands-mcp/app.env (chmod 600). Never commit. No provider API keys (019).
PUBLIC_URL=https://hands.5-78-222-178.sslip.io
AUTH_PASSPHRASE=same-passphrase-as-the-memory-connector
HANDS_ENABLED=true
STATE_DIR=/data
PORT=8090
# Executive Guard. Leave unset until Guard is live: every mutating tool is then DENIED.
# GUARD_URL=https://guard.example
# GUARD_DEVICE_TOKEN=...
# GUARD_PUBLIC_KEY_X=...   (Ed25519 "x" from Guard GET /v1/keys)
# GUARD_DEVICE_ID=hands-mcp

# Long-lived approvals + Scribe mail-back. An AI's chat call returns within
# HANDS_HOLD_OPEN_WAIT_MS; the request stays pending for HANDS_PENDING_TTL_MS
# and the outcome is mailed to the AI's Scribe mailbox. Unset SCRIBE_MCP_URL = off.
# HANDS_PENDING_TTL_MS=43200000
# SCRIBE_MCP_URL=https://scribe.example/mcp
# SCRIBE_MAIL_TOKEN=...            (or SCRIBE_REFRESH_TOKEN=... + SCRIBE_CLIENT_ID=...)
# SCRIBE_MAIL_FROM=hands
# HANDS_MAIL_CC_PAUL=false
