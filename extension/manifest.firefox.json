{
  "manifest_version": 3,
  "name": "Helmion Guard",
  "version": "0.6.8",
  "description": "Catches destructive commands, keeps secrets out of AI chats, flags evasive, leaky or harmful replies, and keeps a durable local log of every flag.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "identity"
  ],
  "background": {
    "scripts": [
      "background/worker.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": [
        "content/prompt-risk.js",
        "content/sanitize.js",
        "content/flags.js",
        "content/extract.js",
        "content/stream-watch.js",
        "content/ui.js",
        "content/nudge.js",
        "content/guard.js"
      ],
      "css": [
        "content/guard.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Helmion Guard",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "guard@helmion.example",
      "strict_min_version": "121.0"
    }
  },
  "optional_permissions": [
    "notifications",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  }
}
