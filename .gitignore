node_modules/
.env
# 2026-07-30: the bare `.env` above matches a file named EXACTLY .env and nothing
# else. Measured, not assumed: `git check-ignore -v .env.2026-07-30-pre-local-off.bak`
# returned EMPTY, and `git status` showed it as `??` — so the next `git add -A`
# would have committed a file holding live HELMION_DATABASE_URL, GEMINI_API_KEY,
# GROK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY and XAI_API_KEY. That is not
# hypothetical: it already happened once tonight and landed in stash@{0}.
# Every .env VARIANT is ignored; .env.example is re-allowed because it is the
# placeholder file people are meant to copy.
.env.*
!.env.example
.helmion/

# Session scratch and restore snapshots. These carry real credentials — the
# claude.json under _restore/ holds the Neon password five times and the xAI key
# four. They are untracked today only by luck; nothing was stopping them.
_restore/
_review_export_*/
guard_lab/
guard_test.txt
coverage/
*.log
*.tgz
*.owner-key.dpapi.json
*.owner-key.recovery.json
*.owner-confirmation.json
artifacts/

# .NET build output. 2026-07-29: these were `desktop/**/bin/` and `tools/**/bin/`,
# which is a trap in THIS repo — `bin/` is a SOURCE directory here (bin/helmion.mjs,
# bin/helmion-jobs.mjs and four more are tracked), so a future tool laid out the
# ordinary Node way as `tools/newtool/bin/cli.mjs` was silently untracked and one
# `git clean` from gone. Naming the MSBuild configurations instead keeps the
# ignore precise. `obj/` needs no such care — nothing but MSBuild writes it.
desktop/**/bin/Debug/
desktop/**/bin/Release/
desktop/**/obj/
tools/**/bin/Debug/
tools/**/bin/Release/
tools/**/obj/
# Catch a non-standard configuration name without swallowing a source bin/.
**/bin/*/net[0-9]*/
**/bin/x64/
**/bin/x86/
**/bin/AnyCPU/

# Local voice models (~470MB) - fetch with desktop/scripts/get-voice-models.ps1
desktop/models/

# Backups and merge leftovers. Git already holds every prior version of a tracked
# file, so a `.bak` beside it is redundant — and five of them reached this repo's
# history, which reads to a stranger as not trusting version control. Those five
# are already tracked, so this rule does not remove them; it only stops the next.
*.bak
*.orig
*.rej
*~

# The remaining scratch directories. `_restore/`, `_review_export_*/` and
# `guard_lab/` are covered above; these are the two that were still exposed.
# Ignoring them matters beyond `git add -A`: `git stash -u` skips ignored paths
# too, and on 2026-07-30 a `stash -u` swept `_restore/` into stash@{0}, carrying a
# live Neon password into the object database where nobody was looking for it.
_snapshots/
planning/

# Test droppings
**/disposable.*
**/disposable_*

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Scratch projects created by clicking + New in the Pilot while testing.
fuck-claude/

# 2026-08-09: provisioning output for the team OAuth / Herald work. Measured, not
# assumed: `git check-ignore -v .team-oauth-provisioning/production.env` returned
# EMPTY and `git status` showed BOTH files as `??`, so the next `git add -A` would
# have committed them. handoff-secrets.env holds a live 32-byte
# HELMION_TEAM_OAUTH_ENCRYPTION_KEY plus the Slack and Discord handoff tokens, and
# its own first line already says "LOCAL ONLY, not for git". production.env holds a
# 1,202-character live VERCEL_OIDC_TOKEN (the other four values are Vercel's
# "[SENSITIVE]" placeholder, but that one is not). This repo is PUBLIC
# (api.github.com/repos/helmianlabs/helmian answers 200 unauthenticated), so a
# sweep would have published them.
.team-oauth-provisioning/

