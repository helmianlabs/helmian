<UserControl x:Class="Helmion.Desktop.TeamChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="TeamChatPanel_IsVisibleChanged">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: channel + link status + Envoy controls (Free-Willy, GitHub, Custom Agent, Full Clone) -->
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ENVOY TEAM CHAT" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
          <TextBlock x:Name="ChatTitle" Text="Team" FontSize="18" FontWeight="SemiBold" />
          <Border x:Name="DebateBadge" Visibility="Collapsed" CornerRadius="6" Padding="7,2" Margin="8,0,0,0"
                  Background="#26F59E0B" BorderBrush="#8CF59E0B" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="DebateBadgeText" Text="Free-Willy Debate" Foreground="{DynamicResource AmberBrush}" FontSize="10.5" FontWeight="SemiBold" />
          </Border>
          <Border x:Name="GitHubBadge" Visibility="Collapsed" CornerRadius="6" Padding="7,2" Margin="8,0,0,0"
                  Background="{DynamicResource PanelSubtleBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="GitHubBadgeText" Text="GitHub" Foreground="{DynamicResource SoftTextBrush}" FontSize="10.5" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="ChatStatus" Text="Not linked" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
      <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <ComboBox x:Name="ChannelBox" MinWidth="140" DisplayMemberPath="Title" SelectionChanged="ChannelBox_SelectionChanged" Visibility="Collapsed" Margin="0,0,6,6" />
        <Button x:Name="FreeWillyButton" Content="⚡ Free-Willy" Click="FreeWillyButton_Click" Visibility="Collapsed" Padding="10,5" Margin="0,0,6,6"
                Style="{DynamicResource ConsoleNeutralButtonStyle}" ToolTip="Toggle Free-Willy multi-agent debate mode on this channel" />
        <Button x:Name="LinkGitHubButton" Content="Link GitHub" Click="LinkGitHubButton_Click" Visibility="Collapsed" Padding="10,5" Margin="0,0,6,6"
                Style="{DynamicResource ConsoleNeutralButtonStyle}" ToolTip="Link a GitHub repository (owner/repo) to stream commits, PRs and issues" />
        <Button x:Name="NewCustomAgentButton" Content="+ Custom Agent" Click="NewCustomAgentButton_Click" Visibility="Collapsed" Padding="10,5" Margin="0,0,6,6"
                Style="{DynamicResource ConsoleNeutralButtonStyle}" ToolTip="Create a custom @handle specialist agent in this channel" />
        <Button x:Name="OpenCloneButton" Content="Full Clone (/app)" Click="OpenCloneButton_Click" Padding="10,5" Margin="0,0,6,6"
                Style="{DynamicResource ConsoleNeutralButtonStyle}" ToolTip="Open the 1:1 full Envoy workspace clone in your browser or phone" />
        <Button x:Name="UnlinkButton" Content="Unlink" Click="UnlinkButton_Click" Visibility="Collapsed" Padding="10,5" Margin="0,0,0,6"
                Style="{DynamicResource ConsoleNeutralButtonStyle}" ToolTip="Stop using team chat on this computer" />
      </WrapPanel>
    </Grid>

    <!-- Inline drawers for GitHub Repo Linking & Custom Agent Creation -->
    <StackPanel Grid.Row="1">
      <Border x:Name="GitHubDrawer" Visibility="Collapsed" Margin="0,0,0,10" Padding="12" CornerRadius="10"
              Background="{DynamicResource PanelSubtleBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="GitHub Repo (owner/repo):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" />
          <TextBox x:Name="GitHubRepoBox" Grid.Column="1" FontFamily="Consolas" FontSize="12.5" Padding="6,4"
                   ToolTip="Example: helmianlabs/helmian" AutomationProperties.Name="GitHub repository owner/repo" />
          <Button x:Name="SaveGitHubButton" Grid.Column="2" Content="Save Link" Click="SaveGitHubButton_Click" Margin="8,0,0,0" Padding="10,4"
                  Style="{DynamicResource ConsoleNeutralButtonStyle}" />
          <Button x:Name="RemoveGitHubButton" Grid.Column="3" Content="Unlink Repo" Click="RemoveGitHubButton_Click" Margin="6,0,0,0" Padding="10,4"
                  Style="{DynamicResource ConsoleNeutralButtonStyle}" />
        </Grid>
      </Border>

      <Border x:Name="CustomAgentDrawer" Visibility="Collapsed" Margin="0,0,0,10" Padding="12" CornerRadius="10"
              Background="{DynamicResource PanelSubtleBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="CREATE CUSTOM SPECIALIST AGENT" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
          <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
            <StackPanel Width="150" Margin="0,0,8,4">
              <TextBlock Text="Display Name" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBox x:Name="CustomAgentNameBox" Padding="6,4" Margin="0,2,0,0" ToolTip="e.g. Rust Auditor" />
            </StackPanel>
            <StackPanel Width="130" Margin="0,0,8,4">
              <TextBlock Text="@Handle" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBox x:Name="CustomAgentHandleBox" FontFamily="Consolas" Padding="6,4" Margin="0,2,0,0" ToolTip="e.g. rust-auditor" />
            </StackPanel>
            <StackPanel Width="130" Margin="0,0,8,4">
              <TextBlock Text="Provider" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <ComboBox x:Name="CustomAgentProviderBox" SelectedIndex="0" Margin="0,2,0,0">
                <ComboBoxItem Content="claude" />
                <ComboBoxItem Content="openai" />
                <ComboBoxItem Content="grok" />
                <ComboBoxItem Content="gemini" />
                <ComboBoxItem Content="mistral" />
                <ComboBoxItem Content="runway" />
                <ComboBoxItem Content="ollama" />
              </ComboBox>
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,8,4">
              <TextBlock Text="Job Title" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBox x:Name="CustomAgentJobBox" Padding="6,4" Margin="0,2,0,0" ToolTip="e.g. Systems Security Reviewer" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="System Prompt / Role Instructions" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBox x:Name="CustomAgentPromptBox" MinHeight="44" MaxHeight="80" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,8" Padding="6,4" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SaveCustomAgentButton" Content="Create Agent" Click="SaveCustomAgentButton_Click" Padding="12,5"
                    Style="{DynamicResource ConsoleNeutralButtonStyle}" />
            <Button x:Name="CancelCustomAgentButton" Content="Close" Click="CancelCustomAgentButton_Click" Margin="8,0,0,0" Padding="10,5"
                    Style="{DynamicResource ConsoleNeutralButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Link step (shown until linked) -->
    <Border x:Name="LinkCard" Grid.Row="2" Style="{DynamicResource CardStyle}" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="Link this desktop to your Helmian team" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,12"
                   Text="On your phone or browser open helmian.cloud/app, go to Settings and press “Link desktop app”. Type the 8-character code here." />
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="LinkCodeBox" Width="160" FontFamily="Consolas" FontSize="16" MaxLength="9"
                   CharacterCasing="Upper" KeyDown="LinkCodeBox_KeyDown" AutomationProperties.Name="Link code" />
          <Button x:Name="LinkButton" Content="Link" Click="LinkButton_Click" Margin="8,0,0,0" Padding="14,6"
                  Style="{DynamicResource ConsoleNeutralButtonStyle}" />
        </StackPanel>
        <TextBlock x:Name="LinkError" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- Messages -->
    <Border x:Name="MessagesCard" Grid.Row="2" Visibility="Collapsed"
            Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="12">
        <ItemsControl x:Name="MessagesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                  <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding When, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Body, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Quick @mention & Custom Agent Roster Bar -->
    <WrapPanel x:Name="MentionBar" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed" Orientation="Horizontal">
      <Button Content="@all" Tag="@all" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <Button Content="@Claude" Tag="@Claude" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <Button Content="@ChatGPT" Tag="@ChatGPT" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <Button Content="@Grok" Tag="@Grok" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <Button Content="@Gemini" Tag="@Gemini" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <Button Content="@Mistral" Tag="@Mistral" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4" Style="{DynamicResource ShelfCompactButtonStyle}" />
      <ItemsControl x:Name="CustomMentionList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Label}" Tag="{Binding Mention}" Click="MentionPill_Click" Padding="8,3" Margin="0,0,5,4"
                    ToolTip="{Binding Tooltip}" Style="{DynamicResource ShelfCompactButtonStyle}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>

    <!-- Composer -->
    <Grid x:Name="Composer" Grid.Row="4" Margin="0,6,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="MessageBox" MinHeight="36" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" KeyDown="MessageBox_KeyDown" AutomationProperties.Name="Message your team" />
      <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="SendButton_Click" Margin="8,0,0,0" Padding="16,6"
              Style="{DynamicResource ConsoleNeutralButtonStyle}" />
    </Grid>
  </Grid>
</UserControl>
