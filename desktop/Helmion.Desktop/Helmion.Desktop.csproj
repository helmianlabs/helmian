<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Helmion Pilot</AssemblyName>
    <RootNamespace>Helmion.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Helmion Personal Pilot</Product>
    <Description>Local Windows dashboard shell for the Helmion personal pilot</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\Helmion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Helmion.Desktop.Core\Helmion.Desktop.Core.csproj" />
    <ProjectReference Include="..\Helmion.LocalService.Protocol\Helmion.LocalService.Protocol.csproj" />
    <ProjectReference Include="..\Helmion.LocalService\Helmion.LocalService.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="GenerateHelmionIcon"
          BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\build-icon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Assets\Helmion.ico&quot;" />
  </Target>

  <!-- The Pilot hosts the Local Service as a sibling process. Copy the full
       service output (exe + dll + deps + runtimeconfig + protocol/security)
       next to Helmion Pilot.exe. A bare apphost .exe without its .dll exits
       immediately ("application to execute does not exist"). -->
  <Target Name="CopyLocalServiceBesidePilot"
          AfterTargets="Build">
    <PropertyGroup>
      <_SvcOut>$(MSBuildThisFileDirectory)..\Helmion.LocalService\bin\$(Configuration)\net10.0-windows\</_SvcOut>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_SvcOut)Helmion Local Service.dll')">
      <_LocalServiceCopy Include="$(_SvcOut)Helmion Local Service.exe" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion Local Service.dll" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion Local Service.deps.json" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion Local Service.runtimeconfig.json" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion Local Service.pdb" Condition="Exists('$(_SvcOut)Helmion Local Service.pdb')" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion.LocalService.Protocol.dll" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion.LocalService.Protocol.pdb" Condition="Exists('$(_SvcOut)Helmion.LocalService.Protocol.pdb')" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion.LocalService.Security.dll" Condition="Exists('$(_SvcOut)Helmion.LocalService.Security.dll')" />
      <_LocalServiceCopy Include="$(_SvcOut)Helmion.LocalService.Security.pdb" Condition="Exists('$(_SvcOut)Helmion.LocalService.Security.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocalServiceCopy)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_LocalServiceCopy)' != ''" />
    <Warning Text="Local Service build output not found at $(_SvcOut) — Pilot cannot start the pipe service until LocalService is built."
             Condition="!Exists('$(_SvcOut)Helmion Local Service.dll')" />
  </Target>
</Project>
