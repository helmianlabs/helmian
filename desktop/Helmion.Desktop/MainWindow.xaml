    </Style>

    <!-- Compact agent-spawn pills for the right Agents shelf -->
    <Style x:Key="AgentShelfPillStyle" TargetType="Button" BasedOn="{StaticResource SessionPillStyle}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,5,5" />
