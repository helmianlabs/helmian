<Window x:Class="Helmion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helmion Personal Pilot"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.68" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PillStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource AccentPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ActivityTemplate">
      <Grid Margin="0,4,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding TimeLabel}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12"
                   Margin="0,3,12,0" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="14"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Detail}"
                     Style="{StaticResource MutedStyle}"
                     Margin="0,4,18,0" />
        </StackPanel>
        <Border Grid.Column="2"
                Style="{StaticResource PillStyle}"
                Padding="8,3"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding Kind}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="10"
                     FontWeight="Bold" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OrchestrationEventTemplate">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding TimeLabel}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontFamily="Consolas"
                     FontSize="12"
                     Margin="0,3,12,0" />
          <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <TextBlock Text="{Binding Actor}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="11"
                       FontWeight="Bold" />
            <TextBlock Text="LIVE EVENT"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,22,0">
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}"
                       Style="{StaticResource MutedStyle}"
                       Margin="0,5,0,0" />
            <Expander Margin="0,10,0,0">
              <Expander.Header>
                <TextBlock Text="Evidence and redacted detail"
                           Foreground="{DynamicResource SoftTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold" />
              </Expander.Header>
              <StackPanel Margin="0,8,0,2">
                <TextBlock Text="{Binding EvidenceDetail}"
                           Foreground="{DynamicResource SoftTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding RawDetail}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontFamily="Consolas"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <Border Style="{StaticResource PillStyle}" Padding="8,3">
              <TextBlock Text="{Binding Kind}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
            </Border>
            <TextBlock Text="{Binding EvidenceLabel}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HandoffTemplate">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Id}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="15"
                       FontWeight="Bold" />
            <TextBlock Text="LIVE"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,22,0">
            <TextBlock Text="{Binding Direction}"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold"
                       FontSize="14" />
            <TextBlock Text="{Binding Summary}"
                       Style="{StaticResource MutedStyle}"
                       Margin="0,5,0,0" />
            <TextBlock Text="{Binding Evidence}"
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontSize="12"
                       Margin="0,10,0,0" />
          </StackPanel>
          <Border Grid.Column="2"
                  Style="{StaticResource PillStyle}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="11"
                       FontWeight="Bold" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ApprovalTemplate">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
              <Border Background="{DynamicResource WarningPanelBrush}"
                      BorderBrush="{DynamicResource WarningStrokeBrush}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="9,4">
                <TextBlock Text="{Binding Risk}"
                           Foreground="{DynamicResource AmberBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
              <TextBlock Text="PENDING APPROVAL"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="10"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding PolicyOutcome}"
                       Foreground="{DynamicResource AmberBrush}"
                       FontSize="13"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding Detail}"
                       Style="{StaticResource MutedStyle}"
                       Margin="0,5,0,0" />
          </StackPanel>
          <Border Grid.Column="1"
                  Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="14,9"
                  VerticalAlignment="Center"
                  Margin="24,0,0,0">
            <TextBlock Text="Preview only"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontWeight="SemiBold"
                       FontSize="12" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="IntegrationTemplate">
      <Border Style="{StaticResource CardStyle}"
              Width="405"
              MinHeight="218"
              Margin="0,0,14,14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="16" />
            <Border Grid.Column="1"
                    Style="{StaticResource PillStyle}"
                    Padding="8,3">
              <TextBlock Text="{Binding StatusLabel}"
                         FontWeight="Bold"
                         FontSize="9">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLive}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </Grid>
          <TextBlock Text="{Binding State}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Margin="0,15,0,0" />
          <TextBlock Text="{Binding Detail}"
                     Style="{StaticResource MutedStyle}"
                     Margin="0,8,0,0" />
          <Border BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="0,1,0,0"
                  Margin="0,15,0,0"
                  Padding="0,13,0,0">
            <TextBlock Text="{Binding Guidance}"
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ProviderProfileTemplate">
      <Border Style="{StaticResource CardStyle}"
              Width="405"
              MinHeight="330"
              Margin="0,0,14,14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="16" />
            <Border Grid.Column="1" Style="{StaticResource PillStyle}" Padding="8,3">
              <TextBlock Text="{Binding SetupState}"
                         Foreground="{DynamicResource AmberBrush}"
                         FontWeight="Bold"
                         FontSize="9" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding CoordinatorRole}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Margin="0,14,0,0" />
          <TextBlock Text="{Binding Availability}"
                     Foreground="{DynamicResource SoftTextBrush}"
                     FontSize="12"
                     Margin="0,6,0,0" />
          <TextBlock Text="{Binding Interface}"
                     Style="{StaticResource MutedStyle}"
                     Margin="0,6,0,0" />
          <Border Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="11"
                  Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="AUTHENTICATION"
                         Foreground="{DynamicResource FaintTextBrush}"
                         FontSize="9"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding AuthenticationClass}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Margin="0,5,0,0" />
              <TextBlock Text="{Binding AuthenticationGuidance}"
                         Foreground="{DynamicResource SoftTextBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="0,1,0,0"
                  Margin="0,13,0,0"
                  Padding="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{Binding AuthBoundary}"
                         Foreground="{DynamicResource SoftTextBrush}"
                         FontSize="11"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ActivationPlan}"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,6,0,0" />
              <TextBlock Text="{Binding DocumentationBasis}"
                         Foreground="{DynamicResource AmberBrush}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,7,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MigrationInventoryTemplate">
      <Border BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Version}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontWeight="Bold" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Name}"
                     Foreground="{DynamicResource SoftTextBrush}"
                     Margin="8,0,12,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding Sha256}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontFamily="Consolas"
                     FontSize="10"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="EvidenceInventoryTemplate">
      <Border BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Kind}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="10"
                     FontWeight="Bold" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}"
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}"
                       Style="{StaticResource MutedStyle}"
                       Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ReleaseCapabilityTemplate">
      <Border BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,15">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145" />
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="58" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding Area}"
                     Foreground="{DynamicResource TextBrush}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="0,0,14,0"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Target}"
                     Foreground="{DynamicResource SoftTextBrush}"
                     FontSize="12"
                     Margin="0,0,18,0"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Column="2"
                     Text="{Binding CurrentState}"
                     Foreground="{DynamicResource AmberBrush}"
                     FontSize="12"
                     Margin="0,0,18,0"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Column="3"
                     Text="{Binding ReleaseGate}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="12"
                     Margin="0,0,14,0"
                     TextWrapping="Wrap" />
          <Border Grid.Column="4"
                  Style="{StaticResource PillStyle}"
                  Padding="8,3"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding Phase}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Bold"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarChrome"
            Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,0,6,27">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="38"
                  Height="38"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="12">
            <Grid>
              <Path Data="M 9,7 L 9,31 M 9,19 L 29,7 M 9,19 L 29,31"
                    Stroke="{DynamicResource AccentInkBrush}"
                    StrokeThickness="3.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentInkBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,5,5,0" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,1,0,0">
            <TextBlock Text="HELMION"
                       FontWeight="Bold"
                       FontSize="16" />
            <TextBlock Text="Personal Pilot"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
          <TextBlock Text="PILOT"
                     Foreground="{DynamicResource FaintTextBrush}"
                     FontSize="10"
                     FontWeight="Bold"
                     Margin="15,0,0,8" />
          <Button x:Name="OverviewNav"
                  Tag="Overview"
                  Content="⌁   Overview"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="WorkspaceNav"
                  Tag="Workspace"
                  Content="◇   Workspace"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="ConsoleNav"
                  Tag="Console"
                  Content="▣   Console"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="ActivityNav"
                  Tag="Activity"
                  Content="◫   Live activity"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="EvidenceNav"
                  Tag="Evidence"
                  Content="≡   Evidence"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="ApprovalsNav"
                  Tag="Approvals"
                  Content="✓   Approvals"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="IntegrationsNav"
                  Tag="Integrations"
                  Content="⌘   Integrations"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="ReleaseNav"
                  Tag="Release"
                  Content="↗   Release roadmap"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
          <Button x:Name="SettingsNav"
                  Tag="Settings"
                  Content="⚙   Settings"
                  Style="{StaticResource NavButtonStyle}"
                  Click="Navigation_Click" />
        </StackPanel>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="15">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LocalServiceDot"
                       Width="8"
                       Height="8"
                       Fill="{DynamicResource FaintTextBrush}"
                       Margin="0,1,8,0" />
              <TextBlock Text="Local service"
                         Foreground="{DynamicResource TextBrush}"
                         FontWeight="SemiBold"
                         FontSize="12" />
            </StackPanel>
            <TextBlock x:Name="LocalServiceSidebarStatus"
                       Text="Not connected"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Margin="16,5,0,0" />
            <TextBlock x:Name="LocalServiceSidebarDetail"
                       Text="Active local host connection"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="10"
                       Margin="16,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="ContentHost" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="88" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="FooterRow" Height="38" />
      </Grid.RowDefinitions>

      <Border x:Name="HeaderChrome"
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="30,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle"
                       Text="Overview"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="PageContext"
                       Text="A calm view of the local pilot"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Border Style="{StaticResource PillStyle}"
                    Background="{DynamicResource AccentDarkBrush}"
                    BorderBrush="{DynamicResource AccentStrokeStrongBrush}"
                    Margin="0,0,10,0">
              <TextBlock Text="{Binding ModeLabel, StringFormat={}{0} mode}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="11"
                         FontWeight="Bold" />
            </Border>
            <Border Style="{StaticResource PillStyle}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                <TextBlock x:Name="GlobalDataBadgeText"
                           Text="LOCAL LIVE"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="Bold"
                           FontSize="10" />
              </StackPanel>
            </Border>
            <Border Width="38"
                    Height="38"
                    Background="{DynamicResource AvatarBrush}"
                    CornerRadius="19"
                    Margin="14,0,0,0">
              <TextBlock Text="P"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <!-- Overview -->
        <ScrollViewer x:Name="OverviewPage"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,26,30,34">
            <Border CornerRadius="20"
                    BorderBrush="{DynamicResource AccentStrokeBrush}"
                    BorderThickness="1"
                    Padding="28">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource HeroStartColor}" Offset="0" />
                  <GradientStop Color="{DynamicResource HeroMiddleColor}" Offset="0.58" />
                  <GradientStop Color="{DynamicResource HeroEndColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,35,0">
                  <Border Style="{StaticResource PillStyle}"
                          HorizontalAlignment="Left"
                          Background="{DynamicResource AccentDarkBrush}"
                          BorderBrush="{DynamicResource AccentStrokeStrongBrush}">
                    <TextBlock Text="ACTIVE PERSONAL PILOT"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="Your workspace, with guardrails."
                             FontSize="30"
                             FontWeight="SemiBold"
                             Margin="0,17,0,0" />
                  <TextBlock Text="Routine bounded local work stays in motion. Execution safety is governed and enforced by local rules and policy."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             MaxWidth="680"
                             HorizontalAlignment="Left"
                             Margin="0,10,0,0" />
                  <Button Content="Open workspace  →"
                          Tag="Workspace"
                          Click="Navigation_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          HorizontalAlignment="Left"
                          Margin="0,22,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource AccentStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="20">
                  <StackPanel>
                    <TextBlock Text="TODAY'S POSTURE"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Local guardrails" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <TextBlock Grid.Column="1" Text="Ready" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Local service" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <TextBlock x:Name="OverviewServiceStateText"
                                 Grid.Column="1"
                                 Text="Offline"
                                 Foreground="{DynamicResource AmberBrush}"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Owner signing" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <TextBlock Grid.Column="1" Text="Optional · off" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource AccentStrokeBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,17,0,0"
                            Padding="0,14,0,0">
                      <TextBlock x:Name="OverviewDataSourceText"
                                 Text="{Binding DataSourceLabel}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,18,0,0">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="WORKSPACES" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="WorkspaceCountText" Text="1" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="WorkspaceMetricDetail" Text="Helmion · local pilot" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="6,0">
                <StackPanel>
                  <TextBlock Text="LEASE POSTURE" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="LeaseMetricText" Text="{Binding Workspace.LeaseHolder}" Foreground="{DynamicResource AccentBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="LeaseMetricDetail" Text="{Binding Workspace.LeaseState}" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <StackPanel>
                  <TextBlock Text="OPEN DECISIONS" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="Durable decision queue is active" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recent pilot evidence" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="LIVE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding RecentActivity}"
                                ItemTemplate="{StaticResource ActivityTemplate}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="Guardrail summary" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Policy is active even while live integrations are deferred."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,7,0,17" />
                  <Border Background="{DynamicResource AccentStrongBrush}" CornerRadius="11" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="LOW RISK · LOCAL" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Runs inside clear, bounded guardrails" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource WarningPanelBrush}" CornerRadius="11" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="HIGH RISK · EXTERNAL" Foreground="{DynamicResource AmberBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Requires a future explicit owner decision" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource PanelSubtleBrush}" CornerRadius="11" Padding="13">
                    <StackPanel>
                      <TextBlock Text="ADVISORS" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Read-only evidence · never authority" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,30,0">
                  <TextBlock Text="Helmion Profile Package"
                             Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Planned portable bundle: base Policy Pack, reviewed learning, adapter mappings, task-specific profiles, optional templates, and a versioned manifest."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,8,0,0" />
                  <TextBlock Text="Each item gets a plain-English impact/dependency/safety card and its own toggle. Task profiles inherit base safety. No source folder has been scanned."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource PillStyle}"
                        VerticalAlignment="Top">
                  <TextBlock Text="PORTABLE BUNDLE"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Workspace -->
        <ScrollViewer x:Name="WorkspacePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="WorkspacePageTitle"
                           Text="{Binding Workspace.Name}"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspacePagePath"
                           Text="{Binding Workspace.RootPath}"
                           Style="{StaticResource MutedStyle}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource PillStyle}" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningStrokeBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceSourceBadgeText"
                           Text="OFFLINE"
                           Foreground="{DynamicResource AmberBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0">
                  <TextBlock x:Name="WorkspaceConnectionSummary"
                             Text="No active connection"
                             Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock x:Name="WorkspaceConnectionDetail"
                             Text="Connect the current-user read-only service, then choose a local project folder."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <Button x:Name="ConnectServiceButton"
                          Content="Connect local service"
                          Click="ConnectService_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Connect Helmion local service" />
                  <Button x:Name="SelectWorkspaceButton"
                          Content="Choose workspace"
                          Click="SelectWorkspace_Click"
                          IsEnabled="True"
                          Cursor="Hand"
                          Margin="10,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Choose a local project workspace"
                          ToolTip="Opens a folder picker immediately — does not wait on the local service" />
                  <Button x:Name="RefreshWorkspaceButton"
                          Content="Refresh"
                          Click="RefreshWorkspace_Click"
                          IsEnabled="True"
                          Cursor="Hand"
                          Margin="10,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Refresh the selected workspace inventory" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <TextBlock Text="Project workspace" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Branch" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceBranchText"
                               Grid.Column="1"
                               Text="{Binding Workspace.Branch}" />
                  </Grid>
                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Data source" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceDataSourceText"
                               Grid.Column="1"
                               Text="Unconfigured"
                               Foreground="{DynamicResource SoftTextBrush}" />
                  </Grid>
                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Next safe action" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceNextActionText"
                               Grid.Column="1"
                               Text="{Binding Workspace.NextAction}"
                               TextWrapping="Wrap" />
                  </Grid>
                  <Border Background="{DynamicResource PanelSubtleBrush}" CornerRadius="11" Padding="14" Margin="0,20,0,0">
                    <TextBlock Text="The authenticated local service inventories selected source files read-only. It does not start agents, query Neon, or mutate project state."
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lease status" Style="{StaticResource SectionTitleStyle}" />
                    <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock x:Name="WorkspaceLeaseStateText"
                             Text="{Binding Workspace.LeaseState}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Margin="0,20,0,0" />
                  <TextBlock x:Name="WorkspaceLeaseDetailText"
                             Text="{Binding Workspace.LeaseHolder}"
                             Style="{StaticResource MutedStyle}"
                             Margin="0,5,0,0" />
                  <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,17,0,0">
                    <StackPanel>
                      <TextBlock Text="Lease invariant" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                      <TextBlock Text="At most one active writer per project. This local slice does not connect a durable lease provider, so it reports that state as unavailable."
                                 Style="{StaticResource MutedStyle}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Migration source inventory" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="MigrationInventoryState"
                               Grid.Column="1"
                               Text="No workspace loaded"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock x:Name="EmptyMigrationMessage"
                             Text="Choose a workspace to inventory local checksummed SQL sources."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,16,0,0" />
                  <ItemsControl x:Name="MigrationInventoryList"
                                ItemTemplate="{StaticResource MigrationInventoryTemplate}"
                                Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Evidence source inventory" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="EvidenceInventoryState"
                               Grid.Column="1"
                               Text="No workspace loaded"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock x:Name="EmptyEvidenceMessage"
                             Text="Choose a workspace to inventory local evidence sources."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,16,0,0" />
                  <ItemsControl x:Name="EvidenceInventoryList"
                                ItemTemplate="{StaticResource EvidenceInventoryTemplate}"
                                Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Workspace flow" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Grid.Column="1" Text="READ-ONLY SLICE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                </Grid>
                <Grid Margin="0,24,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="1 · Observe" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Read project, lease, policy, and evidence state." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="2 · Evaluate" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Classify risk and enforce deterministic guardrails." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="3" Text="→" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="4" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="3 · Evidence" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Record checkpoint and acknowledged outcome." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Interaction console — modern full-height CLI -->
        <Grid x:Name="ConsolePage" Visibility="Collapsed" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Border Grid.Row="0"
                  Padding="22,16,22,12"
                  Background="{DynamicResource CanvasBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="#FF5F57" Margin="0,0,6,0" Opacity="0.9" />
                <Border Width="10" Height="10" CornerRadius="5" Background="#FEBC2E" Margin="0,0,6,0" Opacity="0.9" />
                <Border Width="10" Height="10" CornerRadius="5" Background="#28C840" Margin="0,0,14,0" Opacity="0.9" />
                <StackPanel>
                  <TextBlock Text="Console"
                             FontSize="20"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Modern CLI · Enter to send · Shift+Enter for new line · F11 full screen"
                             Foreground="{DynamicResource MutedTextBrush}"
                             FontSize="11"
                             Margin="0,2,0,0" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,6"
                        Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PERMISSIONS"
                               Foreground="{DynamicResource FaintTextBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="ConsolePermissionCombo"
                              Width="196"
                              Height="28"
                              FontSize="12"
                              SelectedIndex="0"
                              SelectionChanged="ConsolePermissionCombo_SelectionChanged"
                              ToolTip="Applies to every LLM. Read-only = chat only. Ask = you approve each tool call. Full = no asking.">
                      <ComboBoxItem Content="Read-only chat" Tag="read-only"
                                    ToolTip="Chat only — no file or shell tools" />
                      <ComboBoxItem Content="Read tools" Tag="read-tools"
                                    ToolTip="Can read/search files; cannot write or run shell" />
                      <ComboBoxItem Content="Ask before each tool" Tag="ask"
                                    ToolTip="Every tool available, but each call stops and waits for your approval. No answer = denied." />
                      <ComboBoxItem Content="Full tools (no ask)" Tag="full"
                                    ToolTip="Full control — write files + run commands without asking" />
                    </ComboBox>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PillStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        ToolTip="Current permission mode applied to all providers">
                  <TextBlock x:Name="ConsoleExecutionBadgeText"
                             Text="PERMISSIONS · READ-ONLY"
                             Foreground="{DynamicResource AmberBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>

                <Button x:Name="ConsoleFullScreenButton"
                        Content="⛶  Full screen"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,0,0"
                        Click="ConsoleFullScreenButton_Click"
                        ToolTip="Toggle full-screen console (F11). Esc exits."
                        Style="{StaticResource PrimaryButtonStyle}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Terminal stage -->
          <Border Grid.Row="1"
                  Margin="18,0,18,18"
                  CornerRadius="18"
                  BorderBrush="{DynamicResource AccentStrokeBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080E12" Offset="0" />
                <GradientStop Color="#0B1520" Offset="0.55" />
                <GradientStop Color="#071018" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0 title bar -->
                <RowDefinition Height="*" />
                <!-- 1 transcript -->
                <RowDefinition Height="Auto" />
                <!-- 2 status strip -->
                <RowDefinition Height="Auto" />
                <!-- 3 MCP install security (collapsed until asked for) -->
                <RowDefinition Height="Auto" />
                <!-- 4 approval strip -->
                <RowDefinition Height="Auto" />
                <!-- 5 input dock -->
              </Grid.RowDefinitions>

              <!-- Terminal title bar -->
              <Border Grid.Row="0"
                      Background="#121C24"
                      BorderBrush="#1E2C38"
                      BorderThickness="0,0,0,1"
                      Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HELMION"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="  ›  "
                               Foreground="#3D5566"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="console"
                               Foreground="#8FB4C9"
                               FontFamily="Consolas"
                               FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConsoleWorkspaceLabel"
                               Text="workspace: (resolving…)"
                               Foreground="#8AA0B0"
                               FontSize="10"
                               FontFamily="Consolas"
                               Margin="0,0,14,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               ToolTip="Agent tools (read/write/run) are limited to this folder. Change it on the Workspace page." />
                    <!-- Which model actually answered, and which tier the router put it in.
                         Filled from the bridge's "model" event; stays "—" until one arrives. -->
                    <TextBlock x:Name="ConsoleModelLabel"
                               Text="model: —"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontFamily="Consolas"
                               Margin="0,0,14,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"
                               ToolTip="The model the per-task router chose for the last turn." />
                    <Button x:Name="ConsoleCommandsButton"
                            Content="/ commands"
                            Height="22"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            FontSize="10"
                            Click="ConsoleCommandsButton_Click"
                            ToolTip="List the slash commands available in this workspace."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="ConsoleMcpSecurityButton"
                            Content="mcp security"
                            Height="22"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            FontSize="10"
                            Click="ConsoleMcpSecurityButton_Click"
                            ToolTip="Discover and audit third-party MCP servers before trusting them."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConsoleLiveLabel"
                               Text="LIVE"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               FontFamily="Consolas" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Output (selectable) -->
              <TextBox x:Name="ConsoleOutputText"
                       Grid.Row="1"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="13.5"
                       Foreground="#7FE3FF"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="18,14"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       IsReadOnlyCaretVisible="True"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       SpellCheck.IsEnabled="False"
                       CaretBrush="#7FE3FF"
                       SelectionBrush="#2A6F8F" />

              <!-- Status strip -->
              <Border Grid.Row="2"
                      Background="#0E171F"
                      BorderBrush="#1A2834"
                      BorderThickness="0,1,0,0"
                      Padding="16,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ConsoleServiceSessionText"
                             Text="Service-backed session not activated."
                             Foreground="#8AA0B0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Which voice backend the selector actually resolved to.
                       Not a claim that voice is on — that is what it SAYS. -->
                  <TextBlock x:Name="ConsoleVoiceBackendLabel"
                             Grid.Column="1"
                             Text="voice: off"
                             Foreground="#8AA0B0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Margin="14,0,0,0"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="360"
                             ToolTip="The live speech backend. Moshi needs a GPU this machine does not have, so this resolves to Whisper+Kokoro." />
                </Grid>
              </Border>

              <!-- MCP install security — stages 1 and 2 only. Approval is deliberately
                   absent: it requires a real terminal and a typed challenge phrase. -->
              <Border x:Name="ConsoleMcpPanel"
                      Grid.Row="3"
                      Visibility="Collapsed"
                      Background="#0C1A16"
                      BorderBrush="#1F4A3C"
                      BorderThickness="0,1,0,1"
                      Padding="16,10">
                <StackPanel>
                  <TextBlock Text="MCP INSTALL SECURITY · read-only stages"
                             Foreground="#5FD3A8"
                             FontSize="10"
                             FontWeight="Bold"
                             Margin="0,0,0,6" />
                  <TextBlock Text="Never install an MCP server you have not read. Discover finds candidates; Audit reads every source file and reports what the code can actually do. Results print in the console above."
                             Foreground="#9FBDB2"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8" />

                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="McpDiscoverNeedInput"
                             Height="30"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Background="#08120F"
                             Foreground="#E8F6F1"
                             CaretBrush="#5FD3A8"
                             BorderBrush="#1F4A3C"
                             BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             ToolTip="What do you need the server to do? e.g. read local sqlite" />
                    <Button x:Name="McpDiscoverButton"
                            Grid.Column="1"
                            Content="Discover"
                            Height="30"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Click="McpDiscoverButton_Click"
                            ToolTip="Stage 1 — search GitHub for candidates. Installs nothing."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="McpAuditPathInput"
                             Height="30"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Background="#08120F"
                             Foreground="#E8F6F1"
                             CaretBrush="#5FD3A8"
                             BorderBrush="#1F4A3C"
                             BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             ToolTip="Folder holding the candidate server's source code." />
                    <Button x:Name="McpBrowseButton"
                            Grid.Column="1"
                            Content="Browse…"
                            Height="30"
                            MinWidth="84"
                            Margin="8,0,0,0"
                            Click="McpBrowseButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="McpAuditButton"
                            Grid.Column="2"
                            Content="Audit"
                            Height="30"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Click="McpAuditButton_Click"
                            ToolTip="Stage 2 — read every source file. No network, no execution."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </Grid>

                  <TextBlock Text="Approval, sandbox and install are NOT here. Approving an install means typing a freshly generated challenge phrase into a real terminal, which is what makes the approval a human act. Run:  helmion mcp-install review &lt;path&gt;"
                             Foreground="#C9A227"
                             FontSize="10.5"
                             TextWrapping="Wrap"
                             Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <!-- Approval prompt — visible only while ask mode is waiting on you -->
              <Border x:Name="ConsoleApprovalPanel"
                      Grid.Row="4"
                      Visibility="Collapsed"
                      Background="#1C1608"
                      BorderBrush="{DynamicResource AmberBrush}"
                      BorderThickness="0,1,0,1"
                      Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="ConsoleApprovalTitleText"
                               Text="APPROVAL NEEDED"
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,3" />
                    <TextBlock x:Name="ConsoleApprovalSummaryText"
                               Text=""
                               Foreground="#F2E4C4"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ConsoleApprovalDetailText"
                               Text=""
                               Foreground="#B7A88A"
                               FontSize="10.5"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <Button x:Name="ConsoleApprovalAllowOnceButton"
                            Content="Allow once"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Click="ConsoleApprovalAllowOnce_Click"
                            ToolTip="Run this one call. The next call asks again."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="ConsoleApprovalAllowSessionButton"
                            Content="Allow for session"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Click="ConsoleApprovalAllowSession_Click"
                            ToolTip="Stop asking about THIS tool until you change permissions or reset."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="ConsoleApprovalDenyButton"
                            Content="Deny"
                            Height="32"
                            Padding="18,0"
                            Click="ConsoleApprovalDeny_Click"
                            ToolTip="Refuse this call. Nothing runs."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Input dock -->
              <Border Grid.Row="5"
                      Background="#101A22"
                      BorderBrush="#1A2834"
                      BorderThickness="0,1,0,0"
                      Padding="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="ConsoleMicButton"
                            Content="🎙"
                            Width="48"
                            Height="48"
                            FontSize="16"
                            Click="ConsoleMicButton_Click"
                            ToolTip="Start two-way voice (listen + speak). Works with every LLM."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <!-- Dictate: speech goes into the composer at the caret instead of
                         to the model. "new line", "scratch that", "send it" and
                         "stop dictation" are spoken commands; everything else is typed. -->
                    <Button x:Name="ConsoleDictateButton"
                            Content="⌨"
                            Width="48"
                            Height="48"
                            Margin="8,0,0,0"
                            FontSize="16"
                            Click="ConsoleDictateButton_Click"
                            ToolTip="Dictate mode: what you say is TYPED into the box, not sent to the model. Say &quot;send it&quot; to submit, &quot;new line&quot;, &quot;scratch that&quot;, or &quot;stop dictation&quot;."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </StackPanel>

                  <Border Grid.Column="1"
                          Background="#0A1218"
                          BorderBrush="#3A5568"
                          BorderThickness="1"
                          CornerRadius="14"
                          MinHeight="48"
                          MaxHeight="160"
                          VerticalAlignment="Center">
                    <!-- Multi-line so Ctrl+V pastes the FULL clipboard (not only the first line).
                         Enter sends; Shift+Enter inserts a newline.
                         ALWAYS light-on-dark — never bind to theme TextBrush (clean-light = dark ink). -->
                    <TextBox x:Name="ConsoleInputBox"
                             MinHeight="46"
                             MaxHeight="156"
                             Padding="14,12"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             Background="#0A1218"
                             Foreground="#F2FBFF"
                             CaretBrush="#7FE3FF"
                             SelectionBrush="#2A6F8F"
                             BorderThickness="0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             FontFamily="Cascadia Mono, Consolas, Segoe UI"
                             PreviewKeyDown="ConsoleInputBox_PreviewKeyDown" />
                  </Border>

                  <Button x:Name="ConsoleSendButton"
                          Grid.Column="2"
                          Content="Send  ↵"
                          Margin="10,0,0,0"
                          MinWidth="96"
                          Height="48"
                          Click="ConsoleSendButton_Click"
                          Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Live activity stream -->
        <ScrollViewer x:Name="ActivityPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Live Activity Stream" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Orchestration Timeline · provider routing, review, proof, checkpoints, and handoffs."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,6,0,0" />
              </StackPanel>
              <Border Grid.Column="1"
                      Style="{StaticResource PillStyle}"
                      Background="{DynamicResource AccentDarkBrush}"
                      BorderBrush="{DynamicResource AccentStrokeStrongBrush}"
                      VerticalAlignment="Center">
                <TextBlock Text="ORCHESTRATION ACTIVE"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <UniformGrid Columns="3" Margin="0,22,0,18">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="SELECTED COORDINATOR" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="{Binding SelectedCoordinatorLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="Provider choice changes coordination only." Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                  <TextBlock Text="MAESTRO" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Control authority" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="Policy · leases · confirmations · audit" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="RECORDING MODE" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Redacted by default" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="No secrets, private prompts, or raw provider logs." Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="16"
                    Margin="0,0,0,16">
              <TextBlock Text="Evidence rule: “bug caught,” “test passed,” “blocker resolved,” “checkpoint committed,” and “handoff complete” remain unverified until the event links the actual diff, test, durable state, or acknowledgement."
                         Foreground="{DynamicResource SoftTextBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding OrchestrationEvents}"
                          ItemTemplate="{StaticResource OrchestrationEventTemplate}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Evidence -->
        <ScrollViewer x:Name="EvidencePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Handoff &amp; history evidence" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Readable proof for what changed, what was tested, and what comes next."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,6,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource PillStyle}" Background="{DynamicResource AccentDarkBrush}" BorderBrush="{DynamicResource AccentStrokeStrongBrush}" VerticalAlignment="Center">
                <TextBlock Text="LIVE TIMELINE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding Handoffs}"
                          ItemTemplate="{StaticResource HandoffTemplate}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Evidence contract" Style="{StaticResource SectionTitleStyle}" />
                <UniformGrid Columns="3" Margin="0,19,0,0">
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="CHECKPOINT" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Work completed, files changed, tests, risks, and next action." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Margin="9,0">
                    <TextBlock Text="HANDOFF" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Source, target, completeness, and the exact checkpoint identity." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Margin="18,0,0,0">
                    <TextBlock Text="DURABILITY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Acknowledged commit result before state is presented as durable." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Approvals -->
        <ScrollViewer x:Name="ApprovalsPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <Border Style="{StaticResource CardStyle}"
                    Background="{DynamicResource AccentPanelBrush}"
                    BorderBrush="{DynamicResource AccentStrokeBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0">
                  <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Left" Background="{DynamicResource AccentDarkBrush}">
                    <TextBlock Text="PERSONAL PILOT MODE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="Routine work keeps moving."
                             FontSize="26"
                             FontWeight="SemiBold"
                             Margin="0,16,0,0" />
                  <TextBlock Text="Advanced owner signing is optional and not configured. The personal pilot remains useful for bounded local work, evidence, and policy visibility."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource AccentStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18">
                  <StackPanel>
                    <TextBlock Text="ADVANCED OWNER SIGNING"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Text="Not configured"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Optional feature · no key or enrollment"
                               Style="{StaticResource MutedStyle}"
                               Margin="0,5,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid Margin="0,22,0,13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Decision preview" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Examples show policy behavior only; no approval action is wired."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="0 ACTIONABLE"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontWeight="Bold"
                         FontSize="10"
                         VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ApprovalQueue}"
                          ItemTemplate="{StaticResource ApprovalTemplate}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,25,0">
                  <TextBlock Text="What runs normally" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="Explicitly local, reversible, well-bounded work without sensitive data or protected-boundary changes."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                  <TextBlock Text="What this shell cannot authorize" Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="External writes, production deploys, credential access, destructive changes, trust changes, or guard bypasses."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Integrations -->
        <ScrollViewer x:Name="IntegrationsPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <StackPanel>
              <TextBlock Text="Integrations" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Provider profiles and capability posture. The desktop renderer accepts no secrets."
                         Style="{StaticResource MutedStyle}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,20">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Local-service boundary" Style="{StaticResource SectionTitleStyle}" />
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}">
                    <TextBlock Text="READ-ONLY IMPLEMENTED" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>
                <Grid Margin="0,24,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="Desktop shell" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="No credentials · presentation, setup, owner interaction" Style="{StaticResource MutedStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="↔" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="Loopback service" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Current-user named pipe · typed read-only API" Style="{StaticResource MutedStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="3" Text="↔" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="4" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="Maestro control plane" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Policy and lease authority · providers coordinate only" Style="{StaticResource MutedStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Authentication modes stay separate"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Helmion never asks for a provider secret in chat, the embedded console, activity history, logs, or a renderer field."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,6,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          Background="{DynamicResource AccentPanelBrush}"
                          CornerRadius="11"
                          Padding="14"
                          Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="CLI ACCOUNT SIGN-IN"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="10"
                                 FontWeight="Bold" />
                      <TextBlock Text="Provider-owned browser/session flow. Helmion may later request only a redacted sign-in status; it does not collect the account password or copy existing auth files."
                                 Style="{StaticResource MutedStyle}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1"
                          Background="{DynamicResource WarningPanelBrush}"
                          CornerRadius="11"
                          Padding="14"
                          Margin="7,0,0,0">
                    <StackPanel>
                      <TextBlock Text="API-KEY ADAPTER"
                                 Foreground="{DynamicResource AmberBrush}"
                                 FontSize="10"
                                 FontWeight="Bold" />
                      <TextBlock Text="A separate adapter with service-only enrollment and Windows CurrentUser DPAPI at rest. No API key is enrolled in this build."
                                 Style="{StaticResource MutedStyle}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
