    <!--
      ================================================================
      GUARD FEED  ·  the escalating side panel
      ================================================================
      A DASHBOARD, NOT A DETECTOR. Every card rendered below was handed to
      GuardFeed by something that already existed: the browser pattern match and
      the execution guard (through the block ledger at
      <workspace>\.helmion\audit\blocks-YYYY-MM-DD.jsonl, written by
      src/core/audit-log.mjs), the real write lease (src/core/lease.mjs via
      LeaseInspector.cs), and the local named-pipe service. Nothing here invents a
      finding, and nothing here shows green for a state it could not compute.

      COLOUR IS NEVER THE ONLY CHANNEL. Every card carries, in addition to its
      colour: the level as a word (UNKNOWN / OK / WARNING / CRITICAL), an icon
      (? / ✓ / ! / ✖), a state sentence that names the motion in words
      ("escalating toward critical"), and the reason with the threshold number in
      it. Turn the colour and the motion off entirely and the card still reads.

      THE SAFETY PALETTE IS FIXED, NOT THEMED. A red that becomes a different red
      when the user picks another colour theme is a red somebody can mis-learn.
      These five brushes are the same in every theme, and their ink colours are
      chosen against their own fill rather than against the page.
    -->
    <SolidColorBrush x:Key="GuardUnknownBrush" Color="#7A8290" />
    <SolidColorBrush x:Key="GuardUnknownInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GuardNormalBrush" Color="#55606E" />
    <SolidColorBrush x:Key="GuardNormalInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GuardWarningBrush" Color="#D8A013" />
    <SolidColorBrush x:Key="GuardWarningInkBrush" Color="#1C1403" />
    <SolidColorBrush x:Key="GuardCriticalBrush" Color="#C62828" />
    <SolidColorBrush x:Key="GuardCriticalInkBrush" Color="#FFFFFF" />

    <!-- The level chip's fill. Unknown is the default, so a binding that fails
         renders grey and says UNKNOWN rather than inheriting a confident colour. -->
    <Style x:Key="GuardChipStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GuardUnknownBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Normal">
          <Setter Property="Background" Value="{StaticResource GuardNormalBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource GuardWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Critical">
          <Setter Property="Background" Value="{StaticResource GuardCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GuardChipTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GuardUnknownInkBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
          <Setter Property="Foreground" Value="{StaticResource GuardWarningInkBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Critical">
          <Setter Property="Foreground" Value="{StaticResource GuardCriticalInkBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The 4px edge bar: a second colour channel, and a shape an assistive
         reader can be told about. Unknown is dashed so it differs from Normal by
         more than a shade of grey. -->
    <Style x:Key="GuardEdgeBarStyle" TargetType="Border">
      <Setter Property="Width" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{StaticResource GuardUnknownBrush}" />
      <Setter Property="Opacity" Value="0.55" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Normal">
          <Setter Property="Background" Value="{StaticResource GuardNormalBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource GuardWarningBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Critical">
          <Setter Property="Background" Value="{StaticResource GuardCriticalBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A session's stoplight dot in the left panel. Same LevelKey values and the
         same four brushes as the guard cards above, because it is the same
         escalation rule's output — not a parallel scheme. Unknown is the DEFAULT
         setter, so a session with no card behind it, or a binding that failed,
         renders grey rather than inheriting a confident colour. The row also
         prints the level as a word, so the dot is never the only channel. -->
    <Style x:Key="SessionDotStyle" TargetType="Ellipse">
      <Setter Property="Fill" Value="{StaticResource GuardUnknownBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Normal">
          <Setter Property="Fill" Value="{StaticResource GuardNormalBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
          <Setter Property="Fill" Value="{StaticResource GuardWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Critical">
          <Setter Property="Fill" Value="{StaticResource GuardCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One provider pill under the composer. Deliberately plain: it is a button
         that starts a real session, not a status light. -->
    <Style x:Key="SessionPillStyle" TargetType="Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,7,0" />
