                               Margin="0,6,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="LIVE LOCAL CONFIG" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>

                <TextBlock Text="Primary providers only: OpenAI · Anthropic · Google Gemini · xAI Grok. Groq/Llama is not used."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,10,0,10" />

                <TextBlock Text="Secrets are masked (PasswordBox). Never screenshot this page with live keys."
