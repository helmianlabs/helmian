                <ItemsControl ItemsSource="{Binding ReleaseCapabilities}"
                              ItemTemplate="{StaticResource ReleaseCapabilityTemplate}" />
              </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Identity boundary" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="System-browser OIDC + PKCE, short sessions, step-up for sensitive actions, and explicit tenant membership."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0">
                <StackPanel>
                  <TextBlock Text="Data boundary" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
