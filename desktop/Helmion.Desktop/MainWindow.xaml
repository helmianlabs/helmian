                    <ItemsPanelTemplate>
                      <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AccentPanelBrush}"
