                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Text="Phase 5A · foundation"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,11,0,0" />
                    <TextBlock Text="Personal Pilot and local service integration is active. Enterprise multi-user features are scheduled for later phases."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,7,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Release sequence" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Grid.Column="1"
                             Text="FOUNDATION → CERTIFICATION"
                             Foreground="{DynamicResource MutedTextBrush}"
                             FontSize="10"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
