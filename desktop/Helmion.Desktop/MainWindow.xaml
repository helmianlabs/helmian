                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource AccentStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">
                  <StackPanel>
                    <TextBlock Text="CURRENT PRODUCT STATE"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Text="Phase 5A · foundation"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,11,0,0" />
                    <TextBlock Text="Helmian local desktop foundations are active. Multi-user features remain future work."
