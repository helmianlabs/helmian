    <DataTemplate x:Key="GuardOptionTemplate">
      <!-- Tag = option; CommandParameter = parent GuardCard via ItemsControl.Tag. -->
      <Button Style="{StaticResource GuardOptionButtonStyle}"
              Tag="{Binding}"
              Click="GuardOption_Click"
              ToolTip="{Binding Detail}"
              CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{DynamicResource AccentPanelBrush}"
                  BorderBrush="{DynamicResource AccentStrokeBrush}"
