                    <TextBlock x:Name="ExternalReviewCapabilitiesText" Foreground="{DynamicResource SoftTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExternalReviewFindingsText" Foreground="{DynamicResource SoftTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Boundary · this is not a malware scanner, a safety guarantee, an installer, or an activation control. Missing evidence stays Unknown. No actual install/activation path exists in this panel; any future passing review must still be followed by explicit user approval."
