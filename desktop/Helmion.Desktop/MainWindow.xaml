                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Mode" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Presentation policy" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="Personal Pilot"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Data source" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Operational state" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataSourceLabel}"
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Advanced owner signing" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Optional high-risk ceremony" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="Not configured"
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                    <TextBlock Text="OPTIONAL · OFF" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Profile synchronization" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Sync rules/hooks across Claude, Gemini, Codex" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SyncProfileButton"
                            Content="Sync Profile"
                            Click="SyncProfile_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"
                            AutomationProperties.Name="Sync Profile" />
                    <TextBlock x:Name="SyncStatusLabel"
                               Text=""
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <TextBlock Text="Safety defaults" Style="{StaticResource SectionTitleStyle}" />
                  <!-- 2026-07-29: these two read "✓ No credentials loaded by the
                       desktop shell" and "✓ No agent configuration discovery",
                       twenty lines below the card that loads and saves those
                       credentials, in an app whose ProfileSyncEngine reads and
                       rewrites ~/.claude.json, %APPDATA%\Claude\ and
                       ~/.gemini/. Replaced with what is actually true. -->
                  <TextBlock Text="•  Provider keys are loaded from your .env and stay on this machine" Foreground="{DynamicResource SoftTextBrush}" Margin="0,18,0,0" />
                  <TextBlock Text="•  Agent configuration is written only when you click Sync Profile" Foreground="{DynamicResource SoftTextBrush}" Margin="0,11,0,0" />
                  <TextBlock Text="✓  System operations require explicit owner signature" Foreground="{DynamicResource SoftTextBrush}" Margin="0,11,0,0" />
                  <TextBlock Text="✓  Advisor consensus stays advisory" Foreground="{DynamicResource SoftTextBrush}" Margin="0,11,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="Build identity" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}" Margin="0,18,0,0" />
                  <TextBlock Text="0.1.0 · Phase Five shell" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Text="Runtime" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0" />
                  <TextBlock Text=".NET 10 · WPF · Windows x64" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Text="Readiness" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,0" />
                  <TextBlock Text="Local pilot shell · active" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="FooterChrome"
              Grid.Row="2"
              Background="{DynamicResource FooterBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,1,0,0"
              Padding="30,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- 2026-07-29: this read "No network connections · No credentials
               loaded · No external authority" on EVERY page and all three were
               false. Five HttpClients call api.openai.com, api.anthropic.com,
               api.x.ai and generativelanguage.googleapis.com
               (OpenAiChatSession.cs:15, ClaudeChatSession.cs:14,
               GrokChatSession.cs:16, GeminiChatSession.cs:15), and
               MainWindow.xaml.cs:674-704 loads five provider keys plus the
               database URL into this renderer. A footer a buyer reads on every
               screen is the last place to overstate a boundary. -->
          <TextBlock Text="Calls provider APIs directly · Provider keys loaded from your .env · Local named-pipe service"
                     Foreground="{DynamicResource FaintTextBrush}"
                     FontSize="10"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding GeneratedAtLabel}"
                     Foreground="{DynamicResource FaintTextBrush}"
                     FontSize="10"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
