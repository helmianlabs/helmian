                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="Isolated development target" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Helmian Development" Foreground="{DynamicResource AccentBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,0" />
                  <TextBlock Text="Endpoint · ep-divine-leaf-ay38p1af" Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  <TextBlock Text="Database · neondb" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                  <TextBlock Text="Hard-bound profile ready · protected material not enrolled · test not run"
                             Foreground="{DynamicResource AmberBrush}"
                             FontSize="11"
                             Margin="0,9,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,26,0">
                  <TextBlock Text="Provider-adapter contract"
                             Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Identity · auth type · CLI/API/local endpoint · capabilities · evidence · safety · non-mutating health check"
                             Style="{StaticResource MutedStyle}"
                             Margin="0,7,0,0" />
