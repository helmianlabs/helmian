                  <TextBlock Grid.Column="2" Text="CURRENT" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="Bold" />
                  <TextBlock Grid.Column="3" Text="RELEASE GATE" Foreground="{DynamicResource FaintTextBrush}" FontSize="9" FontWeight="Bold" />
