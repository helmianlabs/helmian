                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22,28,36" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="SETTINGS"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource AppFont}"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Appearance, keys, and local preferences. Same glass density as Console and Room — no dense admin chrome."
                       Style="{StaticResource MutedStyle}"
                       Margin="0,6,0,18" />

            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <!-- Keep theme explanation and picker in one responsive column.
                   The former fixed 340px picker column reduced the explanation
                   to a few characters per line in constrained windows. -->
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="Color theme" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock x:Name="ThemeDescription"
                             Text="Deep forest surfaces with a clear mint accent."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,6,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Ellipse Width="16" Height="16" Fill="#73E6B1" Margin="0,0,8,0"
                             ToolTip="Helmion green preview color" />
                    <Ellipse Width="16" Height="16" Fill="#65D5F5" Margin="0,0,8,0"
                             ToolTip="Ocean blue preview color" />
                    <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#9AA9A4" StrokeThickness="1" Margin="0,0,8,0"
                             ToolTip="Clean light preview color" />
                    <Ellipse Width="16" Height="16" Fill="#E9AD6B" Margin="0,0,8,0"
                             ToolTip="Warm earth preview color" />
                    <Ellipse Width="16" Height="16" Fill="#8EC5FF" Margin="0,0,8,0"
                             ToolTip="Black / cool graphite accent" />
                    <Ellipse Width="16" Height="16" Fill="#E53945"
                             ToolTip="Crimson accent" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,16,0,0">
                  <TextBlock Text="SELECT THEME" Style="{StaticResource SettingsFieldLabelStyle}" />
                  <ComboBox x:Name="ThemeSelector"
                            Visibility="Collapsed"
                            Height="38"
                            Padding="11,6"
                            Style="{StaticResource ThemePickerStyle}"
                            SelectedValuePath="Id"
                            SelectionChanged="ThemeSelector_SelectionChanged"
                            AutomationProperties.Name="Color theme"
                            AutomationProperties.HelpText="Select a color theme. The choice is saved only for the current Windows user." />
                  <TextBlock x:Name="ThemePersistenceLabel"
                             Text="Saved locally for this Windows user"
                             Foreground="{DynamicResource FaintTextBrush}"
                             FontSize="10"
                             Margin="1,6,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Text size -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="Text size" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Scales the whole window together — guard feed, nav, and console. Nothing overlaps."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="Ctrl+  ·  Ctrl−  ·  Ctrl+0 reset"
                             Style="{StaticResource MutedStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock x:Name="TextScalePersistenceLabel"
                             Text="Saved locally for this Windows user"
                             Foreground="{DynamicResource FaintTextBrush}"
                             FontSize="10"
                             Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" MinWidth="200">
                  <TextBlock Text="TEXT SIZE" Style="{StaticResource SettingsFieldLabelStyle}" />
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="TextScaleSmallerButton"
                            Content="A−"
                            MinWidth="44"
                            MinHeight="36"
                            Padding="10,4"
                            Click="TextScaleSmallerButton_Click"
                            Style="{StaticResource ConsoleNeutralButtonStyle}"
                            AutomationProperties.Name="Smaller text"
                            ToolTip="Smaller text (Ctrl and -)" />
                    <Border Background="{DynamicResource PanelInsetBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MinWidth="64"
                            MinHeight="36"
                            Margin="6,0"
                            Padding="8,4">
                      <TextBlock x:Name="TextScaleValueLabel"
                                 Text="100%"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Current text size" />
                    </Border>
                    <Button x:Name="TextScaleLargerButton"
                            Content="A+"
                            MinWidth="44"
                            MinHeight="36"
                            Padding="10,4"
                            Click="TextScaleLargerButton_Click"
                            Style="{StaticResource ConsoleNeutralButtonStyle}"
                            AutomationProperties.Name="Larger text"
                            ToolTip="Larger text (Ctrl and +)" />
                  </StackPanel>
                  <Button x:Name="TextScaleResetButton"
                          Content="Reset 100%"
                          MinHeight="30"
                          Padding="10,4"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          Click="TextScaleResetButton_Click"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Reset text size" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- API Keys & Database Credentials -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Keys &amp; database" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Saved to local .env on this machine. Applied to live runtime processes."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,6,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="LOCAL ONLY" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                  </Border>
                </Grid>

                <TextBlock Text="OpenAI · Anthropic · Gemini · Grok  ·  Secrets stay masked"
                           Style="{StaticResource MutedStyle}"
                           Margin="0,0,0,12" />

                <!-- ============ OpenAI: sign in with ChatGPT subscription (preferred) ============ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="OPENAI — SIGN IN WITH YOUR CHATGPT SUBSCRIPTION"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Signing in uses your ChatGPT Plus/Pro/Team plan instead of paying per API call. Helmion never sees your password — OpenAI opens your browser, you approve it there. The API key below stays as a fallback."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="ChatGptLoginButton"
                              Content="Login with ChatGPT"
                              Click="ChatGptLogin_Click"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Padding="16,10"
                              AutomationProperties.Name="Login with ChatGPT"
                              AutomationProperties.HelpText="Launch the Codex CLI to sign in with your ChatGPT subscription." />
                      <Button x:Name="ChatGptCheckAgainButton"
                              Content="Check again"
                              Click="ChatGptCheckAgain_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Check ChatGPT sign-in status again" />
                      <Button x:Name="ChatGptSignOutButton"
                              Content="Sign out"
                              Click="ChatGptSignOut_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Sign out of ChatGPT" />
                    </StackPanel>
                    <TextBlock x:Name="ChatGptStatusLabel"
                               Text="Checking…"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="ChatGPT sign-in status" />
                  </StackPanel>
                </Border>

                <!-- OpenAI API Key -->
                <TextBlock Text="OPENAI API KEY (fallback)" Style="{StaticResource SettingsFieldLabelStyle}" />
                <PasswordBox x:Name="OpenAiApiKeyInput"
                             Style="{StaticResource SettingsPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             AutomationProperties.Name="OpenAI API Key" />

                <!-- ============ Anthropic: paste a "claude setup-token" (preferred) ============ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="ANTHROPIC — USE YOUR CLAUDE SUBSCRIPTION"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Anthropic does not allow a browser sign-in flow for third-party apps like Helmion. Instead: open a terminal, run &quot;claude setup-token&quot; (requires the Claude Code CLI and a Pro/Max/Team/Enterprise plan), and paste what it prints below. That token runs on your subscription instead of a metered API key. The API key below stays as a fallback."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBox x:Name="ClaudeSetupTokenInput"
                             Style="{StaticResource SettingsInputBoxStyle}"
                             Margin="0,0,0,10"
                             AutomationProperties.Name="Claude setup-token"
                             AutomationProperties.HelpText="Paste the token printed by running claude setup-token in a terminal." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="ClaudeSaveTokenButton"
                              Content="Save token"
                              Click="ClaudeSaveToken_Click"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Padding="16,10"
                              AutomationProperties.Name="Save Claude subscription token" />
                      <Button x:Name="ClaudeSignOutButton"
                              Content="Sign out"
                              Click="ClaudeSignOut_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Sign out of Claude subscription" />
                    </StackPanel>
                    <TextBlock x:Name="ClaudeSubscriptionStatusLabel"
                               Text="Checking…"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Claude subscription status" />
                  </StackPanel>
                </Border>

                <!-- Anthropic API Key -->
                <TextBlock Text="ANTHROPIC API KEY (sk-ant-…, fallback)" Style="{StaticResource SettingsFieldLabelStyle}" />
                <PasswordBox x:Name="AnthropicApiKeyInput"
                             Style="{StaticResource SettingsPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             AutomationProperties.Name="Anthropic API Key" />

                <!-- ============ Google: sign in with Gemini/Google One subscription (preferred) ============ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="GOOGLE — SIGN IN WITH YOUR GEMINI / GOOGLE ONE SUBSCRIPTION"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Signing in uses your Google One AI Premium / Gemini Code Assist access instead of paying per API call. Helmion launches the Gemini CLI to sign in — it opens your browser, you approve it there. The API key below stays as a fallback."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="GeminiLoginButton"
                              Content="Login with Google"
                              Click="GeminiLogin_Click"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Padding="16,10"
                              AutomationProperties.Name="Login with Google"
                              AutomationProperties.HelpText="Launch the Gemini CLI to sign in with your Google account." />
                      <Button x:Name="GeminiCheckAgainButton"
                              Content="Check again"
                              Click="GeminiCheckAgain_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Check Google sign-in status again" />
                      <Button x:Name="GeminiSignOutButton"
                              Content="Sign out"
                              Click="GeminiSignOut_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Sign out of Google" />
                    </StackPanel>
                    <TextBlock x:Name="GeminiSubscriptionStatusLabel"
                               Text="Checking…"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Google sign-in status" />
                  </StackPanel>
                </Border>

                <!-- Gemini API Key -->
                <TextBlock Text="GOOGLE GEMINI API KEY (fallback)" Style="{StaticResource SettingsFieldLabelStyle}" />
                <PasswordBox x:Name="GeminiApiKeyInput"
                             Style="{StaticResource SettingsPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             FontSize="13"
                             AutomationProperties.Name="Gemini API Key"
                             AutomationProperties.HelpText="Enter your Google Gemini API key" />

                <!-- ============ Antigravity (Google) — CLI sign-in status ============ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="ANTIGRAVITY — GOOGLE SUBSCRIPTION SIGN-IN STATUS"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Antigravity's CLI shares the sign-in from the Antigravity desktop app — there is no separate login here. Helmion only READS that sign-in status and never changes it. This panel reports status; it does not by itself route your chat turns through Antigravity."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="AntigravityLoginButton"
                              Content="Sign in"
                              Click="AntigravityLogin_Click"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Padding="16,10"
                              AutomationProperties.Name="Sign in to Antigravity"
                              AutomationProperties.HelpText="Launch the Antigravity CLI, which triggers its own Google sign-in." />
                      <Button x:Name="AntigravityCheckAgainButton"
                              Content="Check again"
                              Click="AntigravityCheckAgain_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Check Antigravity sign-in status again" />
                      <Button x:Name="AntigravitySignOutButton"
                              Content="Sign out"
                              Click="AntigravitySignOut_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Sign out of Antigravity" />
                    </StackPanel>
                    <TextBlock x:Name="AntigravityStatusLabel"
                               Text="Checking…"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Antigravity sign-in status" />
                  </StackPanel>
                </Border>

                <!-- ============ xAI Grok: SuperGrok subscription (preferred) ============ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="XAI GROK — SIGN IN WITH YOUR SUPERGROK SUBSCRIPTION"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Signing in uses your SuperGrok plan instead of paying per API call. Helmion never sees your password — xAI shows you a code, you approve it in your browser. The API key below stays as a fallback."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Button x:Name="SuperGrokLoginButton"
                              Content="Login with SuperGrok"
                              Click="SuperGrokLogin_Click"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Padding="16,10"
                              AutomationProperties.Name="Login with SuperGrok"
                              AutomationProperties.HelpText="Start the xAI device sign-in. A code appears here and your browser opens so you can approve it." />
                      <Button x:Name="SuperGrokUseCliButton"
                              Content="Use existing Grok CLI session"
                              Click="SuperGrokUseCli_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Use existing Grok CLI session"
                              AutomationProperties.HelpText="Reuse the sign-in from the official Grok CLI on this machine instead of approving a new code." />
                      <Button x:Name="SuperGrokSignOutButton"
                              Content="Sign out"
                              Click="SuperGrokSignOut_Click"
                              Margin="10,0,0,0"
                              Padding="16,10"
                              AutomationProperties.Name="Sign out of SuperGrok" />
                    </StackPanel>

                    <!-- Device code panel: hidden until a sign-in is actually in flight. -->
                    <Border x:Name="SuperGrokCodePanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="ENTER THIS CODE IN YOUR BROWSER"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="SuperGrokUserCodeText"
                                 Text=""
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="26"
                                 FontWeight="Bold"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,6"
                                 AutomationProperties.Name="SuperGrok device code" />
                        <TextBlock x:Name="SuperGrokVerificationUriText"
                                   Text=""
                                   Style="{StaticResource MutedStyle}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <TextBlock x:Name="SuperGrokStatusLabel"
                               Text="Checking…"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="SuperGrok sign-in status" />
                  </StackPanel>
                </Border>

                <!-- xAI Grok API Key (not Groq) — fallback used when not signed in -->
                <TextBlock Text="XAI GROK API KEY (fallback · xai-… · not Groq)" Style="{StaticResource SettingsFieldLabelStyle}" />
                <PasswordBox x:Name="GrokApiKeyInput"
                             Style="{StaticResource SettingsPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             AutomationProperties.Name="xAI Grok API Key"
                             AutomationProperties.HelpText="Enter your xAI Grok API key from console.x.ai" />

                <!-- Database URL -->
                <TextBlock Text="POSTGRESQL / NEON URL (masked)" Style="{StaticResource SettingsFieldLabelStyle}" />
                <PasswordBox x:Name="DatabaseUrlInput"
                             Style="{StaticResource SettingsPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             AutomationProperties.Name="Database URL"
                             AutomationProperties.HelpText="Enter your PostgreSQL or Neon database URL" />

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>

                  <!-- Endpoint ID -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="NEON ENDPOINT ID" Style="{StaticResource SettingsFieldLabelStyle}" />
                    <TextBox x:Name="EndpointIdInput"
                             Style="{StaticResource SettingsInputBoxStyle}"
                             AutomationProperties.Name="Neon Endpoint ID" />
                  </StackPanel>

                  <!-- Codex Mode -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="CODEX MCP MODE" Style="{StaticResource SettingsFieldLabelStyle}" />
                    <ComboBox x:Name="CodexModeInput"
                              Height="36"
                              Padding="10,6"
                              Background="{DynamicResource PanelInsetBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              AutomationProperties.Name="Codex Mode">
                      <ComboBoxItem Content="read-only" IsSelected="True" />
                      <ComboBoxItem Content="read-write" />
                    </ComboBox>
                  </StackPanel>

                  <!-- Maestro Coordinator -->
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="MAESTRO COORDINATOR" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <ComboBox x:Name="MaestroCoordinatorInput"
                              Height="38"
                              Padding="10,8"
                              Background="{DynamicResource SurfaceRaisedBrush}"
                              Foreground="#17221F"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              AutomationProperties.Name="Active Maestro Coordinator">
                      <ComboBoxItem Content="OpenAI" />
                      <ComboBoxItem Content="Claude" />
                      <ComboBoxItem Content="Gemini" IsSelected="True" />
                      <ComboBoxItem Content="Grok" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="SaveApiKeysButton"
                          Content="Save API Keys &amp; Apply Environment"
                          Click="SaveApiKeys_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Padding="16,10"
                          AutomationProperties.Name="Save API Keys and Apply Environment" />
                  <TextBlock x:Name="ApiKeysStatusLabel"
                             Text=""
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0" />
                  <TextBlock x:Name="SchemaStatusLabel"
                             Text=""
                             Foreground="{DynamicResource AmberBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Custom LLM Endpoints Card -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Custom LLM endpoints" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="OpenAI-compatible base URL — DeepSeek, Qwen, Ollama, local runs."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,6,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="OPTIONAL" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                  </Border>
                </Grid>

                <!-- Input Form to Add New Profile -->
                <Grid Margin="0,4,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="MODEL NAME" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="CustomModelNameInput" Height="38" Padding="10,8" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" FontSize="13" />
                  </StackPanel>
                  
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="OPENAI-COMPATIBLE API ENDPOINT URL" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="CustomModelEndpointInput" Height="38" Padding="10,8" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" FontSize="13" />
                  </StackPanel>

                  <StackPanel Grid.Column="4">
                    <TextBlock Text="API KEY / AUTH TOKEN" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="CustomModelApiKeyInput" Height="38" Padding="10,8" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" FontSize="13" />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="AddCustomModelButton"
                          Content="[ + Add Custom LLM Provider ]"
                          Click="AddCustomModel_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Padding="16,10" />
                  <Button x:Name="VerifyCustomModelsButton"
                          Content="[ Verify endpoints ]"
                          Click="VerifyCustomModels_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Padding="16,10"
                          Margin="10,0,0,0"
                          ToolTip="Send one real request to each saved endpoint. Only a live answer marks it verified."
                          AutomationProperties.Name="Verify custom LLM endpoints" />
                  <TextBlock x:Name="CustomModelStatusLabel"
                             Text=""
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <TextBlock Text="Desktop profile" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Mode" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Presentation policy" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="Helmian"
                             Foreground="{DynamicResource AccentBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Data source" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Operational state" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataSourceLabel}"
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Advanced owner signing" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Optional high-risk ceremony" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="Not configured"
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                    <TextBlock Text="OPTIONAL · OFF" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Profile synchronization" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Sync rules/hooks across Claude, Gemini, Codex" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SyncProfileButton"
                            Content="Sync Profile"
                            Click="SyncProfile_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"
                            AutomationProperties.Name="Sync Profile" />
                    <TextBlock x:Name="SyncStatusLabel"
                               Text=""
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SettingsGlassCardStyle}" Margin="0,0,7,0">
                <StackPanel>
                  <TextBlock Text="Safety defaults" Style="{StaticResource SectionTitleStyle}" />
                  <!-- Honest: keys load from .env; Sync Profile writes agent config. -->
                  <TextBlock Text="• Keys load from .env and stay on this machine"
                             Foreground="{DynamicResource SoftTextBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="• Agent config writes only when you Sync Profile"
                             Foreground="{DynamicResource SoftTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="• Deploy / high-risk ops need human confirm (not auto)"
                             Foreground="{DynamicResource SoftTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="• Advisor output stays low-trust until you promote"
                             Foreground="{DynamicResource SoftTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource SettingsGlassCardStyle}" Margin="7,0,0,0">
                <StackPanel>
                  <TextBlock Text="Build identity" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Version" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,12,0,0" />
                  <TextBlock Text="0.1.0 · pilot shell" Foreground="{DynamicResource SoftTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                  <TextBlock Text="Runtime" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,12,0,0" />
                  <TextBlock Text=".NET 10 · WPF · Windows x64" Foreground="{DynamicResource SoftTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                  <TextBlock Text="Readiness" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,12,0,0" />
                  <TextBlock Text="Local desktop shell" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="FooterChrome"
              Grid.Row="2"
              Visibility="Collapsed"
              Background="{DynamicResource FooterBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Workspace tools" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Canvas" Click="MenuShowCanvas_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="9,3" />
            <Button Content="Preview" Click="MenuShowPreview_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="9,3" Margin="6,0,0,0" />
            <Button Content="Create" Click="MenuShowCreate_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="9,3" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Button x:Name="LeftPanelRestoreButton"
            Grid.Row="1"
            Grid.Column="2"
            Panel.ZIndex="70"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10"
            Height="30"
            MinWidth="64"
            Padding="10,0"
            Content="Sidebar"
            Visibility="Collapsed"
            Style="{StaticResource ConsoleNeutralButtonStyle}"
            ToolTip="Show sidebar"
            AutomationProperties.Name="Show sidebar"
            Click="LeftPanelToggleButton_Click" />

    <!-- When Guard is fully slid off right: thin edge strip (mirrors Room strip on left). -->
    <Button x:Name="RightPanelRestoreButton"
            Grid.Row="1"
            Grid.Column="2"
            Panel.ZIndex="70"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Margin="0,12,4,12"
            Width="28"
            MinWidth="28"
            Padding="0,8"
            Content="Guard"
            FontSize="10"
            FontWeight="Bold"
            Visibility="Collapsed"
            Style="{StaticResource ConsoleNeutralButtonStyle}"
            ToolTip="Open Guard / Browser / Preview / Create (slide in from right)"
            AutomationProperties.Name="Open details panel"
            Click="RightPanelToggleButton_Click">
      <Button.LayoutTransform>
        <RotateTransform Angle="90" />
      </Button.LayoutTransform>
    </Button>

    <!-- Drag rail: main ↔ Guard — drag all the way right to fully collapse. -->
    <GridSplitter x:Name="ContentGuardSplitter"
                  Grid.Row="1"
                  Grid.Column="3"
                  Width="10"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Cursor="SizeWE"
                  ShowsPreview="True"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  DragCompleted="ContentGuardSplitter_DragCompleted"
                  ToolTip="Drag to resize · drag fully right to hide Guard">
      <GridSplitter.Template>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="#18000000" Cursor="SizeWE">
            <Border x:Name="Knob" Width="4" Height="56"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <!--
      ================================================================
      THE GUARD FEED PANEL
      ================================================================
      Reads top to bottom: headline level, provider/site tabs, the stated
      escalation rule, the running list of events, then the footer actions.

      Nothing in it is a literal. The headline chip, every tab count, the retention
      line and the source line are all computed by GuardFeed from the cards it was
      given; where a state cannot be computed the panel says UNKNOWN in grey with
      the word on its face, and the headline is UNKNOWN — not OK — until a
      detection layer has actually reported.
    -->
    <Border x:Name="GuardPanelChrome"
            Grid.Row="1"
            Grid.Column="4"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <UniformGrid Columns="5">
              <ToggleButton x:Name="GuardWorkbenchTab" Content="Guard" Tag="guard" IsChecked="True"
                            Style="{StaticResource WorkbenchTabStyle}" Click="WorkbenchTab_Click"
                            AutomationProperties.Name="Guard workbench" />
              <ToggleButton x:Name="BrowserWorkbenchTab" Content="Browser" Tag="browser"
                            Style="{StaticResource WorkbenchTabStyle}" Click="WorkbenchTab_Click"
                            AutomationProperties.Name="Embedded web browser" />
              <ToggleButton x:Name="CanvasWorkbenchTab" Content="Canvas" Tag="canvas"
                            Style="{StaticResource WorkbenchTabStyle}" Click="WorkbenchTab_Click"
                            AutomationProperties.Name="Canvas project notes and decisions" />
              <ToggleButton x:Name="PreviewWorkbenchTab" Content="Preview" Tag="preview"
                            Style="{StaticResource WorkbenchTabStyle}" Click="WorkbenchTab_Click"
                            AutomationProperties.Name="Artifact preview, read-only" />
              <ToggleButton x:Name="CreateWorkbenchTab" Content="Create" Tag="create"
                            Style="{StaticResource WorkbenchTabStyle}" Click="WorkbenchTab_Click"
                            AutomationProperties.Name="Create artifact review" />
            </UniformGrid>
            <!-- Hide right panel from every workbench tab (not only Guard). -->
            <Button x:Name="RightPanelCollapseButton"
                    Grid.Column="1"
                    Content="›"
                    Width="28"
                    Height="28"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShelfCompactButtonStyle}"
                    ToolTip="Slide Guard fully off to the right (edge strip restores it)"
                    AutomationProperties.Name="Slide details panel off to the right"
                    AutomationProperties.HelpText="Fully hides the right panel. Use the Guard edge strip or View menu to open it again."
                    Click="RightPanelToggleButton_Click" />
          </Grid>
        </Border>

      <Grid x:Name="GuardWorkbenchSurface" Grid.Row="1" Margin="10,8,10,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Compact headline -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <TextBlock Text="GUARD"
                     FontWeight="Bold"
                     FontSize="11"
                     DockPanel.Dock="Left"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="GuardHeadlineCountsText"
                     Text="Clear"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="10"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 2. Tabs -->
        <ItemsControl x:Name="GuardTabStrip"
                      Grid.Row="1"
                      ItemTemplate="{StaticResource GuardTabTemplate}"
                      Margin="0,0,0,4">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Hidden: still bound for settings / chrome code -->
        <StackPanel Grid.Row="2" Visibility="Collapsed">
          <TextBlock x:Name="GuardSourceText" />
          <TextBlock x:Name="GuardRuleText" />
          <TextBlock x:Name="GuardRetentionText" />
          <TextBlock x:Name="GuardGroupingText" />
          <TextBlock x:Name="GuardMotionPolicyText" />
        </StackPanel>

        <!-- Empty + cards share row 3 -->
        <Grid Grid.Row="3">
          <Border x:Name="GuardEmptyPanel"
                  Background="Transparent"
                  Padding="4,12"
                  Visibility="Collapsed"
                  VerticalAlignment="Top">
            <TextBlock x:Name="GuardEmptyDetailText"
                       Text="No issues"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="11"
                       TextAlignment="Center" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GuardCardList"
                          ItemTemplate="{StaticResource GuardCardTemplate}" />
          </ScrollViewer>
        </Grid>

        <!-- Footer: one row of actions -->
        <StackPanel Grid.Row="4" Margin="0,6,0,0">
          <Border x:Name="GuardSettingsPanel"
                  Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="GuardSettingsText"
                         Foreground="{DynamicResource SoftTextBrush}"
                         FontSize="10"
                         TextWrapping="Wrap" />
              <CheckBox x:Name="GuardShowAcknowledgedCheckBox"
                        Content="Show acknowledged"
                        Foreground="{DynamicResource SoftTextBrush}"
                        FontSize="10"
                        Margin="0,6,0,0"
                        Click="GuardShowAcknowledgedToggle_Click" />
              <CheckBox x:Name="GuardMotionCheckBox"
                        Content="Pulse animations"
                        Foreground="{DynamicResource SoftTextBrush}"
                        FontSize="10"
                        Margin="0,4,0,0"
                        Click="GuardMotionToggle_Click" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="GuardFooterOutputText"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Margin="0,0,0,4"
                     Visibility="Collapsed" />
          <Button x:Name="GuardFooterOutputDismissButton"
                  Content="Dismiss"
                  Style="{StaticResource GuardFooterButtonStyle}"
                  Visibility="Collapsed"
                  Click="GuardFooterOutputDismiss_Click" />

          <UniformGrid Columns="2" Margin="0,2,0,0">
            <Button x:Name="GuardAcknowledgeAllButton"
                    Content="Ack all"
                    Style="{StaticResource GuardFooterButtonStyle}"
                    Margin="0,0,3,3"
                    ToolTip="Hide non-critical cards"
                    Click="GuardAcknowledgeAll_Click" />
            <Button x:Name="GuardSettingsButton"
                    Content="Settings"
                    Style="{StaticResource GuardFooterButtonStyle}"
                    Margin="3,0,0,3"
                    Click="GuardSettings_Click" />
            <Button x:Name="GuardQuarantineButton"
                    Content="Quarantine"
                    Style="{StaticResource GuardFooterButtonStyle}"
                    Margin="0,0,3,0"
                    Click="GuardViewQuarantineLog_Click" />
            <Button x:Name="GuardTestSuiteButton"
                    Content="Tests"
                    Style="{StaticResource GuardFooterButtonStyle}"
                    Margin="3,0,0,0"
                    Click="GuardRunTestSuite_Click" />
          </UniformGrid>
        </StackPanel>
      </Grid>

        <Grid x:Name="BrowserWorkbenchSurface" Grid.Row="1" Visibility="Collapsed" Margin="10,8,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BrowserBackButton" Grid.Column="0" Content="←"
                    IsEnabled="False" Style="{StaticResource ConsoleNeutralButtonStyle}"
                    MinWidth="28" Height="28" Padding="0"
                    AutomationProperties.Name="Browser back" ToolTip="Back"
                    Click="BrowserBackButton_Click" />
            <Button x:Name="BrowserForwardButton" Grid.Column="1" Content="→"
                    IsEnabled="False" Margin="3,0,0,0" Style="{StaticResource ConsoleNeutralButtonStyle}"
                    MinWidth="28" Height="28" Padding="0"
                    AutomationProperties.Name="Browser forward" ToolTip="Forward"
                    Click="BrowserForwardButton_Click" />
            <Button x:Name="BrowserReloadButton" Grid.Column="2" Content="↻"
                    IsEnabled="False" Margin="3,0,0,0" Style="{StaticResource ConsoleNeutralButtonStyle}"
                    MinWidth="28" Height="28" Padding="0"
                    AutomationProperties.Name="Reload browser page" ToolTip="Reload"
                    Click="BrowserReloadButton_Click" />
            <Border Grid.Column="3"
                    Background="{DynamicResource PanelInsetBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="5,0">
              <TextBox x:Name="BrowserWebAddressBox"
                       Text="https://"
                       Background="Transparent" Foreground="{DynamicResource TextBrush}"
                       BorderThickness="0" TextWrapping="NoWrap" FontSize="12"
                       VerticalContentAlignment="Center"
                       AutomationProperties.Name="Browser web address"
                       KeyDown="BrowserWebAddressBox_KeyDown" />
            </Border>
            <Button x:Name="BrowserGoButton" Grid.Column="4" Content="Go"
                    Style="{StaticResource ConsoleNeutralButtonStyle}"
                    Height="28" Padding="10,0" Margin="0,0,4,0"
                    AutomationProperties.Name="Open web address in Helmian browser"
                    Click="BrowserGoButton_Click" />
            <Button x:Name="BrowserClearButton" Grid.Column="5" Content="Clear"
                    Style="{StaticResource ConsoleNeutralButtonStyle}"
                    Height="28" Padding="12,0"
                    ToolTip="Clear the browser page (blank). Does not delete project files."
                    AutomationProperties.Name="Clear browser page"
                    Click="BrowserClearButton_Click" />
          </Grid>

          <Border Grid.Row="1" Background="#0A0A0C" BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="200">
            <Grid>
              <wv2:WebView2 x:Name="BrowserWebView"
                            AutomationProperties.Name="Rendered website content"
                            NavigationStarting="BrowserWebView_NavigationStarting"
                            NavigationCompleted="BrowserWebView_NavigationCompleted" />
              <TextBlock x:Name="BrowserStatusText"
                         Text=""
                         Foreground="{DynamicResource FaintTextBrush}"
                         FontSize="10"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="8"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>

          <Expander Grid.Row="2" Margin="0,6,0,0"
                    Header="Text fetch"
                    IsExpanded="False"
                    Foreground="{DynamicResource MutedTextBrush}"
                    FontSize="10"
                    AutomationProperties.Name="Safe reference reader, text only">
            <StackPanel Margin="0,6,0,0">
              <Border Background="{DynamicResource PanelInsetBrush}"
                      BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="8">
                <TextBox x:Name="BrowserReferenceAddressBox" Text="https://"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}"
                         BorderThickness="0" TextWrapping="NoWrap"
                         AutomationProperties.Name="Reference reader HTTPS address" />
              </Border>
              <Button x:Name="BrowserReferenceLoadButton" Content="Fetch text"
                      HorizontalAlignment="Left" Margin="0,8,0,0"
                      Style="{StaticResource ConsoleNeutralButtonStyle}"
                      ToolTip="Read one public HTTPS text page without cookies, credentials, scripts, or downloads."
                      AutomationProperties.Name="Read public HTTPS page as inert text"
                      Click="BrowserReferenceLoadButton_Click" />
              <TextBlock x:Name="BrowserReferenceStatusText" Text="No reference loaded."
                         Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                         TextWrapping="Wrap" Margin="0,7,0,0" />
              <Border x:Name="BrowserReferenceResultCard" Style="{StaticResource CardStyle}"
                      Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="BrowserReferenceTitleText" Text="Reference title"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="BrowserReferenceLocationText"
                             Foreground="{DynamicResource FaintTextBrush}" FontSize="9"
                             TextWrapping="Wrap" Margin="0,4,0,8" />
                  <TextBox x:Name="BrowserReferenceContentBox" MinHeight="180" MaxHeight="360"
                           IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           Background="{DynamicResource PanelInsetBrush}" Foreground="{DynamicResource TextBrush}"
                           BorderBrush="{DynamicResource StrokeBrush}" Padding="8"
                           AutomationProperties.Name="Inert reference page text" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
        </Grid>

        <ScrollViewer x:Name="CanvasWorkbenchSurface" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button x:Name="CanvasClearButton"
                      Content="Clear"
                      DockPanel.Dock="Right"
                      Style="{StaticResource ConsoleNeutralButtonStyle}"
                      Height="28" Padding="12,0"
                      ToolTip="Clear the notes and decision boxes on screen. Does not delete saved files until you Save."
                      AutomationProperties.Name="Clear canvas fields"
                      Click="CanvasClearButton_Click" />
              <StackPanel>
                <TextBlock Text="CANVAS" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="Project notes and decisions"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="CanvasProjectText"
                       Text="Select a project to use Canvas."
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Project notes" FontWeight="SemiBold" />
                <TextBlock Text="Saved locally to planning/canvas.md only after you press Save notes. No provider receives this text."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <Border Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">
                  <TextBox x:Name="CanvasNoteBox"
                           MinHeight="150"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Background="Transparent"
                           Foreground="{DynamicResource TextBrush}"
                           BorderThickness="0"
                           IsEnabled="False"
                           AutomationProperties.Name="Project Canvas notes" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="CanvasSaveButton"
                          Content="Save notes"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          IsEnabled="False"
                          ToolTip="Save Canvas notes inside the selected project. This makes no provider call."
                          AutomationProperties.Name="Save project Canvas notes"
                          Click="CanvasSaveButton_Click" />
                  <Button Content="Clear notes"
                          Margin="8,0,0,0"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          ToolTip="Clear the notes box only"
                          Click="CanvasClearButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Record a decision" FontWeight="SemiBold" />
                <TextBlock Text="A decision is an append-only project activity entry. It is not an approval and does not execute anything."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <Border Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">
                  <TextBox x:Name="CanvasDecisionBox"
                           MinHeight="64"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           Background="Transparent"
                           Foreground="{DynamicResource TextBrush}"
                           BorderThickness="0"
                           IsEnabled="False"
                           AutomationProperties.Name="Project decision detail" />
                </Border>
                <Button x:Name="CanvasDecisionButton"
                        Content="Record decision"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Style="{StaticResource ConsoleNeutralButtonStyle}"
                        ToolTip="Append this decision to the selected project's local activity history."
                        AutomationProperties.Name="Record project decision"
                        Click="CanvasDecisionButton_Click" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="CanvasStatusText"
                       Text="Canvas is local and project-scoped. No project is selected."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <TextBlock Text="RECENT PROJECT ACTIVITY"
                       FontWeight="Bold"
                       FontSize="10"
                       Margin="0,18,0,8" />
            <TextBlock x:Name="ProjectActivityEmptyText"
                       Text="No Canvas saves, decisions, or connected approval events have been recorded for this project."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <ItemsControl x:Name="ProjectActivityList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding KindLabel}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding TimeLabel}"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   FontSize="9"
                                   HorizontalAlignment="Right" />
                      </DockPanel>
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 Margin="0,5,0,0" />
                      <TextBlock Text="{Binding Detail}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Source}"
                                 Foreground="{DynamicResource FaintTextBrush}"
                                 FontSize="9"
                                 TextWrapping="Wrap"
                                 Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Preview: list (top) | splitter | image/detail (bottom) — drag both ends -->
        <Grid x:Name="PreviewWorkbenchSurface" Grid.Row="1" Visibility="Collapsed" Margin="12,8,12,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PreviewListRowDef" Height="*" MinHeight="80" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="PreviewDetailRowDef" Height="1.4*" MinHeight="120" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="PreviewClearButton"
                        Content="Clear"
                        Style="{StaticResource ConsoleNeutralButtonStyle}"
                        Height="28" Padding="12,0" Margin="0,0,6,0"
                        ToolTip="Clear the selected artifact view (list stays). Does not delete files."
                        AutomationProperties.Name="Clear artifact preview"
                        Click="PreviewClearButton_Click" />
                <Button x:Name="PreviewRefreshButton"
                        Content="Refresh"
                        Style="{StaticResource ConsoleNeutralButtonStyle}"
                        Height="28" Padding="12,0"
                        AutomationProperties.Name="Refresh project artifact history"
                        ToolTip="Read the selected project's Helmian artifact directory. Nothing is opened or executed."
                        Click="PreviewRefreshButton_Click" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="PREVIEW" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="Read-only artifact history"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="PreviewProjectText"
                       Text="No project selected."
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="PreviewStatusText"
                       Text="Select a project to view its artifact history."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Project artifacts" FontWeight="SemiBold" />
                <TextBlock x:Name="PreviewArtifactEmptyText"
                           Text="No supported outputs found."
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
                <ItemsControl x:Name="PreviewArtifactList" Margin="0,7,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Tag="{Binding FullPath}"
                              Style="{StaticResource ConsoleNeutralButtonStyle}"
                              HorizontalContentAlignment="Stretch"
                              Margin="0,3,0,0"
                              AutomationProperties.Name="{Binding Name}"
                              Click="ArtifactPreviewButton_Click">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RelativePath}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Kind}" HorizontalAlignment="Right" FontSize="9" />
                            <TextBlock Text="{Binding SizeLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Right"
                                       FontSize="9" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <GridSplitter Grid.Row="2"
                        Height="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeNS"
                        ShowsPreview="True"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext"
                        ToolTip="Drag to resize artifact list and preview">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeNS">
                  <Border Width="48" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                          CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                </Border>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>
          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock x:Name="PreviewArtifactNameText"
                           Text="Select an artifact"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewArtifactMetadataText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <Image x:Name="PreviewArtifactImage"
                       Visibility="Collapsed"
                       MaxHeight="480"
                       Stretch="Uniform"
                       Margin="0,12,0,0"
                       AutomationProperties.Name="Selected project image preview" />
                <TextBox x:Name="PreviewArtifactText"
                         Visibility="Collapsed"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="400"
                         Background="{DynamicResource PanelInsetBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource StrokeBrush}"
                         Margin="0,12,0,0"
                         Padding="10"
                         AutomationProperties.Name="Selected project text preview" />
                <TextBlock x:Name="PreviewArtifactBoundaryText"
                           Text="Preview reads supported project outputs only. It never executes embedded content."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Create: compose (top) | splitter | history (bottom) -->
        <Grid x:Name="CreateWorkbenchSurface" Grid.Row="1" Visibility="Collapsed" Margin="10,6,10,8">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="CreateComposeRowDef" Height="1.6*" MinHeight="160" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="CreateHistoryRowDef" Height="*" MinHeight="100" />
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="CREATE" FontWeight="Bold" FontSize="12" DockPanel.Dock="Left" />
              <TextBlock x:Name="ArtifactStudioProjectText"
                         Text="Select a project"
                         Foreground="{DynamicResource FaintTextBrush}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock x:Name="ArtifactProviderBoundaryText"
                         Text=""
                         Foreground="{DynamicResource AmberBrush}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         MaxWidth="220" />
              <Button x:Name="ArtifactEnrollImagesButton"
                      Content="Set up OpenAI Images"
                      Visibility="Collapsed"
                      Margin="8,0,0,0"
                      Style="{StaticResource ConsoleNeutralButtonStyle}"
                      FontSize="10"
                      Padding="8,4"
                      ToolTip="Enroll OpenAI Images once via Local Service (uses your OpenAI key path)."
                      Click="ArtifactEnrollImagesButton_Click" />
            </StackPanel>

            <Border Background="{DynamicResource GlassPanelBrush}"
                    BorderBrush="{DynamicResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="12" />
                <Border Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="8" Margin="0,6,0,0">
                  <TextBox x:Name="ArtifactDescriptionBox"
                           MaxLength="16000"
                           MinHeight="72"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Background="Transparent"
                           Foreground="{DynamicResource TextBrush}"
                           CaretBrush="{DynamicResource AccentBrush}"
                           BorderThickness="0"
                           FontSize="12"
                           AutomationProperties.Name="Describe the artifact you want" />
                </Border>

                <TextBlock Text="TYPE" Style="{StaticResource SettingsFieldLabelStyle}" Margin="0,10,0,4" />
                <ComboBox x:Name="ArtifactOutputCombo"
                          SelectedValuePath="Id"
                          Height="34"
                          Style="{StaticResource ThemePickerStyle}"
                          AutomationProperties.Name="Optional artifact output type" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ArtifactPrepareButton"
                          Content="Review"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Review Artifact Studio request"
                          ToolTip="Prepare review only — does not call a provider yet."
                          Click="ArtifactPrepareButton_Click" />
                  <TextBlock x:Name="ArtifactStudioStatusText"
                             Text=""
                             Foreground="{DynamicResource MutedTextBrush}"
                             FontSize="10"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="10,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ArtifactReviewPanel"
                    Background="{DynamicResource GlassPanelBrush}"
                    BorderBrush="{DynamicResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Visibility="Collapsed"
                    Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="REVIEW" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="ArtifactReviewTitleText"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="ArtifactReviewRouteText"
                           Foreground="{DynamicResource SoftTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="ArtifactReviewScopeText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="ArtifactReviewInstructionsText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxHeight="80"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="ArtifactReviewStateText"
                           Foreground="{DynamicResource AmberBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ArtifactDenyButton"
                          Content="Deny"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Deny selected Artifact Studio request"
                          Click="ArtifactDenyButton_Click" />
                  <Button x:Name="ArtifactApproveButton"
                          Content="Approve"
                          Margin="6,0,0,0"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Approve selected Artifact Studio plan"
                          ToolTip="Records approval. Generate uses OpenAI Images when enrolled."
                          Click="ArtifactApproveButton_Click" />
                  <Button x:Name="ArtifactGenerateButton"
                          Content="Generate"
                          Visibility="Collapsed"
                          Margin="6,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Generate approved Artifact Studio request"
                          ToolTip="Calls Local Service image adapter and saves to project artifacts."
                          Click="ArtifactGenerateButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
            </StackPanel>
          </ScrollViewer>

          <GridSplitter Grid.Row="1"
                        Height="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeNS"
                        ShowsPreview="True"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext"
                        ToolTip="Drag to resize compose and history">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeNS">
                  <Border Width="48" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                          CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                </Border>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <TextBlock Text="Request history" FontWeight="SemiBold" DockPanel.Dock="Left" />
                  <Button Content="Refresh"
                          HorizontalAlignment="Right"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Refresh Artifact Studio request history"
                          Click="ArtifactHistoryRefreshButton_Click" />
                </DockPanel>
                <TextBlock x:Name="ArtifactHistoryEmptyText"
                           Text="No Artifact Studio requests have been recorded for this project."
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <ItemsControl x:Name="ArtifactRequestHistoryList" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Tag="{Binding Id}"
                              Style="{StaticResource ConsoleNeutralButtonStyle}"
                              HorizontalContentAlignment="Stretch"
                              Margin="0,4,0,0"
                              AutomationProperties.Name="{Binding Title}"
                              Click="ArtifactHistoryItem_Click">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProviderName}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding KindLabel}" HorizontalAlignment="Right" FontSize="9" />
                            <TextBlock Text="{Binding StateLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Right"
                                       FontSize="9" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
