                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MaestroPill" Property="Opacity" Value="0.92" />
                <Setter TargetName="MaestroPill" Property="BorderBrush" Value="{DynamicResource SoftTextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MaestroPill" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      THE PULSE. Driven by AnimatePulse, which is ShouldPulse AND the OS allows
      motion (GuardFeed.AnimationsEnabled ← SystemParameters.ClientAreaAnimation).
      ShouldPulse stays true when motion is suppressed, so the words on the card
      still say "escalating" — the escalation is never carried by movement alone.

      0.55s each way is roughly 0.9 Hz, deliberately far below the 3 Hz
      photosensitivity ceiling, and it animates opacity only: nothing moves
      position, nothing resizes, and no text ever fades below 0.45.
    -->
    <Style x:Key="GuardPulseStyle" TargetType="Border">
      <Setter Property="Opacity" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AnimatePulse}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard Name="GuardPulseRun">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1.0"
                                 To="0.45"
                                 Duration="0:0:0.55"
                                 AutoReverse="True"
                                 RepeatBehavior="Forever"
                                 FillBehavior="Stop" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="GuardPulseRun" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GuardOptionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Margin" Value="0,0,0,5" />
