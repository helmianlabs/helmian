                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Local-service boundary" Style="{StaticResource SectionTitleStyle}" />
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}">
                    <TextBlock Text="READ-ONLY IMPLEMENTED" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
