                             Padding="10,8"
                             Margin="0,0,0,14"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource StrokeBrush}"
                             BorderThickness="1"
                             FontSize="13"
                             AutomationProperties.Name="Gemini API Key"
                             AutomationProperties.HelpText="Enter your Google Gemini API key" />

                <!-- xAI Grok API Key (not Groq) -->
                <TextBlock Text="XAI GROK API KEY (api.x.ai — starts with xai- ; not Groq gsk_)" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                <PasswordBox x:Name="GrokApiKeyInput"
                             Height="38"
                             Padding="10,8"
                             Margin="0,0,0,14"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource StrokeBrush}"
                             BorderThickness="1"
                             FontSize="13"
                             AutomationProperties.Name="xAI Grok API Key"
                             AutomationProperties.HelpText="Enter your xAI Grok API key from console.x.ai" />

                <!-- Database URL -->
