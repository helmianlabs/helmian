    </DataTemplate>

    <DataTemplate x:Key="GuardTabTemplate">
      <Button Tag="{Binding Name}"
              Click="GuardTab_Click"
              Margin="0,0,5,5"
              Padding="9,4"
              Cursor="Hand"
              BorderThickness="0"
              Background="Transparent">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TabChrome"
                    Background="{DynamicResource PanelSubtleBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource AccentPanelBrush}" />
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Label}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="11"
                     FontWeight="SemiBold" />
          <!-- Counts per level, so the tab strip is not a single opaque badge. -->
          <TextBlock Text="{Binding Criticals, StringFormat=✖{0}}"
                     Foreground="{StaticResource GuardCriticalBrush}"
                     FontSize="10"
                     FontWeight="Bold"
                     Margin="6,0,0,0"
                     Visibility="{Binding Criticals, Converter={StaticResource GuardZeroHides}}" />
          <TextBlock Text="{Binding Warnings, StringFormat=!{0}}"
                     Foreground="{StaticResource GuardWarningBrush}"
                     FontSize="10"
                     FontWeight="Bold"
                     Margin="5,0,0,0"
                     Visibility="{Binding Warnings, Converter={StaticResource GuardZeroHides}}" />
          <TextBlock Text="{Binding Unknowns, StringFormat=?{0}}"
                     Foreground="{StaticResource GuardUnknownBrush}"
                     FontSize="10"
                     FontWeight="Bold"
                     Margin="5,0,0,0"
                     Visibility="{Binding Unknowns, Converter={StaticResource GuardZeroHides}}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!--
      THE CARD. Dynamically sized: a one-line flag is compact, and a card carrying
      options grows to render them clickable inline (HasOptions drives both the
      detail's height cap and the options panel's visibility), so a decision can be
      answered from the panel without leaving the console.
    -->
    <DataTemplate x:Key="GuardCardTemplate">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8"
              Margin="0,0,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource GuardEdgeBarStyle}" Margin="0,0,8,0" />
          <StackPanel Grid.Column="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource GuardPulseStyle}">
                <Border Style="{StaticResource GuardChipStyle}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}"
                               Style="{StaticResource GuardChipTextStyle}"
                               Margin="0,0,4,0" />
                    <TextBlock Text="{Binding LevelText}"
                               Style="{StaticResource GuardChipTextStyle}" />
                  </StackPanel>
                </Border>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding OccurrenceText}"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="9"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="6,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="{Binding TimeText}"
                         Foreground="{DynamicResource FaintTextBrush}"
                         FontFamily="Consolas"
                         FontSize="9"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <Button Grid.Column="3"
                      Content="Ack"
                      Tag="{Binding}"
                      Click="GuardAcknowledge_Click"
                      Style="{StaticResource GuardOptionButtonStyle}"
                      Padding="7,2"
                      FontSize="9"
                      VerticalAlignment="Center"
                      ToolTip="Acknowledge — hides non-critical cards"
                      IsEnabled="{Binding IsAcknowledged, Converter={StaticResource GuardBoolInvert}}" />
            </Grid>
            <!-- Agent name first (multi-agent). -->
            <TextBlock Text="{Binding HeadlineText}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
            <TextBlock Text="{Binding OriginText}"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding StateText}"
                       Foreground="{DynamicResource SoftTextBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
            <!-- Compact: short detail; Expanded (options): full reason visible -->
            <TextBlock Text="{Binding Detail}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       MaxHeight="40"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Size}" Value="Expanded">
                      <Setter Property="MaxHeight" Value="200" />
                      <Setter Property="TextTrimming" Value="None" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Reason}"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="9"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Visibility="{Binding HasOptions, Converter={StaticResource GuardBoolHides}}" />
            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding HasOptions, Converter={StaticResource GuardBoolHides}}">
              <TextBlock Text="{Binding OptionsHeading}"
                         Foreground="{DynamicResource FaintTextBrush}"
                         FontSize="9"
                         FontWeight="Bold"
                         Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Options}"
                            Tag="{Binding}"
                            ItemTemplate="{StaticResource GuardOptionTemplate}" />
              <TextBlock Text="No handler for these options in this build."
                         Foreground="{StaticResource GuardWarningBrush}"
                         FontSize="9"
                         TextWrapping="Wrap"
                         Visibility="{Binding OptionsAreInert, Converter={StaticResource GuardBoolHides}}" />
            </StackPanel>
            <TextBlock Text="{Binding AcknowledgementText}"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="9"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsAcknowledged, Converter={StaticResource GuardBoolHides}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!-- TEXT SIZE. One transform, the whole shell.

         This is a LayoutTransform, not a RenderTransform, and the difference is
         the entire feature: a LayoutTransform is applied BEFORE measure, so the
         content is laid out against the scaled-down space and everything reflows
         and re-wraps. A RenderTransform would scale finished pixels and clip.

         WHY NOT A FontSize RESOURCE. There are 261 hardcoded FontSize literals in
         this file and none of them read a resource; the most common value is 10,
         used 99 times, which is smaller than WPF's own 12pt default. Routing all
         261 through a resource is 261 chances to miss one, and it still would not
         touch padding, icon boxes or fixed row heights — so the text would grow
         and the boxes around it would not. Scaling the shell moves all of it at
         once and cannot be partially applied.

         Driven by ApplyTextScale in MainWindow.xaml.cs. Ctrl+= / Ctrl+- / Ctrl+0,
         and the control on the Settings page. -->
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="AppScale" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="48" MinWidth="0" />
      <ColumnDefinition x:Name="SidebarContentSplitColDef" Width="10" />
      <ColumnDefinition x:Name="MainContentColumn" Width="*" MinWidth="280" />
      <ColumnDefinition x:Name="ContentGuardSplitColDef" Width="10" />
      <!-- Guard dock: MinWidth 0 so it can slide fully off to the right (Room-style). -->
      <ColumnDefinition x:Name="GuardPanelColumn" Width="360" MinWidth="0" MaxWidth="900" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="28" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu x:Name="ApplicationMenu"
          Grid.Row="0"
          Grid.ColumnSpan="5"
          Height="28"
          Padding="6,0"
          Panel.ZIndex="100"
          Background="{DynamicResource HeaderBrush}"
          Foreground="{DynamicResource TextBrush}"
          BorderBrush="{DynamicResource StrokeBrush}"
          BorderThickness="0,0,0,1"
          AutomationProperties.Name="Helmian application menu">
      <Menu.Resources>
        <!-- Popup MenuItems do not reliably inherit the dark surface from Menu.
             Without an explicit item surface Windows renders pale inherited text
             on its default popup, which makes a populated menu look empty. -->
        <!-- Override system menu chrome so popups are dark (no white Windows border). -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#12121A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F7F5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#0A0A0E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#12121A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F7F5" />
        <Style x:Key="ApplicationSubmenuItemStyle" TargetType="{x:Type MenuItem}">
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
          <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
          <Setter Property="Padding" Value="12,7" />
          <Setter Property="MinWidth" Value="210" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </Menu.Resources>
      <MenuItem Header="_File" ItemContainerStyle="{StaticResource ApplicationSubmenuItemStyle}">
        <MenuItem Header="_New Project" InputGestureText="Ctrl+N" Click="MenuNewProject_Click" />
        <MenuItem Header="_Open Project…" InputGestureText="Ctrl+O" Click="MenuOpenProject_Click" />
        <MenuItem x:Name="RecentProjectsMenu" Header="Open _Recent" SubmenuOpened="RecentProjectsMenu_SubmenuOpened"
                  ItemContainerStyle="{StaticResource ApplicationSubmenuItemStyle}">
          <MenuItem Header="No recent projects" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Click="MenuExit_Click" />
      </MenuItem>
      <MenuItem Header="_Edit" ItemContainerStyle="{StaticResource ApplicationSubmenuItemStyle}">
        <MenuItem Header="_Settings" InputGestureText="Ctrl+," Click="MenuSettings_Click" />
      </MenuItem>
      <MenuItem Header="_View" ItemContainerStyle="{StaticResource ApplicationSubmenuItemStyle}">
        <MenuItem x:Name="ViewSidebarMenuItem" Header="_Sidebar" InputGestureText="Ctrl+B" IsCheckable="True" IsChecked="True" Click="MenuToggleSidebar_Click" />
        <MenuItem x:Name="ViewDetailsMenuItem" Header="_Details" InputGestureText="Ctrl+Shift+D" IsCheckable="True" Click="MenuToggleDetails_Click" />
        <MenuItem x:Name="ViewBottomPanelMenuItem" Header="_Bottom Panel" InputGestureText="Ctrl+J" IsCheckable="True" Click="MenuToggleBottomPanel_Click" />
        <Separator />
        <MenuItem Header="_Browser" Click="MenuShowBrowser_Click" />
        <MenuItem Header="_Canvas" Click="MenuShowCanvas_Click" />
        <MenuItem Header="_Preview" Click="MenuShowPreview_Click" />
        <MenuItem Header="_Create" Click="MenuShowCreate_Click" />
        <Separator />
        <MenuItem Header="_Full Screen" InputGestureText="F11" Click="MenuFullScreen_Click" />
      </MenuItem>
      <MenuItem Header="_Help" ItemContainerStyle="{StaticResource ApplicationSubmenuItemStyle}">
        <MenuItem Header="_Documentation" Click="MenuDocumentation_Click" />
        <MenuItem Header="Keyboard _Shortcuts" Click="MenuShortcuts_Click" />
        <MenuItem Header="_What's New" Click="MenuWhatsNew_Click" />
        <Separator />
        <MenuItem Header="_Troubleshooting &amp; Status" Click="MenuTroubleshooting_Click" />
      </MenuItem>
    </Menu>

    <!-- Claude Desktop model (from Troy's 03.43 recording):
         Collapsed = only the top panel toggle (no full-height icon strip).
         Expanded (hover top toggle / pin) = full labeled sidebar you can click. -->
    <Border x:Name="SidebarChrome"
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource GlassPanelBrush}"
            BorderBrush="{DynamicResource GlassStrokeBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True"
            MouseEnter="SidebarChrome_MouseEnter"
            MouseLeave="SidebarChrome_MouseLeave">
      <Grid Margin="8,12,8,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP panel toggle — Claude's only chrome when collapsed -->
        <Border x:Name="SidebarHeaderHoverZone"
                Grid.Row="0"
                Margin="0,0,0,8"
                Background="Transparent"
                Padding="0"
                MouseEnter="SidebarHeaderHoverZone_MouseEnter">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SidebarRailGlyphButton"
                    Width="34"
                    Height="34"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Click="LeftPanelToggleButton_Click"
                    ToolTip="Open sidebar · click to pin"
                    Style="{StaticResource ConsoleNeutralButtonStyle}">
              <!-- Panel icon (Claude-style) -->
              <Border Width="16" Height="14"
                      BorderBrush="{DynamicResource SoftTextBrush}"
                      BorderThickness="1.5"
                      CornerRadius="2"
                      Background="Transparent">
                <Border Width="5" HorizontalAlignment="Left"
                        Background="{DynamicResource SoftTextBrush}"
                        Opacity="0.55"
                        Margin="0" />
              </Border>
            </Button>
            <StackPanel x:Name="SidebarBrandCopy"
                        Grid.Column="1"
                        Margin="10,1,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock Text="HELMIAN"
                         FontWeight="Bold"
                         FontSize="14" />
              <TextBlock Text="Desktop"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="10"
                         Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="LeftPanelCollapseButton"
                    Grid.Column="2"
                    Content="‹"
                    Width="26"
                    Height="26"
                    Margin="4,2,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Style="{StaticResource ShelfCompactButtonStyle}"
                    ToolTip="Collapse sidebar"
                    AutomationProperties.Name="Collapse sidebar"
                    Click="LeftPanelToggleButton_Click" />
          </Grid>
        </Border>

        <!-- Full labeled nav — hidden when collapsed (Claude: no side-icon strip) -->
        <ScrollViewer x:Name="SidebarExpandedBody"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      PanningMode="VerticalOnly"
                      AutomationProperties.Name="Helmian navigation"
                      AutomationProperties.HelpText="Full labeled sidebar when open.">
          <ScrollViewer.Resources>
            <!-- The navigation scrollbar is deliberately slim but visible. The
                 stock light Windows scrollbar looked detached from Midnight. -->
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="7" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" Width="7">
                      <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageUpCommand"
                                        Opacity="0"
                                        Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb>
                            <Thumb.Template>
                              <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ScrollThumb"
                                        Margin="1,1"
                                        Background="{DynamicResource MutedTextBrush}"
                                        CornerRadius="3"
                                        Opacity="0.55" />
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ScrollThumb" Property="Opacity" Value="0.85" />
                                  </Trigger>
                                  <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ScrollThumb" Property="Opacity" Value="1" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Thumb.Template>
                          </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageDownCommand"
                                        Opacity="0"
                                        Focusable="False" />
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel>
          <StackPanel Visibility="Collapsed">
          <!-- ─── PROJECTS ────────────────────────────────────────────────────
               The panel leads with the operator's work, not with the app's own
               pages. A project here is a folder `helmion project init` wrote:
               PROJECT.md at its root, with planning / sprints / docs / prompts
               beside it. The disk is the registry - there is no saved list to go
               stale when a folder is renamed outside the app. -->
          <Border Margin="6,0,6,8"
                  Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="PROJECTS"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="11"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
              <Button x:Name="NewProjectButton"
                      Grid.Column="1"
                      Content="+ New"
                      MinWidth="54"
                      Height="28"
                      Style="{StaticResource ShelfCompactButtonStyle}"
                      AutomationProperties.Name="New project"
                      ToolTip="Open the separate new-project name form. This does not filter or create anything until Create is pressed."
                      Click="NewProjectButton_Click" />
            </Grid>
          </Border>

          <!-- A dedicated creation surface. The project filter is never reused
               as a project name and + New itself performs no filesystem work. -->
          <Border x:Name="NewProjectPanel"
                  Margin="6,0,6,8"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource AccentStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Create a new project">
            <StackPanel>
              <TextBlock Text="NEW PROJECT"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="Project name"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="10"
                         Margin="0,7,0,4" />
              <Border Background="{DynamicResource PanelInsetBrush}"
                      BorderBrush="{DynamicResource StrokeBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <TextBox x:Name="NewProjectNameBox"
                         Padding="9,6"
                         Background="Transparent"
                         Foreground="{DynamicResource TextBrush}"
                         BorderThickness="0"
                         AutomationProperties.Name="New project name"
                         PreviewKeyDown="NewProjectNameBox_PreviewKeyDown" />
              </Border>
              <TextBlock x:Name="NewProjectValidationText"
                         Foreground="{DynamicResource AmberBrush}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="1,6,1,0"
                         Visibility="Collapsed"
                         AutomationProperties.LiveSetting="Assertive" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="0,9,0,0">
                <Button Content="Cancel"
                        MinWidth="58"
                        Margin="0,0,6,0"
                        Style="{StaticResource ShelfCompactButtonStyle}"
                        AutomationProperties.Name="Cancel new project"
                        Click="CancelNewProjectButton_Click" />
                <Button Content="Choose existing folder…"
                        MinWidth="132"
                        Margin="0,0,6,0"
                        Style="{StaticResource ShelfCompactButtonStyle}"
                        AutomationProperties.Name="Choose an existing project folder"
                        Click="ChooseExistingProjectButton_Click" />
                <Button Content="Create in Helmian Projects"
                        MinWidth="148"
                        Background="{DynamicResource AccentPanelBrush}"
                        BorderBrush="{DynamicResource AccentStrokeBrush}"
                        Style="{StaticResource ShelfCompactButtonStyle}"
                        AutomationProperties.Name="Create project"
                        Click="CreateProjectButton_Click" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Search. Every side panel worth copying has one and reaches it from
               the keyboard; Ctrl+K focuses this. It filters, it never hides a
               project permanently. -->
          <Border Margin="6,0,6,8"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid>
              <TextBox x:Name="ProjectSearchBox"
                       Padding="10,7"
                       FontSize="11"
                       Background="Transparent"
                       Foreground="{DynamicResource TextBrush}"
                       BorderThickness="0"
                       TextChanged="ProjectSearchBox_TextChanged"
                       ToolTip="Filter existing projects by name (Ctrl+K)"
                       AutomationProperties.Name="Filter projects by name" />
              <TextBlock Text="Filter projects by name"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="11"
                         IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=ProjectSearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

          <Border Margin="6,0,6,9"
                  Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="APPEARANCE"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <ComboBox x:Name="QuickThemeSelector"
                        Visibility="Collapsed"
                        Grid.Row="1"
                        Height="29"
                        Margin="0,6,0,0"
                        FontSize="10"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource ThemePickerStyle}"
                        SelectedValuePath="Id"
                        SelectionChanged="QuickThemeSelector_SelectionChanged"
                        ToolTip="Theme — choose a professional app appearance. Saved for this Windows user."
                        AutomationProperties.Name="Theme" />
            </Grid>
          </Border>

          <ItemsControl x:Name="ProjectShelfList" Margin="0,0,0,4" Loaded="ProjectShelfList_Loaded">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Button Click="ProjectShelfItem_Click"
                          Tag="{Binding Directory}"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding AccessibleName}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding PartsText}"
                                 FontSize="10"
                                 Margin="0,2,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource FaintTextBrush}" />
                    </StackPanel>
                  </Button>

                  <TextBlock Grid.Column="1"
                             Text="ACTIVE"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="9"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Margin="4,0,4,0"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <Button Grid.Column="2"
                          Click="ProjectPin_Click"
                          Tag="{Binding Slug}"
                          Content="{Binding PinGlyph}"
                          ToolTip="{Binding PinTooltip}"
                          VerticalAlignment="Top"
                          Margin="0,8,12,0"
                          Padding="4,0"
                          FontSize="13"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource FaintTextBrush}"
                          Cursor="Hand" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="ProjectShelfEmpty"
                     Margin="15,0,12,10"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Visibility="Collapsed"
                     Foreground="{DynamicResource FaintTextBrush}" />

          <!-- ─── SESSIONS ────────────────────────────────────────────────────
               Deliberately NOT a "New session" button. Sessions are started by
               the per-LLM pills under the composer, and a new one ADDS to what is
               running rather than replacing a chat.

               THE DOT IS REAL. Its colour comes from GuardFeed cards this session
               actually owns, read back by signature (MainWindow.Sessions.cs
               RefreshSessionDots) and evaluated by the SAME escalation rule as
               every other card — grey UNKNOWN until something has computed a
               state, and never green on no evidence. The level is also spelled
               out in words next to the name so the colour is never the only
               channel. -->
          <TextBlock Text="SESSIONS"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="10"
                     FontWeight="Bold"
                     Margin="15,6,0,6" />

          <ItemsControl x:Name="SessionShelfList" Loaded="SessionShelfList_Loaded">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,0,8,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- AutomationProperties.Name carries the session's name and its
                       level IN WORDS, because the row's own content is a panel of
                       TextBlocks and a coloured Ellipse — which a screen reader
                       reads as an unnamed button and a shape it cannot describe.
                       Without this the stoplight would be available to sighted
                       users only, which is the same failure as making colour the
                       only channel. -->
                  <Button Grid.Column="0"
                          Click="SessionShelfItem_Click"
                          Tag="{Binding Id}"
                          AutomationProperties.Name="{Binding AccessibleName}"
                          AutomationProperties.HelpText="{Binding DotTooltip}"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="7,5"
                          Cursor="Hand"
                          ToolTip="{Binding DotTooltip}">
                    <StackPanel Orientation="Horizontal">
                      <!-- The stoplight. Style triggers on LevelKey, the same keys
                           and the same brushes the guard cards use. -->
                      <Ellipse Width="9"
                               Height="9"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Style="{StaticResource SessionDotStyle}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12"
                                   FontWeight="{Binding RowWeight}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding SubtitleText}"
                                   FontSize="10"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource FaintTextBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1"
                          Click="SessionClose_Click"
                          Tag="{Binding Id}"
                          AutomationProperties.Name="{Binding CloseAccessibleName}"
                          Content="✕"
                          VerticalAlignment="Top"
                          Margin="0,6,4,0"
                          Padding="4,0"
                          FontSize="11"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource FaintTextBrush}"
                          Cursor="Hand"
                          ToolTip="Close this session. Its agent process is stopped and its guard cards are removed." />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="SessionShelfEmpty"
                     Margin="15,0,12,10"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource FaintTextBrush}"
                     Text="No sessions yet. Press one of the pills under the message box to start one." />

          </StackPanel>

          <!-- ─── CONSOLE. TOP LEVEL, NOT IN THE DRAWER. ──────────────────────
               Troy, 2026-07-30: "Get Console out of that dropdown menu and get it
               on the main side panel. That's the main part of the app."
               He is right, and the reasoning that buried it was wrong. The nine
               pages were treated as one undifferentiated group of "the app's own
               furniture", but Console is not furniture - it is the thing he opens
               the app to use. Making him expand a drawer to reach it every time is
               a tax on the only page that matters. -->
          <Button x:Name="ConsoleNavPrimary"
                  Tag="Console"
                  Content="▣   Team workspace"
                  Style="{StaticResource NavButtonStyle}"
                  Margin="0,6,0,2"
                  Click="Navigation_Click" />

          <!-- ─── PILOT, COLLAPSED ────────────────────────────────────────────
               The remaining pages are the app's own furniture, not the operator's
               work, so they sit behind one row that opens. Collapsed by default. -->
          <ToggleButton x:Name="PilotPagesToggle"
                        Margin="15,4,12,4"
                        FontSize="10"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Style="{StaticResource PilotMenuToggleStyle}"
                        Content="NAVIGATION"
                        Visibility="Collapsed"
                        ToolTip="Helmian navigation"
                        AutomationProperties.Name="Helmian navigation"
                        Checked="PilotPagesToggle_Changed"
                        Unchecked="PilotPagesToggle_Changed" />

          <Border x:Name="PilotPagesPanel"
                  Visibility="Visible"
                  Margin="15,0,12,5"
                  Padding="5"
                  Background="{DynamicResource PanelSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="11">
            <StackPanel>
              <Button x:Name="OverviewNav"
                      Tag="Overview"
                      Content="⌁   Overview"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <!-- Settings is intentionally near the top: preferences should not
                   be hidden below a long expanded drawer on shorter displays. -->
              <Button x:Name="SettingsNav"
                      Tag="Settings"
                      Content="⚙   Settings"
                      Style="{StaticResource PilotNavButtonStyle}"
                      ToolTip="Open Helmian appearance and local preferences"
                      AutomationProperties.Name="Settings"
                      Click="Navigation_Click" />
              <Button x:Name="WorkspaceNav"
                      Tag="Workspace"
                      Content="◇   Workspace"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <Button x:Name="CreateNav"
                      Content="＋   Create"
                      Style="{StaticResource PilotNavButtonStyle}"
                      ToolTip="Open the Create workbench"
                      Click="MenuShowCreate_Click" />
              <Button x:Name="ConsoleNav"
                      Tag="Console"
                      Content="▣   Console"
                      Visibility="Collapsed"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <Button x:Name="ActivityNav"
                      Tag="Activity"
                      Content="◫   Review &amp; History"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <Button x:Name="EvidenceNav"
                      Tag="Evidence"
                      Content="≡   Evidence"
                      Visibility="Collapsed"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <Button x:Name="ApprovalsNav"
                      Tag="Approvals"
                      Content="✓   Approvals"
                      Visibility="Collapsed"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
              <Button x:Name="IntegrationsNav"
                      Tag="Integrations"
                      Content="⌘   Connect"
                      Style="{StaticResource PilotNavButtonStyle}"
                      ToolTip="Integrations and team connectors"
                      Click="Navigation_Click" />
              <Button x:Name="AgentsNav"
                      Content="◎   Agents"
                      Style="{StaticResource PilotNavButtonStyle}"
                      ToolTip="Show or hide the agents panel on Console"
                      Click="AgentsDockToggleButton_Click" />
              <Button x:Name="GuardNav"
                      Content="⛨   Guard"
                      Style="{StaticResource PilotNavButtonStyle}"
                      ToolTip="Show or hide the Guard details panel"
                      Click="RightPanelToggleButton_Click" />
              <Button x:Name="ReleaseNav"
                      Tag="Release"
                      Content="↗   Release roadmap"
                      Visibility="Collapsed"
                      Style="{StaticResource PilotNavButtonStyle}"
                      Click="Navigation_Click" />
            </StackPanel>
          </Border>

          <Grid Margin="15,8,12,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="☀"
                       Foreground="#F59E0B"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       ToolTip="Appearance theme"
                       AutomationProperties.Name="Appearance theme" />
            <ComboBox x:Name="RailThemeSelector"
                      Visibility="Collapsed"
                      Grid.Column="1"
                      Height="28"
                      Margin="6,0,0,0"
                      FontSize="10"
                      Style="{StaticResource ThemePickerStyle}"
                      SelectedValuePath="Id"
                      SelectionChanged="RailThemeSelector_SelectionChanged"
                      ToolTip="Choose a theme. Saved for this Windows user."
                      AutomationProperties.Name="Theme" />
            <Button x:Name="ThemeCycleButton"
                    Grid.Column="1"
                    Height="28"
                    Margin="6,0,0,0"
                    Padding="10,3"
                    Content="Theme"
                    Click="ThemeCycleButton_Click"
                    Style="{StaticResource ShelfCompactButtonStyle}"
                    ToolTip="Cycle the supported themes. The visible button text is the current saved theme."
                    AutomationProperties.Name="Cycle appearance theme" />
          </Grid>
          </StackPanel>
        </ScrollViewer>

        <Button x:Name="SidebarStatusDotButton"
                Grid.Row="2"
                Width="28"
                Height="28"
                HorizontalAlignment="Left"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                Click="MenuTroubleshooting_Click"
                ToolTip="Status details">
          <Grid>
              <Ellipse x:Name="LocalServiceDot"
                       Width="8"
                       Height="8"
                       Fill="{DynamicResource FaintTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="LocalServiceSidebarStatus"
                       Text="Not connected"
                       Visibility="Collapsed" />
            <TextBlock x:Name="LocalServiceSidebarDetail"
                       Text="Active local host connection"
                       Visibility="Collapsed" />
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- Drag rail: sidebar ↔ main (left end of stage) -->
    <GridSplitter x:Name="SidebarContentSplitter"
                  Grid.Row="1"
                  Grid.Column="1"
                  Width="10"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Cursor="SizeWE"
                  ShowsPreview="True"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  ToolTip="Drag to resize sidebar and main">
      <GridSplitter.Template>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="#18000000" Cursor="SizeWE">
            <Border x:Name="Knob" Width="4" Height="56"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.45" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="FooterRow" Height="0" />
      </Grid.RowDefinitions>

      <Border x:Name="HeaderChrome"
              Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle"
                       Text="Overview"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="PageContext"
                       Text="Actions and recent results"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MenuTroubleshooting_Click"
                    ToolTip="Status details"
                    AutomationProperties.Name="Open status details">
              <Grid>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="GlobalDataBadgeText"
                           Text="LOCAL LIVE"
                           Visibility="Collapsed" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <!-- Overview -->
        <ScrollViewer x:Name="OverviewPage"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
          <Grid Margin="24,22,24,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="Project" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                  <TextBlock Text="{Binding Workspace.Name}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Choose a local project folder or create a new project."
                             Foreground="{DynamicResource MutedTextBrush}"
                             FontSize="11"
                             Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Open Project…"
                          Padding="12,7"
                          Margin="0,0,8,0"
                          Click="SelectWorkspace_Click"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          ToolTip="Choose a local project folder"
                          AutomationProperties.Name="Open project folder" />
                  <Button Content="New Project"
                          Padding="12,7"
                          Click="MenuNewProject_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          ToolTip="Create a project in the selected workspace"
                          AutomationProperties.Name="New project" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Recent actions" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Only recorded project activity appears here."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Review &amp; History"
                          Tag="Activity"
                          Click="Navigation_Click"
                          Padding="11,6"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          AutomationProperties.Name="Open Review and History" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RecentActivity}"
                              ItemTemplate="{StaticResource ActivityTemplate}"
                              Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Margin="30,26,30,34" Visibility="Collapsed">
            <Border CornerRadius="20"
                    BorderBrush="{DynamicResource AccentStrokeBrush}"
                    BorderThickness="1"
                    Padding="28">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource HeroStartColor}" Offset="0" />
                  <GradientStop Color="{DynamicResource HeroMiddleColor}" Offset="0.58" />
                  <GradientStop Color="{DynamicResource HeroEndColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20">
                  <Border Style="{StaticResource PillStyle}"
                          HorizontalAlignment="Left"
                          Background="{DynamicResource AccentDarkBrush}"
                          BorderBrush="{DynamicResource AccentStrokeStrongBrush}">
                    <TextBlock Text="HELMIAN"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="Your workspace, with guardrails."
                             FontSize="28"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Left"
                             Margin="0,17,0,0" />
                  <TextBlock Text="Routine bounded local work stays in motion. Execution safety is governed and enforced by local rules and policy."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             MaxWidth="680"
                             HorizontalAlignment="Left"
                             Margin="0,10,0,0" />
                  <Button Content="Open workspace  →"
                          Tag="Workspace"
                          Click="Navigation_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          HorizontalAlignment="Left"
                          Margin="0,22,0,0" />
                </StackPanel>
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource AccentStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="20">
                  <StackPanel>
                    <TextBlock Text="TODAY'S POSTURE"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Local guardrails" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <!-- 2026-07-29: was the literal "Ready" in accent green, with no
                           x:Name, so nothing could ever change it. Now driven from the
                           guard feed's headline level, and it reads "Unknown" in grey
                           until a detection layer has actually reported. -->
                      <TextBlock x:Name="OverviewGuardrailStateText"
                                 Grid.Column="1"
                                 Text="Unknown"
                                 Foreground="{StaticResource GuardUnknownBrush}"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Local service" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <TextBlock x:Name="OverviewServiceStateText"
                                 Grid.Column="1"
                                 Text="Offline"
                                 Foreground="{DynamicResource AmberBrush}"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Owner signing" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" />
                      <TextBlock Grid.Column="1" Text="Optional · off" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource AccentStrokeBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,17,0,0"
                            Padding="0,14,0,0">
                      <TextBlock x:Name="OverviewDataSourceText"
                                 Text="{Binding DataSourceLabel}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,18,0,0">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="WORKSPACES" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <!-- 2026-07-29: shipped reading "1" and "Helmion · local pilot"
                       before any workspace had been registered. Zero registered
                       workspaces now reads 0. -->
                  <TextBlock x:Name="WorkspaceCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="WorkspaceMetricDetail" Text="None registered yet" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="6,0">
                <StackPanel>
                  <TextBlock Text="LEASE POSTURE" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <!-- 2026-07-29: these two were crossed over — LeaseHolder held the
                       LABEL and LeaseState held the DETAIL — and painted in the accent
                       colour whatever the state was. They now show the real status
                       word from src/core/lease.mjs (ACTIVE / STALE / NONE / UNREADABLE
                       / UNKNOWN) and its detail, and the colour is set from the status
                       in ApplyLeasePosture. -->
                  <TextBlock x:Name="LeaseMetricText" Text="{Binding Workspace.LeaseStatusText}" Foreground="{StaticResource GuardUnknownBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="LeaseMetricDetail" Text="{Binding Workspace.LeaseDetail}" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <StackPanel>
                  <TextBlock Text="OPEN DECISIONS" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" FontWeight="Bold" />
                  <!-- 2026-07-29: was a hardcoded "0" with no x:Name under the claim
                       "Durable decision queue is active" — a count nothing could ever
                       update, over a queue that is not durable. Both now derived:
                       the number counts the approval queue plus unacknowledged guard
                       cards carrying options, and the caption states where it came
                       from. -->
                  <TextBlock x:Name="OpenDecisionsCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="OpenDecisionsDetailText" Text="Counted from the approval queue and the guard feed" Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recent evidence" Style="{StaticResource SectionTitleStyle}" />
                    <!-- 2026-07-29: was the literal "LIVE" in accent green over a list
                         that is empty until a workspace is inspected. Derived now. -->
                    <TextBlock x:Name="RecentEvidenceStateText"
                               Grid.Column="1"
                               Text="NO ROWS"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontWeight="Bold"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding RecentActivity}"
                                ItemTemplate="{StaticResource ActivityTemplate}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="Guardrail summary" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Policy is active even while live integrations are deferred."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,7,0,17" />
                  <Border Background="{DynamicResource AccentStrongBrush}" CornerRadius="11" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="LOW RISK · LOCAL" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Runs inside clear, bounded guardrails" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource WarningPanelBrush}" CornerRadius="11" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="HIGH RISK · EXTERNAL" Foreground="{DynamicResource AmberBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Requires a future explicit owner decision" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource PanelSubtleBrush}" CornerRadius="11" Padding="13">
                    <StackPanel>
                      <TextBlock Text="ADVISORS" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                      <TextBlock Text="Read-only evidence · never authority" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,30,0">
                  <TextBlock Text="Helmian Profile Package"
                             Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Planned portable bundle: base Policy Pack, reviewed learning, adapter mappings, task-specific profiles, optional templates, and a versioned manifest."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,8,0,0" />
                  <TextBlock Text="Each item gets a plain-English impact/dependency/safety card and its own toggle. Task profiles inherit base safety. No source folder has been scanned."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource PillStyle}"
                        VerticalAlignment="Top">
                  <TextBlock Text="PORTABLE BUNDLE"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Workspace -->
        <ScrollViewer x:Name="WorkspacePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="WorkspacePageTitle"
                           Text="{Binding Workspace.Name}"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspacePagePath"
                           Text="{Binding Workspace.RootPath}"
                           Style="{StaticResource MutedStyle}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource PillStyle}" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningStrokeBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceSourceBadgeText"
                           Text="OFFLINE"
                           Foreground="{DynamicResource AmberBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0">
                  <TextBlock x:Name="WorkspaceConnectionSummary"
                             Text="No active connection"
                             Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock x:Name="WorkspaceConnectionDetail"
                             Text="Connect the current-user read-only service, then choose a local project folder."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <Button x:Name="ConnectServiceButton"
                          Content="Connect local service"
                          Click="ConnectService_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Connect Helmion local service" />
                  <Button x:Name="SelectWorkspaceButton"
                          Content="Choose workspace"
                          Click="SelectWorkspace_Click"
                          IsEnabled="True"
                          Cursor="Hand"
                          Margin="10,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Choose a local project workspace"
                          ToolTip="Opens a folder picker immediately — does not wait on the local service" />
                  <Button x:Name="RefreshWorkspaceButton"
                          Content="Refresh"
                          Click="RefreshWorkspace_Click"
                          IsEnabled="True"
                          Cursor="Hand"
                          Margin="10,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          AutomationProperties.Name="Refresh the selected workspace inventory" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <TextBlock Text="Project workspace" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Branch" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceBranchText"
                               Grid.Column="1"
                               Text="{Binding Workspace.Branch}" />
                  </Grid>
                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Data source" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceDataSourceText"
                               Grid.Column="1"
                               Text="Unconfigured"
                               Foreground="{DynamicResource SoftTextBrush}" />
                  </Grid>
                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Next safe action" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="WorkspaceNextActionText"
                               Grid.Column="1"
                               Text="{Binding Workspace.NextAction}"
                               TextWrapping="Wrap" />
                  </Grid>
                  <Border Background="{DynamicResource PanelSubtleBrush}" CornerRadius="11" Padding="14" Margin="0,20,0,0">
                    <TextBlock Text="The authenticated local service inventories selected source files read-only. It does not start agents, query Neon, or mutate project state."
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lease status" Style="{StaticResource SectionTitleStyle}" />
                    <!-- 2026-07-29: this dot was a hardcoded accent-green Ellipse with
                         no x:Name, sitting beside a lease status that was itself a
                         hardcoded "UNAVAILABLE". It said "healthy" no matter what. Now
                         named, driven from the real status, and followed by the status
                         WORD so the dot is never the only signal. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="WorkspaceLeaseDot"
                               Width="9"
                               Height="9"
                               Fill="{StaticResource GuardUnknownBrush}"
                               VerticalAlignment="Center" />
                      <TextBlock x:Name="WorkspaceLeaseStatusWordText"
                                 Text="UNKNOWN"
                                 Foreground="{StaticResource GuardUnknownBrush}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Margin="6,0,0,0" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="WorkspaceLeaseStateText"
                             Text="{Binding Workspace.LeaseLabel}"
                             Foreground="{StaticResource GuardUnknownBrush}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Margin="0,20,0,0" />
                  <TextBlock x:Name="WorkspaceLeaseDetailText"
                             Text="{Binding Workspace.LeaseDetail}"
                             Style="{StaticResource MutedStyle}"
                             Margin="0,5,0,0" />
                  <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,17,0,0">
                    <StackPanel>
                      <TextBlock Text="Lease invariant" Foreground="{DynamicResource SoftTextBrush}" FontWeight="SemiBold" />
                      <!-- 2026-07-29: this said the state was reported as "unavailable"
                           because no durable provider was connected. That is no longer
                           what happens: src/core/lease.mjs enforces the invariant with
                           an exclusive-create file lease at
                           <workspace>\.helmion\lease.json, and LeaseInspector reads it. -->
                      <TextBlock x:Name="WorkspaceLeaseInvariantText"
                                 Text="At most one active writer per project, enforced locally by an exclusive-create lease file at .helmion\lease.json. Four states are reported and none is inferred: ACTIVE, STALE, NONE, and UNREADABLE. UNREADABLE is never shown as NONE — a lease that cannot be read may still be held."
                                 Style="{StaticResource MutedStyle}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Migration source inventory"
                               Style="{StaticResource SectionTitleStyle}"
                               ToolTip="Migration source inventory"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MigrationInventoryState"
                               Grid.Row="1"
                               Text="No workspace loaded"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                  </Grid>
                  <TextBlock x:Name="EmptyMigrationMessage"
                             Text="Choose a workspace to inventory local checksummed SQL sources."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,16,0,0" />
                  <ItemsControl x:Name="MigrationInventoryList"
                                ItemTemplate="{StaticResource MigrationInventoryTemplate}"
                                Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Evidence source inventory" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="EvidenceInventoryState"
                               Grid.Column="1"
                               Text="No workspace loaded"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock x:Name="EmptyEvidenceMessage"
                             Text="Choose a workspace to inventory local evidence sources."
                             Style="{StaticResource MutedStyle}"
                             Margin="0,16,0,0" />
                  <ItemsControl x:Name="EvidenceInventoryList"
                                ItemTemplate="{StaticResource EvidenceInventoryTemplate}"
                                Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Workspace flow" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Grid.Column="1" Text="READ-ONLY SLICE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                </Grid>
                <Grid Margin="0,24,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="1 · Observe" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Read project, lease, policy, and evidence state." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="2 · Evaluate" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Classify risk and enforce deterministic guardrails." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="3" Text="→" Foreground="{DynamicResource FaintTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Column="4" Background="{DynamicResource AccentPanelBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                      <TextBlock Text="3 · Evidence" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Text="Record checkpoint and acknowledged outcome." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Combined desk: Room | Maestro | Agents. Main app sidebar (left) is the only nav rail. -->
        <Grid x:Name="ConsolePage" Visibility="Collapsed" Margin="0"
              Background="{DynamicResource CanvasBrush}">
          <!-- Star widths so GridSplitters can actually drag (fixed+* often sticks). -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TeamColumnDef" Width="1.15*" MinWidth="0" />
            <ColumnDefinition x:Name="TeamMaestroSplitColDef" Width="10" />
            <ColumnDefinition x:Name="MaestroColumnDef" Width="2*" MinWidth="320" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition x:Name="AgentsColumnDef" Width="0" MinWidth="0" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Restore strip when Room is fully collapsed (Discord / Team). -->
          <Button x:Name="TeamDockRestoreButton"
                  Grid.Row="0"
                  Grid.Column="0"
                  Content="Room"
                  Width="28"
                  Margin="4,12,0,12"
                  Padding="0,8"
                  FontSize="10"
                  FontWeight="Bold"
                  Visibility="Collapsed"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Left"
                  Click="TeamDockCollapseButton_Click"
                  ToolTip="Open Room / Discord panel"
                  Style="{StaticResource ConsoleNeutralButtonStyle}"
                  Panel.ZIndex="5">
            <Button.LayoutTransform>
              <RotateTransform Angle="-90" />
            </Button.LayoutTransform>
          </Button>

          <!-- Helmian Room — glass theme, not a fake Discord clone.
               Real Discord loads in WebView when you click Discord (not this chrome). -->
          <Border x:Name="TeamDockBorder"
                  Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,8,0,8"
                  CornerRadius="14"
                  Background="{DynamicResource GlassPanelBrush}"
                  BorderBrush="{DynamicResource GlassStrokeBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TeamRoomThreadRowDef" Height="2.2*" MinHeight="100" />
                <RowDefinition Height="10" />
                <RowDefinition x:Name="TeamRoomComposeRowDef" Height="*" MinHeight="96" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Background="{DynamicResource GlassRaisedBrush}"
                      BorderBrush="{DynamicResource GlassStrokeBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ROOM"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="TeamRoomSubtitle"
                               Text="Project talk"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PanelInsetBrush}"
                            CornerRadius="10"
                            Padding="10,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                      <TextBlock x:Name="TeamConnectBadgeText"
                                 Text="NOT CONNECTED"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="9"
                                 FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                  <Button x:Name="TeamDockCollapseButton"
                          Grid.Column="1"
                          Content="⟨"
                          Width="28"
                          Height="28"
                          Padding="0"
                          FontSize="14"
                          Click="TeamDockCollapseButton_Click"
                          ToolTip="Collapse room"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0" x:Name="TeamRoomSplitGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="TeamSourcesColumnDef" Width="*" MinWidth="160" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition x:Name="TeamThreadColumnDef" Width="1.4*" MinWidth="160" />
                </Grid.ColumnDefinitions>

                <!-- Sources: filter + servers/repos + channels -->
                <Grid Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="10,10,10,6">
                    <Button x:Name="TeamFilterAllButton"
                            Content="All"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            FontSize="11"
                            Click="TeamFilterAllButton_Click"
                            ToolTip="All sources"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Button x:Name="TeamFilterDiscordButton"
                            Content="Discord"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            FontSize="11"
                            Click="TeamFilterDiscordButton_Click"
                            ToolTip="Open live Discord in Room (real web UI)"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Button x:Name="TeamFilterGitHubButton"
                            Content="GitHub"
                            Padding="10,5"
                            FontSize="11"
                            Click="TeamFilterGitHubButton_Click"
                            ToolTip="Filter GitHub sources"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  </StackPanel>
                  <DockPanel Grid.Row="1" Margin="8,0,8,4" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="SOURCES"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="4,0,0,4" />
                    <ListBox x:Name="TeamScopeBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             DisplayMemberPath="PickerLabel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TeamScopeBox_SelectionChanged"
                             AutomationProperties.Name="Servers and repositories" />
                  </DockPanel>
                  <DockPanel Grid.Row="3" Margin="8,0,8,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="CHANNELS / ISSUES"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="4,0,0,4" />
                    <ListBox x:Name="TeamChannelBox"
                             DisplayMemberPath="PickerLabel"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource SoftTextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TeamChannelBox_SelectionChanged"
                             AutomationProperties.Name="Channels and issues"
                             ToolTip="Channels or issues" />
                  </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeWE"
                              ShowsPreview="True"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize sources and chat">
                  <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                      <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeWE">
                        <Border Width="3" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                      </Border>
                    </ControlTemplate>
                  </GridSplitter.Template>
                </GridSplitter>

                <Grid Grid.Column="2" Background="{DynamicResource PanelSubtleBrush}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Padding="8,10">
                    <StackPanel>
                      <Border x:Name="TeamMessageEmptyCard"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="12,16"
                              Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock x:Name="TeamMessageEmptyTitle"
                                     Text="Room is ready"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontSize="16"
                                     FontWeight="SemiBold" />
                          <TextBlock x:Name="TeamMessageEmptyBody"
                                     Text="Connect a source, pick a server or repo, then a channel. Or press Discord for the live Discord app in this panel."
                                     Foreground="{DynamicResource SoftTextBrush}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                      </Border>
                      <ItemsControl x:Name="TeamMessageList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="40" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32"
                                        CornerRadius="16"
                                        Background="{DynamicResource AccentPanelBrush}"
                                        VerticalAlignment="Top">
                                  <TextBlock Text="{Binding AuthorInitials}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AuthorDisplayLabel}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding TimeLabel}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProviderLabel}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding Body}"
                                             Foreground="{DynamicResource SoftTextBrush}"
                                             TextWrapping="Wrap"
                                             FontSize="13"
                                             Margin="0,4,0,0" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>

              <GridSplitter Grid.Row="2"
                            Height="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Cursor="SizeNS"
                            ShowsPreview="True"
                            ResizeDirection="Rows"
                            ResizeBehavior="PreviousAndNext"
                            ToolTip="Drag to resize chat and compose">
                <GridSplitter.Template>
                  <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeNS">
                      <Border Width="48" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                              CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                    </Border>
                  </ControlTemplate>
                </GridSplitter.Template>
              </GridSplitter>

              <Border Grid.Row="3"
                      Background="{DynamicResource GlassRaisedBrush}"
                      Padding="12,10,12,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="44" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Background="{DynamicResource PanelInsetBrush}"
                          BorderBrush="{DynamicResource StrokeBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          MinHeight="44"
                          Padding="4,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid>
                        <TextBlock x:Name="TeamRoomComposePlaceholder"
                                   Text="Message the room…"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   FontSize="13"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="TeamRoomComposeBox"
                                 MinHeight="40"
                                 Padding="12,10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Message the room — Enter to send"
                                 TextChanged="TeamRoomComposeBox_TextChanged"
                                 PreviewKeyDown="TeamRoomComposeBox_PreviewKeyDown" />
                      </Grid>
                      <Button x:Name="TeamRoomSendButton"
                              Grid.Column="1"
                              Content="Send"
                              MinWidth="64"
                              Height="32"
                              Margin="4,0,8,0"
                              Padding="12,0"
                              FontSize="12"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Click="TeamRoomSendButton_Click"
                              ToolTip="Send (Enter)"
                              Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                  </Border>
                  <TextBlock x:Name="TeamConnectionStatusText" Visibility="Collapsed" Height="0" />
                  <TextBlock x:Name="TeamConnectionSetupText" Visibility="Collapsed" Height="0" />
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Discord"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="ConnectDiscordFuture_Click"
                            ToolTip="Open live Discord in this Room panel"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="GitHub"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="ConnectGitHubFuture_Click"
                            ToolTip="Connect GitHub"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Button Content="Slack"
                            Padding="12,6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="ConnectSlackFuture_Click"
                            ToolTip="Connect Slack"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Live Discord web app (WebView2) — shown when Discord button is clicked -->
              <Grid x:Name="TeamDiscordWebHost"
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Visibility="Collapsed"
                    Panel.ZIndex="20"
                    Background="#1E1F22">
                <wv2:WebView2 x:Name="TeamDiscordWebView"
                              DefaultBackgroundColor="#1E1F22" />
                <Button x:Name="TeamDiscordCloseButton"
                        Content="← Room"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,12,0"
                        Padding="12,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Click="TeamDiscordCloseButton_Click"
                        ToolTip="Close Discord web UI and return to Helmian Room"
                        Background="#313338"
                        Foreground="#F2F3F5"
                        BorderBrush="#5865F2"
                        BorderThickness="1"
                        Cursor="Hand"
                        Panel.ZIndex="21" />
                <TextBlock x:Name="TeamDiscordStatusText"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#B5BAC1"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="24"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
              </Grid>
            </Grid>
          </Border>

          <GridSplitter x:Name="TeamMaestroSplitter"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#22000000"
                        Cursor="SizeWE"
                        ShowsPreview="True"
                        ResizeDirection="Columns"
                        ResizeBehavior="PreviousAndNext"
                        ToolTip="Drag to resize Room and Maestro">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="#22000000" Cursor="SizeWE">
                  <Border x:Name="Knob"
                          Width="4" Height="56"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          CornerRadius="2"
                          Background="{DynamicResource AccentBrush}"
                          Opacity="0.5" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Knob" Property="Opacity" Value="1" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>

          <!-- Maestro conversation stage -->
          <Border x:Name="MaestroDockBorder"
                  Grid.Row="0"
                  Grid.Column="2"
                  Margin="0,12,0,12"
                  CornerRadius="14"
                  Background="{DynamicResource GlassPanelBrush}"
                  BorderBrush="{DynamicResource GlassStrokeBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0 title bar -->
                <RowDefinition Height="Auto" />
                <!-- 1 sandbox status and route -->
                <RowDefinition Height="*" />
                <!-- 2 transcript -->
                <RowDefinition Height="Auto" />
                <!-- 3 status strip -->
                <RowDefinition Height="Auto" />
                <!-- 4 MCP install security (collapsed until asked for) -->
                <RowDefinition Height="Auto" />
                <!-- 5 approval strip -->
                <RowDefinition Height="Auto" />
                <!-- 6 input dock -->
              </Grid.RowDefinitions>

              <!-- Terminal title bar -->
              <Border Grid.Row="0"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource StrokeBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="16,10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MAESTRO"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <TextBlock Text="Conversation"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="  ›  "
                               Visibility="Collapsed"
                               Foreground="#3D5566"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="terminal"
                               Visibility="Collapsed"
                               Foreground="#8FB4C9"
                               FontFamily="Consolas"
                               FontSize="11" />
                  </StackPanel>
                  <!-- The command/status strip wraps beneath the terminal label.
                       A fixed Auto column used to squeeze HELMIAN away and crop
                       Full screen at ordinary recording widths. -->
                  <WrapPanel Grid.Row="1"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center">
                    <Border x:Name="ConsolePermissionIndicator"
                            Visibility="Visible"
                            Style="{StaticResource PillStyle}"
                            Background="{DynamicResource GlassRaisedBrush}"
                            BorderBrush="{DynamicResource GlassStrokeBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,6"
                            Cursor="Hand">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ConsoleExecutionBadgeText"
                                   Text="Plan"
                                   Foreground="{DynamicResource AmberBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ConsolePermissionInfoButton"
                                Content="ⓘ"
                                Margin="5,0,0,0"
                                Padding="2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource SoftTextBrush}"
                                FontSize="11"
                                Cursor="Hand"
                                Click="ConsolePermissionInfoButton_Click"
                                ToolTip="Access details and permission modes" />
                      </StackPanel>
                    </Border>
                    <Popup x:Name="ConsolePermissionPopup"
                           PlacementTarget="{Binding ElementName=ConsolePermissionIndicator}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                      <Border Background="#101A22"
                              BorderBrush="#3A5568"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="14"
                              Width="330">
                        <StackPanel>
                          <TextBlock Text="Access"
                                     Foreground="#F2FBFF"
                                     FontSize="13"
                                     FontWeight="SemiBold" />
                          <TextBlock x:Name="ConsolePermissionInfoText"
                                     Margin="0,4,0,10"
                                     Foreground="#9FB6C6"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                          <ComboBox x:Name="ConsolePermissionCombo"
                                    Height="30"
                                    FontSize="12"
                                    SelectedIndex="0"
                                    SelectionChanged="ConsolePermissionCombo_SelectionChanged">
                            <ComboBoxItem Content="Plan — read-only chat" Tag="read-only" />
                            <ComboBoxItem Content="Read — workspace tools only" Tag="read-tools" />
                            <ComboBoxItem Content="Accept — ask before each action" Tag="ask" />
                            <ComboBoxItem Content="Full — workspace actions (no ask)" Tag="full" />
                          </ComboBox>
                        </StackPanel>
                      </Border>
                    </Popup>
                    <TextBlock x:Name="ConsoleWorkspaceLabel"
                               Visibility="Visible"
                               Text="SCOPED FOLDER · resolving…"
                               Foreground="#8AA0B0"
                               FontSize="10"
                               FontFamily="Consolas"
                               Margin="0,0,14,6"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               AutomationProperties.Name="Current agent scoped folder"
                               AutomationProperties.HelpText="Shows the selected folder and whether the active agent bridge confirmed it."
                               ToolTip="Agent tools (read/write/run) are limited to this folder. Change it on the Workspace page." />
                    <!-- Which model actually answered, and which tier the router put it in.
                         Filled from the bridge's "model" event; stays "—" until one arrives. -->
                    <TextBlock x:Name="ConsoleModelLabel"
                               Visibility="Visible"
                               Text="model: —"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontFamily="Consolas"
                               Margin="0,0,14,6"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"
                               ToolTip="The model the per-task router chose for the last turn." />
                    <Button x:Name="ConsoleCommandsButton"
                            Visibility="Collapsed"
                            Content="Commands"
                            Height="22"
                            Padding="10,0"
                            Margin="0,0,8,6"
                            FontSize="10"
                            Click="ConsoleCommandsButton_Click"
                            ToolTip="List the slash commands available in this workspace."
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                     <Button x:Name="ConsoleMcpSecurityButton"
                             Visibility="Collapsed"
                             Content="MCP Security"
                            Height="22"
                            Padding="10,0"
                            Margin="0,0,12,6"
                            FontSize="10"
                             Click="ConsoleMcpSecurityButton_Click"
                              ToolTip="Read-only discovery and source audit. This interface cannot install an MCP server."
                             Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Button x:Name="ConsoleFullScreenButton"
                            Content="⛶"
                            Height="22"
                            Width="28"
                            Padding="0"
                            Margin="0,0,10,6"
                            Click="ConsoleFullScreenButton_Click"
                            ToolTip="Enter full-screen Console (F11). Press Escape or F11 to return."
                            AutomationProperties.Name="Full screen (F11)"
                            AutomationProperties.HelpText="Press F11 to enter full screen. Press Escape or F11 to return."
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,0,6"
                             ToolTip="Ready. Open Troubleshooting &amp; Status for details." />
                    <TextBlock x:Name="ConsoleLiveLabel"
                               Text="LIVE"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Margin="0,0,0,6" />
                  </WrapPanel>
                </Grid>
              </Border>

              <!-- Compact summary only. This button navigates to the existing
                   Integrations workflow; it never scans, installs, or launches. -->
              <Border Grid.Row="1"
                      Visibility="Collapsed"
                      Background="#101820"
                      BorderBrush="#293743"
                      BorderThickness="0,0,0,1"
                      Padding="16,9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#18232C"
                          BorderBrush="#34434E"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,4"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="ConsoleSandboxStatusBadge"
                               Text="NOT READY"
                               Foreground="#AEB9C1"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9.5"
                               FontWeight="Bold" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ConsoleSandboxStatusTitle"
                               Text="Sandbox status unavailable"
                               Foreground="#D7E0E6"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ConsoleSandboxStatusDetail"
                               Text="Review the detailed readiness flow before any setup."
                               Foreground="#8999A5"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Content="Review sandbox options"
                          Padding="12,5"
                          VerticalAlignment="Center"
                          Click="ReviewSandboxOptionsButton_Click"
                          ToolTip="Open Integrations details. This does not scan, install, launch, enable a feature, or change Windows."
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
              </Border>

              <!-- Output (selectable) -->
              <TextBox x:Name="ConsoleOutputText"
                       Grid.Row="2"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Foreground="{DynamicResource TextBrush}"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="18,14"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       IsReadOnlyCaretVisible="True"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       SpellCheck.IsEnabled="False"
                       CaretBrush="{DynamicResource TextBrush}"
                       SelectionBrush="{DynamicResource AccentDarkBrush}" />

              <!-- Status strip -->
              <Border Grid.Row="3"
                      Visibility="Collapsed"
                      Background="#0E171F"
                      BorderBrush="#1A2834"
                      BorderThickness="0,1,0,0"
                      Padding="16,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                   <TextBlock x:Name="ConsoleServiceSessionText"
                              Text=""
                             Foreground="#8AA0B0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Which voice backend the selector actually resolved to.
                       Not a claim that voice is on — that is what it SAYS. -->
                  <TextBlock x:Name="ConsoleVoiceBackendLabel"
                             Grid.Column="1"
                             Text="voice: off"
                             Foreground="#8AA0B0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Margin="14,0,0,0"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="360"
                             ToolTip="Local speech only: Whisper STT + Kokoro TTS. Moshi is not used." />
                  <Button x:Name="ConsoleClearOutputButton"
                          Grid.Column="2"
                          Content="Clear output"
                          Height="22"
                          Padding="10,0"
                          Margin="12,0,0,0"
                          FontSize="10"
                          Click="ConsoleClearOutputButton_Click"
                          ToolTip="Clear only the displayed terminal history. Conversation state, access, settings, and workspace stay unchanged."
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
              </Border>

              <!-- MCP install security — stages 1 and 2 only. Approval is deliberately
                   absent: it requires a real terminal and a typed challenge phrase. -->
              <Border x:Name="ConsoleMcpPanel"
                      Grid.Row="4"
                      Visibility="Collapsed"
                      Background="#0C1A16"
                      BorderBrush="#1F4A3C"
                      BorderThickness="0,1,0,1"
                      Padding="16,10">
                <StackPanel>
                  <TextBlock Text="MCP SECURITY · READ-ONLY"
                             Foreground="#5FD3A8"
                             FontSize="10"
                             FontWeight="Bold"
                             Margin="0,0,0,6" />
                  <TextBlock Text="This interface never approves, sandboxes, or installs. Discover searches for candidates; Browse selects a local source folder; Audit reads that folder and reports what the code can do. Results print in the console above."
                             Foreground="#9FBDB2"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8" />

                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- MinHeight, never Height. PrimaryButtonStyle carries
                         Padding="16,10" (line 90); 20px of vertical padding plus a
                         12pt line does not fit in 30px, so a fixed Height cropped
                         every label here. The console buttons above escape it by
                         overriding Padding to "10,0" — these did not. MinHeight
                         keeps the row looking the same at 100% and lets it grow
                         with the text scale instead of clipping. -->
                    <TextBox x:Name="McpDiscoverNeedInput"
                             MinHeight="30"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#08120F"
                             Foreground="#E8F6F1"
                             CaretBrush="#5FD3A8"
                             BorderBrush="#1F4A3C"
                             BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             ToolTip="What do you need the server to do? e.g. read local sqlite" />
                    <Button x:Name="McpDiscoverButton"
                            Grid.Column="1"
                            Content="1 · Discover"
                            MinHeight="30"
                            Padding="14,4"
                            Margin="8,0,0,0"
                            Click="McpDiscoverButton_Click"
                            ToolTip="Stage 1 — search GitHub for candidates. Installs nothing."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="McpAuditPathInput"
                             MinHeight="30"
                             MinWidth="60"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#08120F"
                             Foreground="#E8F6F1"
                             CaretBrush="#5FD3A8"
                             BorderBrush="#1F4A3C"
                             BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             ToolTip="Folder holding the candidate server's source code." />
                    <!-- No MinWidth on either button: the label decides the width,
                         so it cannot be cropped by a number set before anyone knew
                         what font size the label would be drawn at. -->
                    <Button x:Name="McpBrowseButton"
                            Grid.Column="1"
                            Content="Browse…"
                            MinHeight="30"
                            Padding="14,4"
                            Margin="8,0,0,0"
                            Click="McpBrowseButton_Click"
                            ToolTip="Pick the folder to audit."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="McpAuditButton"
                            Grid.Column="2"
                            Content="2 · Audit"
                            MinHeight="30"
                            Padding="14,4"
                            Margin="8,0,0,0"
                            Click="McpAuditButton_Click"
                            ToolTip="Stage 2 — read every source file. No network, no execution."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </Grid>

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Find in last audit"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="#9FBDB2"
                               FontSize="11" />
                    <TextBox x:Name="McpAuditSearchInput"
                             Grid.Column="1"
                             Text="secret / token access"
                             MinHeight="30"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             Background="#08120F"
                             Foreground="#E8F6F1"
                             CaretBrush="#5FD3A8"
                             BorderBrush="#1F4A3C"
                             BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             ToolTip="Searches the most recent static-audit findings. ‘Secret / token access’ means credential and environment access; it is not a model-token usage metric." />
                    <Button x:Name="McpAuditSearchButton"
                            Grid.Column="2"
                            Content="Find"
                            MinHeight="30"
                            Padding="14,4"
                            Margin="8,0,0,0"
                            Click="McpAuditSearchButton_Click"
                            ToolTip="Search the findings from the most recent Audit. No files or network are touched."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </Grid>

                  <TextBlock Text="Approval, sandboxing, and installation are not available in this panel. Opening, browsing, searching, auditing, or leaving it does not change your MCP setup."
                             Foreground="#C9A227"
                             FontSize="10.5"
                             TextWrapping="Wrap"
                             Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <!-- Approval prompt — visible only while ask mode is waiting on you -->
              <Border x:Name="ConsoleApprovalPanel"
                      Grid.Row="5"
                      Visibility="Collapsed"
                      Background="#1C1608"
                      BorderBrush="{DynamicResource AmberBrush}"
                      BorderThickness="0,1,0,1"
                      Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="ConsoleApprovalTitleText"
                               Text="APPROVAL NEEDED"
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,3" />
                    <TextBlock x:Name="ConsoleApprovalSummaryText"
                               Text=""
                               Foreground="#F2E4C4"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ConsoleApprovalDetailText"
                               Text=""
                               Foreground="#B7A88A"
                               FontSize="10.5"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <Button x:Name="ConsoleApprovalAllowOnceButton"
                            Content="Allow once"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Click="ConsoleApprovalAllowOnce_Click"
                            ToolTip="Run this one call. The next call asks again."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="ConsoleApprovalAllowSessionButton"
                            Content="Allow for session"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Click="ConsoleApprovalAllowSession_Click"
                            ToolTip="Stop asking about THIS tool until you change permissions or reset."
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="ConsoleApprovalDenyButton"
                            Content="Deny"
                            Height="32"
                            Padding="18,0"
                            Click="ConsoleApprovalDeny_Click"
                            ToolTip="Refuse this call. Nothing runs."
                            Style="{StaticResource PrimaryButtonStyle}" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Input dock -->
              <Border Grid.Row="6"
                      Background="{DynamicResource GlassRaisedBrush}"
                      BorderBrush="{DynamicResource GlassStrokeBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="12">
                <StackPanel>
                  <!-- The state rows. Every + action shows one of four states
                       here and never disappears silently: Connecting…, Added,
                       Failed with the reason, or Removed with an Undo. -->
                  <ItemsControl x:Name="ConsolePlusRows"
                                Loaded="ConsolePlusRows_Loaded"
                                Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="10,7"
                                CornerRadius="8"
                                Background="#0A1218"
                                BorderThickness="1"
                                BorderBrush="{Binding StateKey, Converter={StaticResource PlusStateBrush}}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Entry.Icon}"
                                       FontSize="15"
                                       Width="26"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding StateKey, Converter={StaticResource PlusStateBrush}}" />

                            <StackPanel Grid.Column="1">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#F2FBFF" />
                                <TextBlock Text="{Binding StateText}"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{Binding StateKey, Converter={StaticResource PlusStateBrush}}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Message}"
                                         FontSize="12"
                                         Margin="0,2,0,0"
                                         TextWrapping="Wrap"
                                         Foreground="#9FB6C6" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="Remove"
                                      Click="ConsolePlusRemove_Click"
                                      Margin="6,0,0,0"
                                      Padding="8,4"
                                      FontSize="11"
                                      Background="Transparent"
                                      BorderBrush="#3A5568"
                                      BorderThickness="1"
                                      Foreground="#9FB6C6"
                                      Cursor="Hand"
                                      Visibility="{Binding CanRemove, Converter={StaticResource GuardBoolHides}}" />
                              <Button Content="Undo"
                                      Click="ConsolePlusUndo_Click"
                                      Margin="6,0,0,0"
                                      Padding="8,4"
                                      FontSize="11"
                                      Background="Transparent"
                                      BorderBrush="#7FE3FF"
                                      BorderThickness="1"
                                      Foreground="#7FE3FF"
                                      Cursor="Hand"
                                      Visibility="{Binding CanUndo, Converter={StaticResource GuardBoolHides}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                <!-- Claude Code CLI composer: mode line · > prompt · workspace -->
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                    <TextBlock x:Name="ClaudeModeLabel"
                               Text="auto-accept edits"
                               Foreground="#E5A54B"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               ToolTip="Click or Shift+Tab to cycle plan / accept / auto-accept"
                               MouseLeftButtonUp="ClaudeModeLabel_Click" />
                    <TextBlock x:Name="ClaudeModeHint"
                               Text="  Shift+Tab to plan"
                               Foreground="#6B7280"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               FontSize="13"
                               Margin="4,0,0,0" />
                  </StackPanel>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ConsolePlusButton"
                            Grid.Column="0"
                            Content="+"
                            Height="28"
                            Width="28"
                            MinWidth="28"
                            Margin="0,0,8,0"
                            Padding="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Click="ConsolePlusButton_Click"
                            ToolTip="Skills, plugins, connectors, upload"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />

                    <Popup x:Name="ConsolePlusPopup"
                           PlacementTarget="{Binding ElementName=ConsolePlusButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                      <Border Background="#1A1B1E"
                              BorderBrush="#3A3B40"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="6"
                              MaxWidth="360">
                        <StackPanel>
                          <TextBlock x:Name="ConsolePlusHeader"
                                     Margin="8,6,8,8"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     Foreground="#9CA3AF" />
                          <ItemsControl x:Name="ConsolePlusItems">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Click="ConsolePlusItem_Click"
                                        Tag="{Binding Kind}"
                                        IsEnabled="{Binding Supported}"
                                        Opacity="{Binding Opacity}"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,7"
                                        Cursor="Hand"
                                        Margin="0,0,0,1">
                                  <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                      <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter TargetName="Row" Property="Background" Value="#2A2B30" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Button.Template>
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Width="22" VerticalAlignment="Center" Foreground="#E5A54B" />
                                    <StackPanel Width="260">
                                      <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6" />
                                      <TextBlock Text="{Binding OneLiner}" FontSize="10" Margin="0,1,0,0" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Foreground="#9CA3AF" />
                                    </StackPanel>
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </Popup>

                    <TextBlock Grid.Column="1"
                               Text="&gt;"
                               Foreground="#9CA3AF"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Border x:Name="ConsoleComposerBorder"
                            Grid.Column="2"
                            Background="#2A2B30"
                            BorderBrush="#3A3B40"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="36"
                            MaxHeight="140"
                            VerticalAlignment="Center">
                      <Grid>
                        <TextBlock x:Name="ConsoleInputPlaceholder"
                                   Text="Type your message or @path/to/file"
                                   Foreground="#6B7280"
                                   FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                   FontSize="14"
                                   Margin="12,8,12,8"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top" />
                        <TextBox x:Name="ConsoleInputBox"
                                 MinHeight="34"
                                 MaxHeight="136"
                                 Padding="12,8"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 Background="Transparent"
                                 Foreground="#E5E7EB"
                                 CaretBrush="#E5A54B"
                                 SelectionBrush="#5865F2"
                                 BorderThickness="0"
                                 FontSize="14"
                                 FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                 PreviewKeyDown="ConsoleInputBox_PreviewKeyDown"
                                 TextChanged="ConsoleInputBox_TextChanged"
                                 GotKeyboardFocus="ConsoleInputBox_GotKeyboardFocus"
                                 LostKeyboardFocus="ConsoleInputBox_LostKeyboardFocus" />
                      </Grid>
                    </Border>

                    <Popup x:Name="SlashCommandPopup"
                           PlacementTarget="{Binding ElementName=ConsoleInputBox}"
                           Placement="Top"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           HorizontalOffset="0"
                           VerticalOffset="-6">
                      <Border Background="#1A1B1E"
                              BorderBrush="#3A3B40"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="6"
                              MinWidth="420"
                              MaxHeight="260">
                        <ListBox x:Name="SlashCommandList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F2FBFF"
                                 MaxHeight="240"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="SlashCommandList_KeyDown"
                                 MouseDoubleClick="SlashCommandList_Commit">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E5A54B" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#9CA3AF" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Border>
                    </Popup>

                    <Button x:Name="ConsoleSendButton"
                            Grid.Column="3"
                            Content="↵"
                            Margin="8,0,0,0"
                            MinWidth="36"
                            Height="32"
                            Padding="8,0"
                            FontSize="14"
                            Click="ConsoleSendButton_Click"
                            ToolTip="Send (Enter)"
                            Background="#2A2B30"
                            Foreground="#E5A54B"
                            BorderBrush="#3A3B40"
                            BorderThickness="1"
                            Cursor="Hand" />
                  </Grid>

                  <TextBlock x:Name="ClaudeWorkspacePathLabel"
                             Margin="2,8,0,0"
                             FontFamily="Cascadia Mono, Consolas, Segoe UI"
                             FontSize="12"
                             Foreground="#6B7280"
                             Text="workspace (~)"
                             TextTrimming="CharacterEllipsis" />

                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ToggleButton x:Name="ConsoleMicButton"
                                  Content="Voice"
                                  Height="24"
                                  MinWidth="48"
                                  Margin="0,0,6,0"
                                  Padding="8,0"
                                  FontSize="10"
                                  Click="ConsoleMicButton_Click"
                                  ToolTip="Voice: hear you + speak agent replies"
                                  Style="{StaticResource ConsoleToggleButtonStyle}" />
                    <ToggleButton x:Name="ConsoleDictateButton"
                                  Content="Dictate"
                                  Height="24"
                                  MinWidth="52"
                                  Margin="0,0,6,0"
                                  Padding="8,0"
                                  FontSize="10"
                                  Click="ConsoleDictateButton_Click"
                                  ToolTip="Dictate: type only (no spoken replies)"
                                  Style="{StaticResource ConsoleToggleButtonStyle}" />
                    <TextBlock x:Name="ConsoleVoicePill"
                               Text="voice: off"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0"
                               FontSize="10"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{DynamicResource MutedTextBrush}"
                               ToolTip="Local speech backend status" />
                    <Button x:Name="ConsoleCommandsChip"
                            Content="/"
                            Height="24"
                            MinWidth="28"
                            Padding="6,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Click="ConsoleCommandsButton_Click"
                            ToolTip="Slash commands"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  </StackPanel>
                </StackPanel>

                  <!-- Hidden chips kept for permission wiring / HighlightPermissionChips -->
                  <WrapPanel x:Name="ConsolePermissionChipBar"
                             Visibility="Collapsed"
                             Margin="0">
                  <Button x:Name="PermissionChipReadOnly"
                          Content="Plan"
                          Tag="read-only"
                          Height="22"
                          MinWidth="44"
                          Margin="0,0,4,0"
                          Padding="8,0"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Click="PermissionChip_Click"
                          ToolTip="Plan — chat only, no tools"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  <Button x:Name="PermissionChipReadTools"
                          Content="Read"
                          Tag="read-tools"
                          Height="22"
                          MinWidth="44"
                          Margin="0,0,4,0"
                          Padding="8,0"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Click="PermissionChip_Click"
                          ToolTip="Read workspace tools only"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  <Button x:Name="PermissionChipAsk"
                          Content="Accept"
                          Tag="ask"
                          Height="22"
                          MinWidth="48"
                          Margin="0,0,4,0"
                          Padding="8,0"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Click="PermissionChip_Click"
                          ToolTip="Accept — approve each tool call"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  <Button x:Name="PermissionChipFull"
                          Content="Full"
                          Tag="full"
                          Height="22"
                          MinWidth="44"
                          Margin="0,0,8,0"
                          Padding="8,0"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Click="PermissionChip_Click"
                          ToolTip="Full — auto tools after confirm"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </WrapPanel>

                <TextBlock x:Name="ConsolePasteHint"
                           Text="Enter send · Shift+Enter line · / commands · + skills plugins connectors"
                           Visibility="Collapsed"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap" />

                <!-- ─── SESSION PILLS ──────────────────────────────────────────
                     Troy, 2026-07-30: "little pill buttons underneath the text box
                     somewhere kind of left to right in a row where you could just
                     press the button for Claude or ChatGPT, Grok, whatever,
                     Gemini, and it'll spin up a fresh session, you can name it."

                     Pressing one opens the naming box; confirming starts a real
                     session that ADDS to what is running. It starts NO process —
                     the session's agent is launched on its first send, so an idle
                     session costs nothing. ChatGPT is labelled as Troy says it and
                     routes to the OpenAI coordinator; the naming header says so
                     out loud rather than quietly renaming his button. -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0"
                            VerticalAlignment="Center">
                  <!-- Maestro manager (name it, then @agents). Outside SessionPillRow so smoke still sees the four providers. -->
                  <Button x:Name="SessionPillMaestro"
                          Tag="Maestro"
                          Content="Maestro"
                          Click="SessionPill_Click"
                          Style="{StaticResource MaestroManagerPillStyle}"
                          ToolTip="Name a Maestro manager. Then type @Claude @Grok (or @all) so workers claim distinct work and reply without stepping on each other." />
                  <StackPanel x:Name="SessionPillRow"
                              Visibility="Visible"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock Text="AGENTS"
                               FontSize="9.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="2,0,8,0"
                               Foreground="#5E7386" />
                    <Button x:Name="SessionPillClaude"
                            Tag="Claude"
                            Content="Claude"
                            Click="SessionPill_Click"
                            Style="{StaticResource SessionPillStyle}"
                            ToolTip="Start a new named Claude session. It adds to what is running." />
                    <Button x:Name="SessionPillChatGpt"
                            Tag="ChatGPT"
                            Content="ChatGPT"
                            Click="SessionPill_Click"
                            Style="{StaticResource SessionPillStyle}"
                            ToolTip="Start a new named ChatGPT session — routed to the OpenAI coordinator." />
                    <Button x:Name="SessionPillGrok"
                            Tag="Grok"
                            Content="Grok"
                            Click="SessionPill_Click"
                            Style="{StaticResource SessionPillStyle}"
                            ToolTip="Start a new named Grok session. It adds to what is running." />
                    <Button x:Name="SessionPillGemini"
                            Tag="Gemini"
                            Content="Gemini"
                            Click="SessionPill_Click"
                            Style="{StaticResource SessionPillStyle}"
                            ToolTip="Start a new named Gemini session. It adds to what is running." />
                  </StackPanel>
                </StackPanel>

                <!-- Naming the session. A Popup rather than a modal dialog so the
                     stop button and the rest of the window stay reachable. -->
                <Popup x:Name="SessionNamePopup"
                       PlacementTarget="{Binding ElementName=SessionPillRow}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                  <Border Background="#101A22"
                          BorderBrush="#3A5568"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="14"
                          MaxWidth="440">
                    <StackPanel>
                      <TextBlock x:Name="SessionNameHeader"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,8"
                                 Foreground="#7FE3FF" />
                      <TextBox x:Name="SessionNameBox"
                               MinWidth="300"
                               Padding="10,7"
                               FontSize="13"
                               Background="#0A1218"
                               Foreground="#F2FBFF"
                               CaretBrush="#7FE3FF"
                               SelectionBrush="#2A6F8F"
                               BorderBrush="#3A5568"
                               BorderThickness="1"
                               PreviewKeyDown="SessionNameBox_PreviewKeyDown" />
                      <TextBlock Text="Optional session details · reasoning/model routing"
                                 Margin="0,10,0,5" FontSize="10" Foreground="#9FB6C6" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SessionTierCombo" Grid.Column="0" SelectedIndex="0"
                                  ToolTip="Auto lets Helmion choose. Fast, Standard, and Deep pin the reasoning/model tier for this session.">
                          <ComboBoxItem Content="Auto" Tag="auto" />
                          <ComboBoxItem Content="Fast" Tag="fast" />
                          <ComboBoxItem Content="Standard" Tag="standard" />
                          <ComboBoxItem Content="Deep" Tag="deep" />
                        </ComboBox>
                        <TextBox x:Name="SessionModelOverrideBox" Grid.Column="2" Padding="8,5"
                                 ToolTip="Optional exact provider model id. Leave blank to use the selected reasoning tier." />
                      </Grid>
                      <TextBlock x:Name="SessionNameProblem"
                                 FontSize="11.5"
                                 Margin="0,7,0,0"
                                 TextWrapping="Wrap"
                                 Visibility="Collapsed"
                                 Foreground="#E06C60" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Margin="0,11,0,0">
                        <Button Content="Cancel"
                                Click="SessionNameCancel_Click"
                                Height="30"
                                Padding="14,0"
                                Margin="0,0,8,0"
                                FontSize="12"
                                Background="Transparent"
                                BorderBrush="#3A5568"
                                BorderThickness="1"
                                Foreground="#9FB6C6"
                                Cursor="Hand" />
                        <Button Content="Start session"
                                Click="SessionNameStart_Click"
                                Height="30"
                                Padding="16,0"
                                FontSize="12"
                                Style="{StaticResource PrimaryButtonStyle}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Popup>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <GridSplitter Grid.Row="0"
                        Grid.Column="3"
                        Width="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#22000000"
                        Cursor="SizeWE"
                        ShowsPreview="True"
                        ResizeDirection="Columns"
                        ResizeBehavior="PreviousAndNext"
                        ToolTip="Drag to resize Maestro and Agents">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="#22000000" Cursor="SizeWE">
                  <Border x:Name="Grip" Width="4" Height="56"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.5" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>

          <!-- Agents strip = multi-session manager; sleek cards show live chat preview. -->
          <Border x:Name="AgentsDockBorder"
                  Grid.Row="0"
                  Grid.Column="4"
                  Margin="0,12,8,12"
                  CornerRadius="12"
                  Background="{DynamicResource GlassPanelBrush}"
                  BorderBrush="{DynamicResource GlassStrokeBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Padding="10,8"
                      BorderBrush="{DynamicResource GlassStrokeBrush}"
                      BorderThickness="0,0,0,1"
                      Background="{DynamicResource GlassRaisedBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AGENTS"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="AgentsDockSubtitle"
                               Text="Multi-agent"
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="⟩"
                          Width="22"
                          Height="22"
                          Padding="0"
                          FontSize="11"
                          Click="AgentsDockToggleButton_Click"
                          ToolTip="Hide agents panel"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
              </Border>

              <StackPanel Grid.Row="1" Margin="8,8,8,4">
                <WrapPanel x:Name="AgentsPillRow">
                  <Button Tag="Maestro" Content="Maestro"
                          Click="SessionPill_Click"
                          Style="{StaticResource AgentShelfPillStyle}"
                          FontWeight="Bold"
                          ToolTip="Name a manager agent. Then type @Claude @Grok … so workers reply without stepping on each other." />
                  <Button Tag="Claude" Content="Claude" Click="SessionPill_Click"
                          Style="{StaticResource AgentShelfPillStyle}"
                          ToolTip="Add Claude worker agent" />
                  <Button Tag="ChatGPT" Content="ChatGPT" Click="SessionPill_Click"
                          Style="{StaticResource AgentShelfPillStyle}"
                          ToolTip="Add ChatGPT worker agent" />
                  <Button Tag="Grok" Content="Grok" Click="SessionPill_Click"
                          Style="{StaticResource AgentShelfPillStyle}"
                          ToolTip="Add Grok worker agent" />
                  <Button Tag="Gemini" Content="Gemini" Click="SessionPill_Click"
                          Style="{StaticResource AgentShelfPillStyle}"
                          ToolTip="Add Gemini worker agent" />
                </WrapPanel>
                <TextBlock Text="@name or @all from Maestro · workers claim distinct slices"
                           Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
              </StackPanel>

              <ScrollViewer Grid.Row="2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="4,0,2,0"
                            Padding="0,0,4,0">
                <StackPanel>
                  <ItemsControl x:Name="AgentsSessionList" Loaded="AgentsSessionList_Loaded">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="4,0,2,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <!-- Compact card: name + stoplight + chat text (agent transcript) -->
                          <Button Grid.Column="0"
                                  Click="SessionShelfItem_Click"
                                  Tag="{Binding Id}"
                                  AutomationProperties.Name="{Binding AccessibleName}"
                                  AutomationProperties.HelpText="{Binding DotTooltip}"
                                  HorizontalContentAlignment="Stretch"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Cursor="Hand"
                                  ToolTip="{Binding DotTooltip}">
                            <Border Background="{DynamicResource PanelSubtleBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Avatar initial (chat-style) -->
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource AccentPanelBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,1,8,0">
                                  <Grid>
                                    <TextBlock Text="{Binding AvatarInitial}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                                <StackPanel Grid.Column="1">
                                  <DockPanel LastChildFill="False">
                                    <Ellipse DockPanel.Dock="Left"
                                             Width="7" Height="7"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Style="{StaticResource SessionDotStyle}" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="{Binding RowWeight}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SubtitleText}"
                                               FontSize="9"
                                               Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FaintTextBrush}"
                                               VerticalAlignment="Center" />
                                  </DockPanel>
                                  <!-- Chat text of this agent (live transcript preview) -->
                                  <Border Background="{DynamicResource PanelInsetBrush}"
                                          CornerRadius="6"
                                          Padding="7,5"
                                          Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ChatPreview}"
                                               FontSize="10"
                                               LineHeight="14"
                                               TextWrapping="Wrap"
                                               MaxHeight="42"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SoftTextBrush}" />
                                  </Border>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Button>
                          <Button Grid.Column="1"
                                  Click="SessionClose_Click"
                                  Tag="{Binding Id}"
                                  AutomationProperties.Name="{Binding CloseAccessibleName}"
                                  Content="✕"
                                  VerticalAlignment="Top"
                                  Margin="2,4,0,0"
                                  Padding="4,2"
                                  FontSize="10"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource FaintTextBrush}"
                                  Cursor="Hand"
                                  ToolTip="Close this agent" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="AgentsSessionEmpty"
                             Margin="10,6,10,10"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource FaintTextBrush}"
                             Text="No agents yet. Tap a model above — each press adds one. Cards show that agent’s chat." />
                </StackPanel>
              </ScrollViewer>

              <Border Grid.Row="3"
                      Padding="8,6"
                      BorderBrush="{DynamicResource GlassStrokeBrush}"
                      BorderThickness="0,1,0,0"
                      Background="{DynamicResource GlassRaisedBrush}">
                <TextBlock Text="Select a card → Maestro talks to that agent. Chat lines update live."
                           Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Project activity record -->
        <ScrollViewer x:Name="ActivityPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="History" Tag="Activity" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" />
              <Button Content="Evidence" Tag="Evidence" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
              <Button Content="Needs attention" Tag="Approvals" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
            </StackPanel>
            <local:ProjectActivityPanel x:Name="ProjectActivityPanel" />
          </StackPanel>
        </ScrollViewer>

        <!-- Evidence -->
        <ScrollViewer x:Name="EvidencePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="History" Tag="Activity" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" />
              <Button Content="Evidence" Tag="Evidence" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
              <Button Content="Needs attention" Tag="Approvals" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
            </StackPanel>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Handoff &amp; history evidence" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Readable proof for what changed, what was tested, and what comes next."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,6,0,0" />
              </StackPanel>
              <!-- 2026-07-29: read "LIVE TIMELINE" above an ItemsControl bound to
                   Handoffs, which CreateLive fills with an empty list. Derived now. -->
              <Border x:Name="HandoffTimelinePill" Grid.Column="1" Style="{StaticResource PillStyle}" Background="{DynamicResource PanelSubtleBrush}" BorderBrush="{DynamicResource StrokeBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="HandoffTimelineBadgeText" Text="NO HANDOFFS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding Handoffs}"
                          ItemTemplate="{StaticResource HandoffTemplate}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Evidence contract" Style="{StaticResource SectionTitleStyle}" />
                <UniformGrid Columns="3" Margin="0,19,0,0">
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="CHECKPOINT" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Work completed, files changed, tests, risks, and next action." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Margin="9,0">
                    <TextBlock Text="HANDOFF" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Source, target, completeness, and the exact checkpoint identity." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Margin="18,0,0,0">
                    <TextBlock Text="DURABILITY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" />
                    <TextBlock Text="Acknowledged commit result before state is presented as durable." Style="{StaticResource MutedStyle}" Margin="0,6,0,0" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Project approvals and local reviews -->
        <ScrollViewer x:Name="ApprovalsPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30,26,30,34">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="History" Tag="Activity" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" />
              <Button Content="Evidence" Tag="Evidence" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
              <Button Content="Needs attention" Tag="Approvals" Click="Navigation_Click" Style="{StaticResource ConsoleNeutralButtonStyle}" Padding="11,6" Margin="8,0,0,0" />
            </StackPanel>
            <local:ProjectApprovalsPanel x:Name="ProjectApprovalsPanel" />
          </StackPanel>
        </ScrollViewer>

        <!-- Integrations — modern simple form (connect + key enroll only) -->
        <ScrollViewer x:Name="IntegrationsPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22,28,36" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Integrations"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="ProviderConnectionStatusText"
                       Text="Connect team apps and image generation"
                       Foreground="{DynamicResource FaintTextBrush}"
                       FontSize="12"
                       Margin="0,4,0,18" />

            <!-- Team -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <TextBlock Text="Team" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Room" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Connect"
                          MinWidth="96" Padding="14,8" Click="ConnectDiscordFuture_Click"
                          Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,12" Opacity="0.4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Slack" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Channels" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Connect"
                          MinWidth="96" Padding="14,8" Click="ConnectSlackFuture_Click"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,12" Opacity="0.4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Repos · issues" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Connect"
                          MinWidth="96" Padding="14,8" Click="ConnectGitHubFuture_Click"
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Create: OpenAI Images key form -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Create · Images" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock x:Name="ImageProviderIdentityText"
                                 Text="OpenAI Images"
                                 Foreground="{DynamicResource SoftTextBrush}" FontSize="12" />
                      <TextBlock x:Name="ImageProviderStatusText"
                                 Text="…"
                                 Foreground="{DynamicResource AmberBrush}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ImageProviderDetailText"
                               Text=""
                               Foreground="{DynamicResource FaintTextBrush}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ImageProviderGuardText" Visibility="Collapsed" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Open Create"
                          MinWidth="96" Padding="14,8"
                          VerticalAlignment="Top"
                          Click="OpenImageCreation_Click"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          ToolTip="Open Create workbench" />
                </Grid>

                <TextBlock Text="OpenAI API key"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0,16,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="IntegrationsOpenAiImagesKeyBox"
                               Style="{StaticResource SettingsPasswordBoxStyle}"
                               Height="40"
                               Padding="12,8"
                               AutomationProperties.Name="OpenAI API key for image generation" />
                  <Button x:Name="IntegrationsEnrollImagesButton"
                          Grid.Column="1"
                          Content="Save key"
                          MinWidth="100"
                          Margin="10,0,0,0"
                          Padding="16,8"
                          Click="IntegrationsEnrollImagesButton_Click"
                          Style="{StaticResource PrimaryButtonStyle}"
                          ToolTip="Enroll key into Local Service (Windows DPAPI, this user only)" />
                </Grid>
                <TextBlock x:Name="IntegrationsImagesEnrollStatusText"
                           Text=""
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />

                <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16,0,12" Opacity="0.4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Video" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock x:Name="VideoProviderStatusText"
                                 Text="Off"
                                 Foreground="{DynamicResource FaintTextBrush}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="VideoProviderIdentityText"
                               Text="Not in this build"
                               Foreground="{DynamicResource SoftTextBrush}" FontSize="11"
                               Margin="0,3,0,0" />
                    <TextBlock x:Name="VideoProviderDetailText" Text="" Visibility="Collapsed" />
                    <TextBlock x:Name="VideoProviderGuardText" Visibility="Collapsed" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Soon"
                          MinWidth="96" Padding="14,8" IsEnabled="False"
                          Style="{StaticResource ConsoleNeutralButtonStyle}"
                          VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Phone -->
            <Border Style="{StaticResource SettingsGlassCardStyle}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Phone" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="RemoteControlDetailText"
                               Text="Desktop not enrolled"
                               Foreground="{DynamicResource SoftTextBrush}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource FaintTextBrush}" Margin="0,0,6,0" />
                    <TextBlock x:Name="IntegrationConnectionStatusText" Text="…"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="RemoteControlEnrollButton" Content="Enroll desktop"
                          MinWidth="120" Padding="14,8" Click="RemoteControlEnrollButton_Click"
                          Style="{StaticResource PrimaryButtonStyle}" />
                  <Button x:Name="RemoteControlRedeemButton" Content="Code confirmed"
                          MinWidth="120" Padding="14,8" Margin="8,0,0,0" Click="RemoteControlRedeemButton_Click"
                          Visibility="Collapsed" Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </StackPanel>
                <Border x:Name="RemoteControlEnrollmentPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelInsetBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="ONE-TIME CODE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="RemoteControlEnrollmentCodeText" Text="--------" FontSize="24"
                               FontWeight="SemiBold" Margin="0,8,0,0"
                               FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock x:Name="RemoteControlEnrollmentUriText" Text="" FontSize="11"
                               Foreground="{DynamicResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Expander Header="More · connectors · Herald"
                      IsExpanded="False"
                      Margin="0,4,0,0"
                      Foreground="{DynamicResource MutedTextBrush}"
                      FontSize="12">
              <StackPanel Margin="0,12,0,0">

            <local:ProjectConnectorsPanel x:Name="ProjectConnectorsPanel"
                                          Margin="0,0,0,14" />

            <!-- Herald: resizable panes + sliders (saved per Windows user) -->
            <Border x:Name="HeraldPanelCard"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18"
                    MinHeight="280">
              <Grid x:Name="HeraldLayoutRoot" MinHeight="260">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition x:Name="HeraldMainRowDef" Height="*" MinHeight="160" />
                  <RowDefinition Height="10" />
                  <RowDefinition x:Name="HeraldLogRowDef" Height="160" MinHeight="80" MaxHeight="420" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header + start/stop -->
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Helmian Herald · phone companion" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Pair a phone to the selected project and named session. Drag the splitters to resize panes; use the sliders to set QR size and text. Layout saves for this Windows user."
                               Style="{StaticResource MutedStyle}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reset layout"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            Click="HeraldResetLayoutButton_Click"
                            ToolTip="Restore Herald QR size, log height, column share, and font to defaults"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                    <Button x:Name="ToggleHeraldSharingButton"
                            Content="Start phone sharing"
                            Padding="14,8"
                            Click="ToggleHeraldSharingButton_Click"
                            ToolTip="Explicitly start outbound cellular phone sharing and display a short-lived pairing code."
                            AutomationProperties.Name="Start Helmian Herald phone sharing"
                            Style="{StaticResource ConsoleNeutralButtonStyle}" />
                  </StackPanel>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeNS"
                              ShowsPreview="True"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="HeraldLayoutSplitter_DragCompleted"
                              ToolTip="Drag to resize status area vs activity log">
                  <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                      <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeNS">
                        <Border Width="48" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                      </Border>
                    </ControlTemplate>
                  </GridSplitter.Template>
                </GridSplitter>

                <!-- Main: controls | splitter | QR -->
                <Grid Grid.Row="2" x:Name="HeraldMainSplitGrid" MinHeight="160">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeraldControlsColDef" Width="1.4*" MinWidth="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition x:Name="HeraldQrColDef" Width="*" MinWidth="140" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0"
                          Background="{DynamicResource PanelSubtleBrush}"
                          BorderBrush="{DynamicResource StrokeBrush}"
                          BorderThickness="1"
                          CornerRadius="11"
                          Padding="14">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="HeraldSharingStateText"
                                   Text="NOT SHARING"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <Button x:Name="OpenHeraldConsoleButton"
                                Content="Open Console to start a session"
                                HorizontalAlignment="Left"
                                Padding="12,7"
                                Margin="0,10,0,0"
                                Click="OpenHeraldConsoleButton_Click"
                                ToolTip="Go to Console, select a project, and start a named provider session before phone sharing."
                                AutomationProperties.Name="Open Console to start a session for phone sharing"
                                Style="{StaticResource ConsoleNeutralButtonStyle}" />
                        <TextBlock Text="CUSTOMIZE"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,16,0,6" />
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="QR size"
                                     Foreground="{DynamicResource SoftTextBrush}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                          <Slider x:Name="HeraldQrSizeSlider"
                                  Grid.Column="1"
                                  Minimum="120"
                                  Maximum="400"
                                  Value="220"
                                  TickFrequency="20"
                                  IsSnapToTickEnabled="False"
                                  VerticalAlignment="Center"
                                  ValueChanged="HeraldQrSizeSlider_ValueChanged"
                                  ToolTip="Pairing QR code size" />
                          <TextBlock x:Name="HeraldQrSizeValueLabel"
                                     Grid.Column="2"
                                     Text="220"
                                     Foreground="{DynamicResource MutedTextBrush}"
                                     FontSize="11"
                                     MinWidth="36"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Log text"
                                     Foreground="{DynamicResource SoftTextBrush}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                          <Slider x:Name="HeraldDetailFontSlider"
                                  Grid.Column="1"
                                  Minimum="10"
                                  Maximum="16"
                                  Value="11"
                                  TickFrequency="1"
                                  IsSnapToTickEnabled="True"
                                  VerticalAlignment="Center"
                                  ValueChanged="HeraldDetailFontSlider_ValueChanged"
                                  ToolTip="Status and activity log font size" />
                          <TextBlock x:Name="HeraldDetailFontValueLabel"
                                     Grid.Column="2"
                                     Text="11"
                                     Foreground="{DynamicResource MutedTextBrush}"
                                     FontSize="11"
                                     MinWidth="36"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <TextBlock Text="Boundary · the phone uses Helmian's first-party internet relay over Wi-Fi or cellular while this desktop connects outward; no public port opens on the PC. Pairing is per device, short-lived and revocable. Phone text cannot use shell/slash controls, staged attachments, files, tools, installers, or provider credentials. When Desktop stops or becomes stale, remote requests are denied."
                                   Foreground="{DynamicResource AmberBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                      </ScrollViewer>
                    </DockPanel>
                  </Border>

                  <GridSplitter Grid.Column="1"
                                Width="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Cursor="SizeWE"
                                ShowsPreview="True"
                                ResizeDirection="Columns"
                                ResizeBehavior="PreviousAndNext"
                                DragCompleted="HeraldLayoutSplitter_DragCompleted"
                                ToolTip="Drag to resize controls vs QR">
                    <GridSplitter.Template>
                      <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeWE">
                          <Border Width="3" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                        </Border>
                      </ControlTemplate>
                    </GridSplitter.Template>
                  </GridSplitter>

                  <Border Grid.Column="2"
                          Background="{DynamicResource PanelSubtleBrush}"
                          BorderBrush="{DynamicResource StrokeBrush}"
                          BorderThickness="1"
                          CornerRadius="11"
                          Padding="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="PAIRING QR"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,8" />
                      <Border x:Name="HeraldPairingQrPanel"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              Background="White"
                              BorderBrush="{DynamicResource AccentStrokeBrush}"
                              BorderThickness="1"
                              CornerRadius="14"
                              Padding="12"
                              AutomationProperties.Name="Helmian Herald phone pairing QR code">
                        <StackPanel>
                          <Image x:Name="HeraldPairingQrImage"
                                 Width="220"
                                 Height="220"
                                 Stretch="Uniform"
                                 SnapsToDevicePixels="True"
                                 AutomationProperties.Name="Scan to open Helmian Herald on this phone" />
                          <TextBlock Text="SCAN WITH YOUR PHONE CAMERA"
                                     Foreground="#07111D"
                                     HorizontalAlignment="Center"
                                     FontSize="10"
                                     FontWeight="Bold"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="HeraldQrPlaceholderText"
                                 Text="QR appears here after you start phone sharing."
                                 Foreground="{DynamicResource FaintTextBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 MaxWidth="220" />
                    </StackPanel>
                  </Border>
                </Grid>

                <GridSplitter Grid.Row="3"
                              Height="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeNS"
                              ShowsPreview="True"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="HeraldLayoutSplitter_DragCompleted"
                              ToolTip="Drag to resize activity log height">
                  <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                      <Border Background="{DynamicResource PanelSubtleBrush}" Cursor="SizeNS">
                        <Border Width="48" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" />
                      </Border>
                    </ControlTemplate>
                  </GridSplitter.Template>
                </GridSplitter>

                <!-- Activity / detail log (resizable height via row + splitter) -->
                <Border Grid.Row="4"
                        Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="12">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="STATUS · ACTIVITY"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <TextBlock x:Name="HeraldSharingDetailText"
                                 Text="Nothing is listening. Select a project and named session, then start sharing explicitly."
                                 Foreground="{DynamicResource SoftTextBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                  </DockPanel>
                </Border>

                <TextBlock Grid.Row="5"
                           x:Name="HeraldLayoutSavedLabel"
                           Text=""
                           Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="10"
                           Margin="0,8,0,0" />
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,22,0,18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Review before install" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="One evidence-first preflight for downloads, GitHub content, attachments, MCP servers, plugins/extensions, skills/add-ons, and AI integrations."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,6,20,0"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="INSPECTION ONLY" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>

                <TextBlock Text="Choose a local item to inspect without executing it. You may paste its claimed website or repository source; Helmian records that claim but does not fetch or independently verify it."
                           Foreground="{DynamicResource SoftTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />

                <Grid Margin="0,11,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ExternalReviewSourceBox"
                           MinHeight="34"
                           Padding="10,7"
                           VerticalContentAlignment="Center"
                           Background="{DynamicResource PanelSubtleBrush}"
