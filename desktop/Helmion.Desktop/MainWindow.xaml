              </Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="Release boundary" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
