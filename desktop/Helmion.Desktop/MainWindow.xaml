                    <TextBlock Text="MAESTRO COORDINATOR" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <ComboBox x:Name="MaestroCoordinatorInput"
                              Height="38"
                              Padding="10,8"
                              Background="{DynamicResource SurfaceRaisedBrush}"
                              Foreground="#17221F"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              AutomationProperties.Name="Active Maestro Coordinator">
                      <ComboBoxItem Content="OpenAI" />
                      <ComboBoxItem Content="Claude" />
                      <ComboBoxItem Content="Gemini" IsSelected="True" />
                      <ComboBoxItem Content="Grok" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="SaveApiKeysButton"
                          Content="Save API Keys &amp; Apply Environment"
