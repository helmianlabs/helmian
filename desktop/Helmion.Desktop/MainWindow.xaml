                  <Border Style="{StaticResource PillStyle}"
                          Background="{DynamicResource AccentDarkBrush}"
                          BorderBrush="{DynamicResource AccentStrokeStrongBrush}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="MULTI-USER PRODUCT FOUNDATION"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                  </Border>
                  <TextBlock Text="From personal pilot to trusted team workspace."
                             FontSize="28"
                             FontWeight="SemiBold"
                             Margin="0,16,0,0" />
                  <TextBlock Text="The native shell is the presentation foundation. Tenant isolation, authenticated roles, invitations, durable audit, approval authority, integrations, and signed distribution remain explicit release gates."
                             Foreground="{DynamicResource SoftTextBrush}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
