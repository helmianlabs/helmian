                </Border>

                <Border x:Name="SandboxLaunchConfirmationPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource AmberBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="15"
                        Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="EXPLICIT LAUNCH CONFIRMATION"
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Text="Create a temporary .wsb configuration and launch a disposable Windows Sandbox now? Default isolation: zero host folders mapped; networking disabled; clipboard, audio/video input, printers, and vGPU disabled; no automatic credentials or project-file access. Everything inside is discarded when the Sandbox closes."
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
