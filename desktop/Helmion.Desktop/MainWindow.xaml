                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Custom LLM Endpoints" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Add custom open-source, local runs, or Chinese LLMs (e.g. DeepSeek, Qwen, Ollama) using an OpenAI-compatible API base URL."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,6,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="DYNAMIC INTEGRATIONS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  </Border>
                </Grid>

                <!-- Input Form to Add New Profile -->
                <Grid Margin="0,4,0,14">
