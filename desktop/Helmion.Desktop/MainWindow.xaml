                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border x:Name="SandboxWorkflowCard"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Build sandbox" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Prefer built-in Windows Sandbox when supported; otherwise show an honest Disposable local VM setup recommendation. Every launch remains a separate confirmation."
                               Style="{StaticResource MutedStyle}"
                               Margin="0,6,20,0" />
                  </StackPanel>
                  <Button x:Name="BuildSandboxButton"
                          Grid.Column="1"
                          Content="Sandbox readiness check"
                          Padding="14,8"
                          VerticalAlignment="Center"
                          Click="BuildSandboxButton_Click"
                          ToolTip="Read only the listed machine-level facts. This does not start a process or change Windows."
                          Style="{StaticResource ConsoleNeutralButtonStyle}" />
                </Grid>

                <Border Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="15"
                        Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="READ-ONLY INSPECTION SCOPE"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Text="Windows identity · product, edition, version and build&#x0a;Windows Sandbox feature · presence of the known Windows system component&#x0a;Virtualization · firmware virtualization and second-level address translation reported by Windows&#x0a;Hardware · architecture and logical processor count&#x0a;Resources · total physical memory and free space on the Windows system drive&#x0a;Local VM providers · Oracle VirtualBox only at its exact machine-registered install location; missing or unreadable evidence remains not ready"
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                    <TextBlock Text="It does not inspect project/user files, credentials, browser data, messages, VM images, or network activity; and it does not start PowerShell, DISM, Windows Sandbox, a VM provider, or any other process. It never installs/configures a provider or base image."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Disposable local VM boundary · zero host mappings, networking off, no shared clipboard, drag/drop, USB, credentials, or project access by default. Provider setup, clean-image approval, creation, and launch remain separate explicit decisions; this build does not offer VM-fallback launch."
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                  </StackPanel>
                </Border>

                <Border x:Name="SandboxReadinessPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="15"
                        Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock x:Name="SandboxReadinessTitleText"
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="SandboxReadinessExplanationText"
                               Foreground="{DynamicResource SoftTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                    <TextBlock x:Name="SandboxReadinessFactsText"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                    <TextBlock x:Name="SandboxReadinessBlockersText"
                               Foreground="{DynamicResource AmberBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,9,0,0" />
                    <Button x:Name="SandboxReviewLaunchButton"
                            Visibility="Collapsed"
                            Content="Review disposable sandbox launch"
                            Padding="14,8"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
