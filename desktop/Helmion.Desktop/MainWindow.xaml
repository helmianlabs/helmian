                           FontSize="11"
                           Margin="0,0,0,10" />

                <!-- OpenAI API Key -->
                <TextBlock Text="OPENAI API KEY (GPT-4o / GPT-4o-mini)" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
