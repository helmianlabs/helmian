                <TextBlock Text="Helmian never asks for a provider secret in chat, the embedded console, activity history, logs, or a renderer field."
                           Style="{StaticResource MutedStyle}"
                           Margin="0,6,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          Background="{DynamicResource AccentPanelBrush}"
                          CornerRadius="11"
                          Padding="14"
                          Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="CLI ACCOUNT SIGN-IN"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="10"
                                 FontWeight="Bold" />
