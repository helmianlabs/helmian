                    <TextBlock x:Name="ExternalReviewProvenanceText" Foreground="{DynamicResource SoftTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExternalReviewIntegrityText" Foreground="{DynamicResource SoftTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
