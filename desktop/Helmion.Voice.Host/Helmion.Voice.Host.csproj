<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>helmion-voice</AssemblyName>
    <RootNamespace>Helmion.Voice.Host</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Console host for the local voice stack. There is deliberately NO
      UseWPF/UseWindowsForms and no reference to Helmion.Desktop: this process
      must never be able to put a window on screen.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Helmion.Desktop.Core\Helmion.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
