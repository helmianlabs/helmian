# Executive Guard environment. Copy to /etc/executive-guard/executive-guard.env,
# chmod 600, and replace every CHANGE_ME. These are NOT real secrets.
# Generate a token with:  openssl rand -base64 33 | tr '+/' '-_' | tr -d '='
# Tokens must be at least 24 characters. Ids: lowercase letters, digits, dashes.

# Devices that ask for decisions and report outcomes (id=token, comma separated).
# The hands connector's GUARD_DEVICE_ID must match its id here (default hands-mcp).
EXEC_GUARD_DEVICE_TOKENS=hands-mcp=CHANGE_ME_hands_device_token_32chars,troy-laptop=CHANGE_ME_extension_device_token_32c

# People who approve or deny (id=token, comma separated).
EXEC_GUARD_APPROVER_TOKENS=troy=CHANGE_ME_approver_token_at_least_32_chars

# Optional: a policy JSON file mounted read-only into the container.
# EXEC_GUARD_POLICY=/etc/executive-guard/policy.json

# Set by the image. Change them only if you also change the volume mounts.
# EXEC_GUARD_HOST=0.0.0.0
# EXEC_GUARD_PORT=8787
# EXEC_GUARD_KEY_PATH=/var/lib/executive-guard/keys/signing-key.pem
# EXEC_GUARD_AUDIT_PATH=/var/lib/executive-guard/audit/audit.jsonl
