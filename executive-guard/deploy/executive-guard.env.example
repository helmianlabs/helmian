# Executive Guard server environment — copy to executive-guard.env and
# replace every CHANGE_ME value with a real secret (tokens >= 24 chars).
# Never commit the filled-in file.

EXEC_GUARD_HOST=0.0.0.0
EXEC_GUARD_PORT=8787

# Signing key and audit log, one volume each (see Dockerfile).
EXEC_GUARD_KEY_PATH=/var/lib/executive-guard/keys/signing-key.pem
EXEC_GUARD_AUDIT_PATH=/var/lib/executive-guard/audit/audit.jsonl

# deviceId=token pairs for the hands seats allowed to ask for a verdict.
EXEC_GUARD_DEVICE_TOKENS=hands-mcp=CHANGE_ME_device_token

# approverId=token pairs for the humans allowed to approve or deny.
EXEC_GUARD_APPROVER_TOKENS=troy=CHANGE_ME_approver_token
