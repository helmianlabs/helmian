{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/helmian-admin?__p=/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/helmian-admin?__p=/admin/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/helmian-admin?__p=/api/admin/:path*"
    },
    {
      "source": "/api/remote/v1/control",
      "destination": "/api/herald-control"
    },
    {
      "source": "/api/remote/v1/control-token",
      "destination": "/api/herald-realtime-token"
    },
    {
      "source": "/api/remote/v1/desktop",
      "destination": "/api/herald-desktop"
    },
    {
      "source": "/api/remote/v1/desktop-token",
      "destination": "/api/herald-desktop-realtime-token"
    },
    {
      "source": "/api/remote/v1/desktops",
      "destination": "/api/herald-desktops"
    },
    {
      "source": "/api/remote/v1/enrollment",
      "destination": "/api/herald-enrollment"
    },
    {
      "source": "/api/billing/checkout",
      "destination": "/api/billing-checkout"
    },
    {
      "source": "/api/billing/download",
      "destination": "/api/billing-download"
    },
    {
      "source": "/api/billing/webhook",
      "destination": "/api/billing-webhook"
    },
    {
      "source": "/api/team-oauth/slack/start",
      "destination": "/api/team-oauth-slack-start"
    },
    {
      "source": "/api/team-oauth/slack/callback",
      "destination": "/api/team-oauth-slack-callback"
    },
    {
      "source": "/api/team-oauth/slack/redeem",
      "destination": "/api/team-oauth-slack-redeem"
    },
    {
      "source": "/api/team-oauth/discord/start",
      "destination": "/api/team-oauth-discord-start"
    },
    {
      "source": "/api/team-oauth/discord/callback",
      "destination": "/api/team-oauth-discord-callback"
    },
    {
      "source": "/api/team-oauth/discord/redeem",
      "destination": "/api/team-oauth-discord-redeem"
    },
    {
      "source": "/api/team-oauth/github/start",
      "destination": "/api/team-oauth-github-start"
    },
    {
      "source": "/api/team-oauth/github/authorize",
      "destination": "/api/team-oauth-github-authorize"
    },
    {
      "source": "/api/team-oauth/github/callback",
      "destination": "/api/team-oauth-github-callback"
    },
    {
      "source": "/api/team-oauth/github/redeem",
      "destination": "/api/team-oauth-github-redeem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://*.clerk.accounts.dev https://*.clerk.accounts.com https://cdn.ably.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.accounts.com https://*.ably.io https://*.ably-realtime.com wss://*.ably.io wss://*.ably-realtime.com; font-src 'self' data:; frame-src https://*.clerk.accounts.dev https://*.clerk.accounts.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.clerk.accounts.dev https://*.clerk.accounts.com"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "functions": {
    "api/helmian-admin.js": {
      "maxDuration": 60,
      "includeFiles": "helmian-admin/**"
    }
  },
  "redirects": [
    {
      "source": "/herald/pair",
      "destination": "/app/pair",
      "permanent": false
    },
    {
      "source": "/herald/pair.html",
      "destination": "/app/pair",
      "permanent": false
    },
    {
      "source": "/app/remote",
      "destination": "/herald/",
      "permanent": false
    }
  ]
}
